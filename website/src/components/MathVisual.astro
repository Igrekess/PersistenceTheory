  {type === 'holonomy-circle' && (
    <svg viewBox="0 0 760 410" class="w-full h-auto" role="img" aria-label="holonomy circle">
      <rect x="34" y="28" width="692" height="350" rx="24" fill="#f8fafc" stroke="#d7e1ea" />
      {/* trois cercles côte à côte */}
      {[
        { p: 3, cx: 180, sin2: 0.2192 },
        { p: 5, cx: 380, sin2: 0.1940 },
        { p: 7, cx: 580, sin2: 0.1726 },
      ].map((d) => {
        const cy = 180;
        const r = 80;
        const points = Array.from({ length: d.p }, (_, k) => {
          const a = -Math.PI / 2 + (k * 2 * Math.PI) / d.p;
          return { x: d.cx + Math.cos(a) * r, y: cy + Math.sin(a) * r };
        });
        // arc d'amplitude = sin²θ * 2π
        const angle = d.sin2 * 2 * Math.PI;
        const aStart = -Math.PI / 2;
        const aEnd = aStart + angle;
        const x1 = d.cx + Math.cos(aStart) * r;
        const y1 = cy + Math.sin(aStart) * r;
        const x2 = d.cx + Math.cos(aEnd) * r;
        const y2 = cy + Math.sin(aEnd) * r;
        const largeArc = angle > Math.PI ? 1 : 0;
        return (
          <g>
            <circle cx={d.cx} cy={cy} r={r} fill="#eef3f7" stroke="#c7d4df" stroke-width="3" />
            <path d={`M ${d.cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${largeArc} 1 ${x2} ${y2} Z`} fill="#c96f24" opacity="0.55" />
