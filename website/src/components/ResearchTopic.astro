---
interface Feature {
  title: string;
  body: string;
  status?: string;
  href?: string;
}

interface Section {
  title: string;
  eyebrow?: string;
  depth?: string;
  maxDepth?: string;
  paragraphs: string[];
  items?: string[];
  visual?: {
    kind: string;
    title: string;
    caption: string;
    labels?: string[];
  };
  demo?: {
    kind: string;
    title: string;
    caption: string;
    labels?: string[];
  };
  proof?: {
    title: string;
    steps: string[];
    conclusion?: string;
  };
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  lead: string;
  features: Feature[];
  sections: Section[];
  sources: string[];
  variant?: 'default' | 'feature';
}

const { eyebrow, title, description, lead, features, sections, sources, variant = 'default' } = Astro.props;
const isFeatureLayout = variant === 'feature';

const statusClass = (status = '') => {
  const key = status.toLowerCase();
  if (key.includes('thm')) return 'pt-tag-thm';
  if (key.includes('id')) return 'pt-tag-id';
  if (key.includes('pred')) return 'pt-tag-pred';
  if (key.includes('val')) return 'pt-tag-val';
  if (key.includes('br')) return 'pt-tag-bridge';
  if (key.includes('cond') || key.includes('open') || key.includes('ouvert')) return 'pt-tag-cond';
  return 'pt-tag-der';
};

const g00Value = (mu: number) => {
  const q = 1 - 2 / mu;
  let dF = 0;
  let d2F = 0;
  [3, 5, 7].forEach((p) => {
    const qp = q ** p;
    const a = 1 - qp;
    const b = 2 * p - 1 + qp;
    const pqpm1 = p * q ** (p - 1);
    dF += -pqpm1 / a + pqpm1 / b;
    const pqpm2 = q > 0 ? p * q ** (p - 2) : 0;
    d2F += -pqpm2 * (p - 1 + qp) / (a ** 2) + pqpm2 * ((p - 1) * (2 * p - 1) - qp) / (b ** 2);
  });
  const oneMinusQ = 1 - q;
  const fpp = (oneMinusQ ** 3 / 2) * ((oneMinusQ / 2) * d2F - dF);
  return -fpp;
};

const makeG00Plot = () => {
  const x0 = 92;
  const y0 = 55;
  const w = 714;
  const h = 218;
  const minMu = 2.05;
  const maxMu = 30;
  const minG = -0.012;
  const maxG = 0.09;
  const x = (mu: number) => x0 + ((mu - minMu) / (maxMu - minMu)) * w;
  const y = (g: number) => y0 + ((maxG - g) / (maxG - minG)) * h;
  const points = Array.from({ length: 140 }, (_, i) => {
    const mu = minMu + (i / 139) * (maxMu - minMu);
    return [x(mu), y(g00Value(mu))];
  });
  return {
    path: points.map(([px, py], i) => `${i === 0 ? 'M' : 'L'}${px.toFixed(1)} ${py.toFixed(1)}`).join(' '),
    x0,
    y0,
    w,
    h,
    zeroY: y(0),
    muCX: x(6.9675),
    muStarX: x(15),
    muStarY: y(g00Value(15)),
  };
};

const g00Plot = makeG00Plot();
