                </p>
                <div class="grid grid-cols-3 gap-3 mt-4 text-sm">
                  <div class="pt-card !p-3">
                    <strong>{section.demo.labels?.[3] ?? 'Poids métrique'}</strong>
                    <br /><span class="text-lg font-sans font-semibold text-thmblue" data-demo-slope-g>1.00</span>
                    <p class="mt-1 text-xs text-slate-600 leading-snug">{section.demo.labels?.[4] ?? '|g00| : facteur de conversion donné par la métrique'}</p>
