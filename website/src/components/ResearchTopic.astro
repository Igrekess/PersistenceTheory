---
interface Feature {
  title: string;
  body: string;
  status?: string;
  href?: string;
}

interface Section {
  title: string;
  eyebrow?: string;
  depth?: string;
  paragraphs: string[];
  items?: string[];
  visual?: {
    kind: string;
    title: string;
    caption: string;
    labels?: string[];
  };
  demo?: {
    kind: string;
    title: string;
    caption: string;
    labels?: string[];
  };
  proof?: {
    title: string;
    steps: string[];
    conclusion?: string;
  };
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  lead: string;
  features: Feature[];
  sections: Section[];
  sources: string[];
}

const { eyebrow, title, description, lead, features, sections, sources } = Astro.props;

const statusClass = (status = '') => {
  const key = status.toLowerCase();
  if (key.includes('thm')) return 'pt-tag-thm';
  if (key.includes('id')) return 'pt-tag-id';
  if (key.includes('pred')) return 'pt-tag-pred';
  if (key.includes('val')) return 'pt-tag-val';
  if (key.includes('br')) return 'pt-tag-bridge';
  if (key.includes('cond') || key.includes('open') || key.includes('ouvert')) return 'pt-tag-cond';
  return 'pt-tag-der';
};
---

<section class="max-w-6xl mx-auto px-4 py-14">
  <div class="mb-10">
    <p class="text-sm font-sans font-semibold uppercase tracking-wider text-derorange mb-3">
      {eyebrow}
    </p>
    <h1 class="text-4xl md:text-5xl font-bold text-thmblue mb-5">
      {title}
    </h1>
    <p class="text-xl text-slate-700 leading-relaxed max-w-4xl">
      {description}
    </p>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg p-6 md:p-8 mb-10 shadow-sm shadow-slate-900/5">
    <p class="text-lg text-slate-800 leading-relaxed">
      {lead}
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-4 mb-12">
    {features.map((feature) => {
      const body = (
        <p class="text-sm text-slate-700 leading-relaxed mt-3">{feature.body}</p>
      );
      return feature.href ? (
        <a href={feature.href} class="pt-card block group">
          {feature.status && <span class={`pt-tag ${statusClass(feature.status)}`}>{feature.status}</span>}
          <h2 class="font-sans font-semibold text-thmblue mt-3 mb-1 group-hover:underline">{feature.title}</h2>
          {body}
        </a>
      ) : (
        <div class="pt-card">
          {feature.status && <span class={`pt-tag ${statusClass(feature.status)}`}>{feature.status}</span>}
          <h2 class="font-sans font-semibold text-thmblue mt-3 mb-1">{feature.title}</h2>
          {body}
        </div>
      );
    })}
  </div>

  <div class="space-y-8">
    {sections.map((section) => (
      <section class="bg-white border border-slate-200 rounded-lg p-6 md:p-8 shadow-sm shadow-slate-900/5" data-min-depth={section.depth}>
        {section.eyebrow && (
          <p class="text-xs font-sans font-semibold uppercase tracking-wider text-slate-500 mb-2">
            {section.eyebrow}
          </p>
        )}
        <h2 class="text-2xl font-bold text-thmblue mb-4">{section.title}</h2>
        <div class="space-y-3">
          {section.paragraphs.map((paragraph) => (
            <p class="text-slate-700 leading-relaxed">{paragraph}</p>
          ))}
        </div>
        {section.items && (
          <ul class="mt-5 grid md:grid-cols-2 gap-3">
            {section.items.map((item) => (
              <li class="bg-slate-50 border border-slate-200 rounded-md p-4 text-sm text-slate-700 leading-relaxed">
                {item}
              </li>
            ))}
          </ul>
        )}
        {section.visual && (
          <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4 md:p-5">
            <h3 class="font-sans font-semibold text-thmblue mb-2">{section.visual.title}</h3>
            <div class="bg-white rounded-md border border-slate-200 p-3 overflow-hidden">
              {section.visual.kind === 'time-flow' && (
                <svg viewBox="0 0 760 240" role="img" aria-label={section.visual.title} class="w-full h-auto">
                  <defs>
                    <linearGradient id="timePath" x1="0" x2="1">
                      <stop offset="0%" stop-color="#1f4e79" />
                      <stop offset="100%" stop-color="#d97706" />
                    </linearGradient>
                  </defs>
                  <rect x="24" y="36" width="180" height="140" rx="10" fill="#eff6ff" stroke="#9db8d2" />
                  {[0, 1, 2, 3].map((row) => (
                    [0, 1, 2, 3].map((col) => (
                      <circle cx={62 + col * 36} cy={72 + row * 28} r="7" fill={row + col > 2 ? '#1f4e79' : '#ffffff'} stroke="#1f4e79" stroke-width="2" />
                    ))
                  ))}
                  <path d="M232 116 C315 36 430 38 512 116 S665 196 724 98" fill="none" stroke="url(#timePath)" stroke-width="7" stroke-linecap="round" />
                  <circle cx="232" cy="116" r="8" fill="#1f4e79" />
                  <circle cx="512" cy="116" r="8" fill="#d97706" />
                  <circle cx="724" cy="98" r="8" fill="#0f766e" />
                  <text x="24" y="210" class="fill-slate-700 text-[18px] font-sans">{section.visual.labels?.[0] ?? 'structure'}</text>
                  <text x="300" y="210" class="fill-slate-700 text-[18px] font-sans">{section.visual.labels?.[1] ?? 'lecture'}</text>
                  <text x="610" y="210" class="fill-slate-700 text-[18px] font-sans">{section.visual.labels?.[2] ?? 'temps propre'}</text>
                </svg>
              )}
              {section.visual.kind === 'time-slope-map' && (
                <svg viewBox="0 0 1080 560" role="img" aria-label={section.visual.title} class="w-full h-auto">
                  <defs>
                    <filter id="timeCardShadow" x="-10%" y="-20%" width="120%" height="150%">
                      <feDropShadow dx="0" dy="7" stdDeviation="8" flood-color="#0f172a" flood-opacity="0.12" />
                    </filter>
                  </defs>

                  <rect x="24" y="28" width="1032" height="450" rx="24" fill="#fbfdff" stroke="#d7e1ea" />
                  <rect x="68" y="72" width="500" height="326" rx="18" fill="#ffffff" stroke="#cbd5e1" filter="url(#timeCardShadow)" />
                  <rect x="675" y="104" width="338" height="250" rx="22" fill="#fff7ed" stroke="#fed7aa" />

                  <text x="104" y="122" class="fill-slate-900 text-[28px] font-sans font-bold">{section.visual.labels?.[0] ?? 'Tout le crible est donné d’un bloc'}</text>
                  <text x="126" y="162" class="fill-slate-600 text-[19px] font-sans">{section.visual.labels?.[1] ?? 'les couches sont logiques, pas des instants'}</text>

                  {[
                    ['0,1,+,×', '#f8fafc', '#94a3b8'],
                    ['p = 2', '#eff6ff', '#9db8d2'],
                    ['p = 3', '#f0fdf4', '#86efac'],
                    ['p = 5', '#fff7ed', '#fed7aa'],
                    ['p = 7', '#f5f3ff', '#c4b5fd'],
                    ['μ* = 15', '#ffffff', '#1f4e79'],
                  ].map((layer, i) => (
                    <g>
                      <rect x="120" y={196 + i * 32} width="230" height="23" rx="5" fill={layer[1]} stroke={layer[2]} />
                      <text x="235" y={213 + i * 32} text-anchor="middle" class="fill-slate-900 text-[15px] font-sans font-bold">{layer[0]}</text>
                    </g>
                  ))}

                  <g transform="translate(0 30)">
                    <line x1="404" y1="334" x2="404" y2="204" stroke="#d97706" stroke-width="6" stroke-linecap="round" />
                    <path d="M404 174 L383 220 L404 209 L425 220 Z" fill="#d97706" />
                    <text x="472" y="252" text-anchor="middle" class="fill-derorange text-[24px] font-sans font-bold">{section.visual.labels?.[2] ?? 'ordre'}</text>
                    <text x="472" y="283" text-anchor="middle" class="fill-derorange text-[24px] font-sans font-bold">{section.visual.labels?.[3] ?? 'de lecture'}</text>
                    <text x="472" y="323" text-anchor="middle" class="fill-slate-600 text-[16px] font-sans">{section.visual.labels?.[8] ?? 'lecture interne'}</text>
                  </g>

                  <line x1="604" y1="230" x2="630" y2="230" stroke="#22324a" stroke-width="7" stroke-linecap="round" />
                  <path d="M662 230 L623 207 L631 230 L623 253 Z" fill="#22324a" />
                  <text x="844" y="165" text-anchor="middle" class="fill-derorange text-[30px] font-sans font-bold">{section.visual.labels?.[4] ?? 'Fisher : g00 < 0'}</text>
                  <text x="844" y="208" text-anchor="middle" class="fill-slate-700 text-[18px] font-sans">{section.visual.labels?.[5] ?? 'signe opposé aux directions spatiales'}</text>
                  <line x1="735" y1="238" x2="953" y2="238" stroke="#fed7aa" stroke-width="3" />
                  <text x="844" y="296" text-anchor="middle" class="fill-slate-900 text-[34px] font-sans font-bold">dτ = √|g00| dμ</text>
                  <text x="844" y="335" text-anchor="middle" class="fill-slate-700 text-[18px] font-sans">{section.visual.labels?.[6] ?? 'la lecture devient durée propre'}</text>

                  <text x="540" y="435" text-anchor="middle" class="fill-slate-900 text-[23px] font-sans">{section.visual.labels?.[7] ?? 'PT : la timeline est la lecture interne d’une hiérarchie déjà donnée.'}</text>
                </svg>
              )}
              {section.visual.kind === 'nuclear-cascade' && (
                <svg viewBox="0 0 820 260" role="img" aria-label={section.visual.title} class="w-full h-auto">
                  {['s=1/2', 'Nc=3', 'CF=4/3', 'αs', 'VNN', 'Ebind'].map((label, i) => (
                    <g>
                      <rect x={30 + i * 128} y={82} width="92" height="62" rx="8" fill={i < 3 ? '#eff6ff' : i < 5 ? '#f0fdf4' : '#fff7ed'} stroke={i < 3 ? '#1f4e79' : i < 5 ? '#15803d' : '#d97706'} stroke-width="2" />
                      <text x={76 + i * 128} y="119" text-anchor="middle" class="fill-slate-800 text-[18px] font-sans font-bold">{label}</text>
                      {i < 5 && <path d={`M${124 + i * 128} 113 L${152 + i * 128} 113`} stroke="#64748b" stroke-width="3" stroke-linecap="round" />}
                    </g>
                  ))}
                  <path d="M92 178 C205 226 335 226 448 178 C560 130 673 130 760 178" fill="none" stroke="#1f4e79" stroke-width="4" stroke-linecap="round" />
                  <text x="410" y="226" text-anchor="middle" class="fill-slate-700 text-[18px] font-sans">{section.visual.labels?.[0] ?? 'même cascade, profondeur différente'}</text>
                </svg>
              )}
              {section.visual.kind === 'magic-shells' && (
                <svg viewBox="0 0 860 360" role="img" aria-label={section.visual.title} class="w-full h-auto">
                  <text x="36" y="42" class="fill-thmblue text-[22px] font-sans font-bold">{section.visual.labels?.[0] ?? 'Sans spin-orbite'}</text>
                  <text x="36" y="204" class="fill-thmblue text-[22px] font-sans font-bold">{section.visual.labels?.[1] ?? 'Avec spin-orbite PT'}</text>
                  {[2, 8, 20, 28, 50, 82, 126].map((n, i) => {
                    const x = 210 + i * 88;
                    const active = i < 3;
                    return (
                      <g>
                        <circle cx={x} cy="86" r={active ? 28 : 20} fill={active ? '#1f4e79' : '#f8fafc'} stroke={active ? '#1f4e79' : '#cbd5e1'} stroke-width="3" />
                        <text x={x} y="93" text-anchor="middle" class={active ? 'fill-white text-[18px] font-sans font-bold' : 'fill-slate-500 text-[16px] font-sans font-bold'}>{n}</text>
                        <line x1={x} y1="124" x2={x} y2="148" stroke={active ? '#1f4e79' : '#cbd5e1'} stroke-width="3" stroke-linecap="round" />
                      </g>
                    );
                  })}
                  {[2, 8, 20, 28, 50, 82, 126].map((n, i) => {
                    const x = 210 + i * 88;
                    return (
                      <g>
                        <circle cx={x} cy="248" r="28" fill="#15803d" stroke="#14532d" stroke-width="3" />
                        <text x={x} y="255" text-anchor="middle" class="fill-white text-[18px] font-sans font-bold">{n}</text>
                        <line x1={x} y1="286" x2={x} y2="310" stroke="#15803d" stroke-width="3" stroke-linecap="round" />
                      </g>
                    );
                  })}
                  <path d="M194 150 H404" stroke="#94a3b8" stroke-width="4" stroke-linecap="round" />
                  <path d="M194 312 H756" stroke="#15803d" stroke-width="5" stroke-linecap="round" />
                  <rect x="44" y="118" width="116" height="44" rx="8" fill="#eff6ff" stroke="#9db8d2" />
                  <text x="102" y="146" text-anchor="middle" class="fill-thmblue text-[15px] font-sans font-bold">2, 8, 20</text>
                  <rect x="44" y="280" width="116" height="44" rx="8" fill="#f0fdf4" stroke="#86efac" />
                  <text x="102" y="308" text-anchor="middle" class="fill-idgreen text-[15px] font-sans font-bold">7 / 7</text>
                  <path d="M690 92 C758 122 770 196 706 226" fill="none" stroke="#d97706" stroke-width="6" stroke-linecap="round" />
                  <text x="712" y="162" text-anchor="middle" class="fill-derorange text-[18px] font-sans font-bold">αs,eff / αEM ~ 100</text>
                  <text x="430" y="344" text-anchor="middle" class="fill-slate-700 text-[17px] font-sans">{section.visual.labels?.[2] ?? 'Le spin-orbite nucléaire ouvre les grandes fermetures.'}</text>
                </svg>
              )}
              {section.visual.kind === 'fisher-bianchi' && (
                <svg viewBox="0 0 780 280" role="img" aria-label={section.visual.title} class="w-full h-auto">
                  <circle cx="125" cy="138" r="68" fill="#eff6ff" stroke="#1f4e79" stroke-width="3" />
                  {[0, 60, 120, 180, 240, 300].map((a) => (
                    <line x1="125" y1="138" x2={125 + 68 * Math.cos(a * Math.PI / 180)} y2={138 + 68 * Math.sin(a * Math.PI / 180)} stroke="#9db8d2" stroke-width="2" />
                  ))}
                  <path d="M220 138 H320" stroke="#64748b" stroke-width="4" stroke-linecap="round" />
                  <g transform="translate(355 48)">
                    <path d="M80 16 L150 56 L150 148 L80 188 L10 148 L10 56 Z" fill="#f8fafc" stroke="#1f4e79" stroke-width="3" />
                    <line x1="80" y1="16" x2="80" y2="188" stroke="#d97706" stroke-width="4" />
                    <line x1="10" y1="56" x2="150" y2="148" stroke="#15803d" stroke-width="3" />
                    <line x1="150" y1="56" x2="10" y2="148" stroke="#15803d" stroke-width="3" />
                  </g>
                  <path d="M552 138 H650" stroke="#64748b" stroke-width="4" stroke-linecap="round" />
                  <text x="700" y="102" text-anchor="middle" class="fill-thmblue text-[20px] font-sans font-bold">3+1</text>
                  <text x="700" y="134" text-anchor="middle" class="fill-slate-700 text-[16px] font-sans">SO(3,1)</text>
                  <text x="125" y="258" text-anchor="middle" class="fill-slate-700 text-[17px] font-sans">{section.visual.labels?.[0] ?? 'Fisher'}</text>
                  <text x="435" y="258" text-anchor="middle" class="fill-slate-700 text-[17px] font-sans">{section.visual.labels?.[1] ?? 'Bianchi I'}</text>
                  <text x="700" y="258" text-anchor="middle" class="fill-slate-700 text-[17px] font-sans">{section.visual.labels?.[2] ?? 'Einstein'}</text>
                </svg>
              )}
              {section.visual.kind === 'qg-chain' && (
                <svg viewBox="0 0 820 270" role="img" aria-label={section.visual.title} class="w-full h-auto">
                  {['T_m', 'CRT Hilbert', 'Fisher', 'GR', 'Contraintes', 'Kerr'].map((label, i) => (
                    <g>
                      <circle cx={78 + i * 132} cy={116 + (i % 2) * 32} r="42" fill={i < 2 ? '#eff6ff' : i < 4 ? '#f0fdf4' : '#fff7ed'} stroke={i < 2 ? '#1f4e79' : i < 4 ? '#15803d' : '#d97706'} stroke-width="3" />
                      <text x={78 + i * 132} y={122 + (i % 2) * 32} text-anchor="middle" class="fill-slate-800 text-[16px] font-sans font-bold">{label}</text>
                      {i < 5 && <path d={`M${121 + i * 132} ${124 + (i % 2) * 32} C${145 + i * 132} ${90 + (i % 2) * 32}, ${162 + i * 132} ${175 - (i % 2) * 32}, ${166 + i * 132} ${124 + ((i + 1) % 2) * 32}`} fill="none" stroke="#64748b" stroke-width="3" />}
                    </g>
                  ))}
                  <text x="410" y="232" text-anchor="middle" class="fill-slate-700 text-[18px] font-sans">{section.visual.labels?.[0] ?? 'des points remarquables aux observables'}</text>
                </svg>
              )}
              {section.visual.kind === 'cosmic-budget' && (
                <svg viewBox="0 0 780 260" role="img" aria-label={section.visual.title} class="w-full h-auto">
