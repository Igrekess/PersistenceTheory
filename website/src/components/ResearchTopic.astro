                      <text x={78 + i * 132} y={122 + (i % 2) * 32} text-anchor="middle" class="fill-slate-800 text-[16px] font-sans font-bold">{label}</text>
                      {i < 5 && <path d={`M${121 + i * 132} ${124 + (i % 2) * 32} C${145 + i * 132} ${90 + (i % 2) * 32}, ${162 + i * 132} ${175 - (i % 2) * 32}, ${166 + i * 132} ${124 + ((i + 1) % 2) * 32}`} fill="none" stroke="#64748b" stroke-width="3" />}
                    </g>
