                    <circle cx="190" cy="130" r="86" fill="none" stroke="#1f4e79" stroke-width="28" stroke-dasharray="143 398" stroke-dashoffset="-27" />
                    <circle cx="190" cy="130" r="86" fill="none" stroke="#15803d" stroke-width="28" stroke-dasharray="371 170" stroke-dashoffset="-170" />
                  </g>
                  <circle cx="190" cy="130" r="58" fill="white" />
                  <text x="190" y="126" text-anchor="middle" class="fill-thmblue text-[22px] font-sans font-bold">PT</text>
                  <text x="190" y="151" text-anchor="middle" class="fill-slate-600 text-[14px] font-sans">{section.visual.labels?.[3] ?? 'budget'}</text>
                  <rect x="360" y="72" width="250" height="30" rx="6" fill="#1f4e79" />
                  <rect x="360" y="122" width="470" height="30" rx="6" fill="#15803d" />
                  <rect x="360" y="172" width="70" height="30" rx="6" fill="#d97706" />
                  <text x="360" y="56" class="fill-slate-700 text-[16px] font-sans">{section.visual.labels?.[0] ?? 'matière informationnelle'}</text>
                  <text x="360" y="116" class="fill-slate-700 text-[16px] font-sans">{section.visual.labels?.[1] ?? 'énergie sombre'}</text>
                  <text x="360" y="166" class="fill-slate-700 text-[16px] font-sans">{section.visual.labels?.[2] ?? 'baryons / visible'}</text>
                </svg>
