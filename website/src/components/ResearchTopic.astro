                  <g transform="rotate(-90 190 130)">
                    <circle cx="190" cy="130" r="86" fill="none" stroke="#d97706" stroke-width="28" stroke-dasharray="27 514" stroke-dashoffset="0" />
                    <circle cx="190" cy="130" r="86" fill="none" stroke="#1f4e79" stroke-width="28" stroke-dasharray="143 398" stroke-dashoffset="-27" />
                    <circle cx="190" cy="130" r="86" fill="none" stroke="#15803d" stroke-width="28" stroke-dasharray="371 170" stroke-dashoffset="-170" />
                  </g>
                  <circle cx="190" cy="130" r="58" fill="white" />
                  <text x="190" y="126" text-anchor="middle" class="fill-thmblue text-[22px] font-sans font-bold">PT</text>
                  <text x="190" y="151" text-anchor="middle" class="fill-slate-600 text-[14px] font-sans">{section.visual.labels?.[3] ?? 'budget'}</text>
                  <rect x="360" y="72" width="250" height="30" rx="6" fill="#1f4e79" />
                  <rect x="360" y="122" width="470" height="30" rx="6" fill="#15803d" />
                  <rect x="360" y="172" width="70" height="30" rx="6" fill="#d97706" />
                  <text x="360" y="56" class="fill-slate-700 text-[16px] font-sans">{section.visual.labels?.[0] ?? 'matière informationnelle'}</text>
                  <text x="360" y="116" class="fill-slate-700 text-[16px] font-sans">{section.visual.labels?.[1] ?? 'énergie sombre'}</text>
                  <text x="360" y="166" class="fill-slate-700 text-[16px] font-sans">{section.visual.labels?.[2] ?? 'baryons / visible'}</text>
                </svg>
              )}
            </div>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{section.visual.caption}</p>
          </div>
        )}
        {section.demo && (
          <div class="mt-6 rounded-lg border border-thmblue/20 bg-thmblue/5 p-4 md:p-5" data-pt-demo={section.demo.kind}>
            <h3 class="font-sans font-semibold text-thmblue mb-2">{section.demo.title}</h3>
            <p class="text-sm text-slate-700 leading-relaxed mb-4">{section.demo.caption}</p>
            {section.demo.kind === 'proper-time' && (
              <div>
                <label class="text-xs font-sans uppercase tracking-wider text-slate-500" for="proper-time-slider">{section.demo.labels?.[0] ?? 'profondeur μ'}</label>
                <input id="proper-time-slider" data-demo-input type="range" min="1" max="20" value="8" step="0.1" class="w-full mt-2" />
                <div class="grid grid-cols-3 gap-3 mt-4 text-sm">
                  <div class="pt-card !p-3"><strong>μ</strong><br /><span data-demo-mu>8.0</span></div>
                  <div class="pt-card !p-3"><strong>|g00|</strong><br /><span data-demo-g>0.97</span></div>
                  <div class="pt-card !p-3"><strong>dτ</strong><br /><span data-demo-tau>0.98 dμ</span></div>
                </div>
              </div>
            )}
            {section.demo.kind === 'time-slope-clock' && (
              <div>
                <label class="text-xs font-sans uppercase tracking-wider text-slate-500" for="time-slope-slider">{section.demo.labels?.[0] ?? 'pente métrique |g00|'}</label>
                <input id="time-slope-slider" data-demo-input type="range" min="0.05" max="3" value="1" step="0.05" class="w-full mt-2" />
                <div class="grid grid-cols-3 gap-3 mt-4 text-sm">
                  <div class="pt-card !p-3"><strong>|g00|</strong><br /><span data-demo-slope-g>1.00</span></div>
                  <div class="pt-card !p-3"><strong>dμ</strong><br /><span>1.00</span></div>
                  <div class="pt-card !p-3"><strong>dτ</strong><br /><span data-demo-slope-tau>1.00</span></div>
                </div>
                <div class="mt-4 h-3 rounded-full bg-white border border-slate-200 overflow-hidden">
                  <div data-demo-slope-bar class="h-full bg-derorange" style="width: 33%"></div>
                </div>
                <p class="mt-3 text-sm text-slate-700"><span data-demo-slope-text>La même profondeur de lecture donne une durée différente selon la pente métrique.</span></p>
              </div>
            )}
            {section.demo.kind === 'nuclear-binding' && (
              <div>
                <label class="text-xs font-sans uppercase tracking-wider text-slate-500" for="nuclear-binding-slider">{section.demo.labels?.[0] ?? 'nombre de masse A'}</label>
                <input id="nuclear-binding-slider" data-demo-input type="range" min="12" max="240" value="56" step="1" class="w-full mt-2" />
                <div class="mt-4 h-5 rounded-full overflow-hidden bg-white border border-slate-200 flex">
                  <div data-demo-volume class="bg-thmblue" style="width: 52%"></div>
                  <div data-demo-surface class="bg-idgreen" style="width: 21%"></div>
                  <div data-demo-coulomb class="bg-derorange" style="width: 12%"></div>
                  <div data-demo-pairing class="bg-bridgepurple" style="width: 15%"></div>
                </div>
                <p class="mt-3 text-sm text-slate-700"><span data-demo-nuclear>A=56 : la saturation domine, les corrections restent contrôlées.</span></p>
              </div>
            )}
            {section.demo.kind === 'magic-proximity' && (
              <div>
                <label class="text-xs font-sans uppercase tracking-wider text-slate-500" for="magic-proximity-slider">{section.demo.labels?.[0] ?? 'distance à une fermeture magique'}</label>
                <input id="magic-proximity-slider" data-demo-input type="range" min="0" max="8" value="1" step="0.1" class="w-full mt-2" />
                <div class="grid grid-cols-3 gap-3 mt-4 text-sm">
                  <div class="pt-card !p-3"><strong>d</strong><br /><span data-demo-magic-d>1.0</span></div>
                  <div class="pt-card !p-3"><strong>nmagic</strong><br /><span data-demo-magic-n>0.51</span></div>
                  <div class="pt-card !p-3"><strong>Pspec</strong><br /><span data-demo-magic-p>0.79</span></div>
                </div>
                <p class="mt-3 text-sm text-slate-700"><span data-demo-magic-text>Près d’une fermeture, la préformation alpha est freinée.</span></p>
              </div>
            )}
            {section.demo.kind === 'anisotropy' && (
              <div>
                <label class="text-xs font-sans uppercase tracking-wider text-slate-500" for="anisotropy-slider">{section.demo.labels?.[0] ?? 'direction observée'}</label>
                <input id="anisotropy-slider" data-demo-input type="range" min="0" max="100" value="50" step="1" class="w-full mt-2" />
                <p class="mt-3 text-sm text-slate-700"><span data-demo-anisotropy>lecture moyenne : H0 isotrope</span></p>
              </div>
            )}
            {section.demo.kind === 'kerr' && (
              <div>
                <label class="text-xs font-sans uppercase tracking-wider text-slate-500" for="kerr-slider">{section.demo.labels?.[0] ?? 'spin Kerr a'}</label>
                <input id="kerr-slider" data-demo-input type="range" min="0" max="0.99" value="0.7" step="0.01" class="w-full mt-2" />
                <div class="grid grid-cols-2 gap-3 mt-4 text-sm">
                  <div class="pt-card !p-3"><strong>a</strong><br /><span data-demo-a>0.70</span></div>
                  <div class="pt-card !p-3"><strong>MΩH</strong><br /><span data-demo-omega>0.204</span></div>
                </div>
              </div>
            )}
            {section.demo.kind === 'dark-budget' && (
              <div>
                <div class="h-7 rounded-full overflow-hidden bg-white border border-slate-200 flex">
                  <div class="bg-thmblue flex items-center justify-center text-white text-xs font-sans" style="width: 26.48%">Ωinfo</div>
                  <div class="bg-idgreen flex items-center justify-center text-white text-xs font-sans" style="width: 68.65%">ΩΛ</div>
                  <div class="bg-derorange flex items-center justify-center text-white text-xs font-sans" style="width: 4.87%">vis.</div>
                </div>
                <p class="mt-3 text-sm text-slate-700">{section.demo.labels?.[0] ?? 'La barre montre une séparation pédagogique du budget cosmologique cité dans le registre de prédictions.'}</p>
              </div>
            )}
          </div>
        )}
        {section.proof && (
          <div class="mt-6 border border-thmblue/20 bg-thmblue/5 rounded-lg p-5">
            <p class="text-sm font-sans font-semibold text-thmblue uppercase tracking-wider mb-4">
              {section.proof.title}
            </p>
            <ol class="space-y-3 list-decimal pl-5">
              {section.proof.steps.map((step) => (
                <li class="text-sm text-slate-700 leading-relaxed">{step}</li>
              ))}
            </ol>
            {section.proof.conclusion && (
              <p class="mt-4 text-sm text-slate-800 leading-relaxed font-medium">
                {section.proof.conclusion}
              </p>
            )}
          </div>
        )}
      </section>
    ))}
  </div>

  <div class="mt-10 bg-slate-100 border border-slate-200 rounded-lg p-5 text-sm text-slate-600">
    <p class="font-sans font-semibold text-thmblue mb-2">Sources monographie</p>
    <ul class="grid md:grid-cols-2 gap-2">
      {sources.map((source) => (
        <li>{source}</li>
      ))}
    </ul>
  </div>
</section>

<script>
  const format = (value: number, digits = 2) => Number(value).toFixed(digits);
  const setText = (scope: ParentNode, selector: string, value: string) => {
    const target = scope.querySelector(selector);
    if (target) target.textContent = value;
  };
  const setWidth = (scope: ParentNode, selector: string, value: string) => {
    const target = scope.querySelector(selector);
    if (target instanceof HTMLElement) target.style.width = value;
  };
  const lang = document.documentElement.lang === 'en' ? 'en' : 'fr';
  const demoText = {
    fr: {
      nuclearLight: 'les effets de surface dominent encore fortement',
      nuclearMid: 'la saturation rend la liaison particulièrement lisible',
      nuclearHeavy: 'Coulomb et déformation deviennent plus coûteux',
      magicNear: 'On est au bord d’une fermeture : la capture ou la préformation sent fortement la couche fermée.',
      magicMid: 'L’écho de fermeture reste visible, mais il se dilue dans la couche ouverte.',
      magicFar: 'Loin d’une fermeture, le facteur spectroscopique redevient presque neutre.',
      anisotropyMean: 'lecture moyenne : H0 isotrope',
      anisotropyLow: 'ligne de visée plus proche du canal p=3',
      anisotropyHigh: 'ligne de visée plus proche du canal p=7',
      educationalDelta: 'écart pédagogique',
      slopeLow: 'La pente est faible : la profondeur change, mais l’horloge propre avance peu.',
      slopeMid: 'La pente est lisible : une unité de profondeur devient presque une unité de durée propre.',
      slopeHigh: 'La pente est forte : la même profondeur correspond à plus de durée propre mesurée.',
    },
    en: {
      nuclearLight: 'surface effects still dominate strongly',
      nuclearMid: 'saturation makes binding especially readable',
      nuclearHeavy: 'Coulomb and deformation become more costly',
      magicNear: 'You are near a closure: capture or preformation strongly feels the closed shell.',
      magicMid: 'The closure echo remains visible, but it spreads into the open shell.',
      magicFar: 'Far from a closure, the spectroscopic factor becomes nearly neutral again.',
      anisotropyMean: 'mean reading: isotropic H0',
      anisotropyLow: 'line of sight closer to the p=3 channel',
      anisotropyHigh: 'line of sight closer to the p=7 channel',
      educationalDelta: 'pedagogical offset',
      slopeLow: 'The slope is weak: depth changes, but the proper clock advances little.',
      slopeMid: 'The slope is readable: one unit of depth becomes almost one unit of proper duration.',
      slopeHigh: 'The slope is strong: the same depth corresponds to more measured proper duration.',
    },
  }[lang];

  document.querySelectorAll('[data-pt-demo]').forEach((demo) => {
    const input = demo.querySelector('[data-demo-input]');
    if (!(input instanceof HTMLInputElement)) return;

    const update = () => {
      const kind = demo.getAttribute('data-pt-demo');
      const value = Number(input.value);

      if (kind === 'proper-time') {
        const g = 0.12 + Math.pow(value, 1.35) / 10.8;
        const tau = Math.sqrt(g);
        setText(demo, '[data-demo-mu]', format(value, 1));
        setText(demo, '[data-demo-g]', format(g, 2));
        setText(demo, '[data-demo-tau]', `${format(tau, 2)} dμ`);
      }

      if (kind === 'time-slope-clock') {
        const tau = Math.sqrt(value);
        const width = Math.min(100, Math.max(8, (tau / Math.sqrt(3)) * 100));
        const text = value < 0.5 ? demoText.slopeLow : value < 1.5 ? demoText.slopeMid : demoText.slopeHigh;
        setText(demo, '[data-demo-slope-g]', format(value, 2));
        setText(demo, '[data-demo-slope-tau]', format(tau, 2));
        setText(demo, '[data-demo-slope-text]', text);
        setWidth(demo, '[data-demo-slope-bar]', `${width}%`);
      }

      if (kind === 'nuclear-binding') {
        const volume = 15.7 * value;
        const surface = 17.8 * Math.pow(value, 2 / 3);
        const coulomb = 0.71 * Math.pow(value / 2, 2) / Math.pow(value, 1 / 3);
        const pairing = 12 / Math.sqrt(value);
        const total = volume + surface + coulomb + pairing;
        setWidth(demo, '[data-demo-volume]', `${Math.max(20, (volume / total) * 100)}%`);
        setWidth(demo, '[data-demo-surface]', `${Math.max(8, (surface / total) * 100)}%`);
        setWidth(demo, '[data-demo-coulomb]', `${Math.max(6, (coulomb / total) * 100)}%`);
        setWidth(demo, '[data-demo-pairing]', `${Math.max(4, (pairing / total) * 100)}%`);
        const zone = value < 35 ? demoText.nuclearLight : value < 90 ? demoText.nuclearMid : demoText.nuclearHeavy;
        setText(demo, '[data-demo-nuclear]', `A=${Math.round(value)} : ${zone}.`);
      }

      if (kind === 'magic-proximity') {
        const xi = 1.5;
        const nMagic = Math.exp(-value / xi);
        const pSpec = Math.pow(5 / 8, nMagic);
        const text = value < 1.5
          ? demoText.magicNear
          : value < 4
            ? demoText.magicMid
            : demoText.magicFar;
        setText(demo, '[data-demo-magic-d]', format(value, 1));
        setText(demo, '[data-demo-magic-n]', format(nMagic, 2));
        setText(demo, '[data-demo-magic-p]', format(pSpec, 2));
        setText(demo, '[data-demo-magic-text]', text);
      }

      if (kind === 'anisotropy') {
        const delta = (value - 50) / 50;
        const label = Math.abs(delta) < 0.12
          ? demoText.anisotropyMean
          : delta < 0
            ? demoText.anisotropyLow
            : demoText.anisotropyHigh;
        setText(demo, '[data-demo-anisotropy]', `${label} (${demoText.educationalDelta} ${format(delta * 7.8, 1)} %)`);
      }

      if (kind === 'kerr') {
        const a = Math.min(value, 0.999);
        const omega = a / (2 * (1 + Math.sqrt(1 - a * a)));
        setText(demo, '[data-demo-a]', format(a, 2));
        setText(demo, '[data-demo-omega]', format(omega, 3));
      }
    };

    input.addEventListener('input', update);
    update();
  });
</script>
