                  <div class="pt-card !p-3">
                    <strong>{section.demo.labels?.[5] ?? 'Cran de lecture'}</strong>
                    <br /><span class="text-lg font-sans font-semibold text-thmblue">1.00</span>
                    <p class="mt-1 text-xs text-slate-600 leading-snug">{section.demo.labels?.[6] ?? 'dμ : un petit pas abstrait dans la profondeur du crible'}</p>
                  </div>
                  <div class="pt-card !p-3">
                    <strong>{section.demo.labels?.[7] ?? 'Durée d’horloge'}</strong>
                    <br /><span class="text-lg font-sans font-semibold text-thmblue" data-demo-slope-tau>1.00</span>
                    <p class="mt-1 text-xs text-slate-600 leading-snug">{section.demo.labels?.[8] ?? 'dτ : ce que ce pas devient en temps propre mesurable'}</p>
                  </div>
                </div>
                <p class="mt-3 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 leading-relaxed">
                  {section.demo.labels?.[2] ?? 'Formule lue ici : dτ = √|g00| × dμ. Comme dμ vaut 1, la case dτ affiche √|g00|.'}
                </p>
                <div class="mt-4 h-3 rounded-full bg-white border border-slate-200 overflow-hidden">
                  <div data-demo-slope-bar class="h-full bg-derorange" style="width: 33%"></div>
