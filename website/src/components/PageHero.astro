---
/**
 * PageHero — canonical hero band for all top-level pages.
 *
 * Two tones:
 *   - rich   : gradient bg, kicker line, optional action buttons. For thematic pages
 *              (home, biologie, tableau-periodique, premier-principe…).
 *   - simple : flat bg, compact hero. For utility pages (about, contact, faq, glossary…).
 *
 * Domain controls eyebrow color only (wayfinding); h1/kicker/body keep thmblue
 * to preserve the unified site identity.
 *
 * Depth toggle:
 *   - dekL1   shown only at L1.
 *   - dekL2   shown at L2 and L3.
 *   - oneLineNote always shown (yellow callout).
 *   - technicalNote shown only at L3.
 */

type Domain =
  | 'math'
  | 'physics'
  | 'chemistry'
  | 'bio'
  | 'cosmo'
  | 'geo'
  | 'art'
  | 'meta';

interface Action {
  href: string;
  label: string;
  tone?: 'primary' | 'outline' | 'soft';
}

interface Note {
  label: string;
  body: string;
}

interface Props {
  eyebrow: string;
  domain?: Domain;
  title: string;
  kicker?: string;
  dek?: string;        // shown at all depths (alternative to dekL1 + dekL2)
  dekL1?: string;
  dekL2?: string;
  heroNote?: string;   // always-visible flow line (e.g. "couleur → pions → couches")
  oneLineNote?: Note;
  technicalNote?: Note;
  actions?: Action[];
  tone?: 'rich' | 'simple';
  width?: 'narrow' | 'medium' | 'wide' | 'normal'; // matches body container: max-w-3xl / max-w-4xl / max-w-5xl / max-w-6xl
}

const {
  eyebrow,
  domain = 'meta',
  title,
  kicker,
  dek,
  dekL1,
  dekL2,
  heroNote,
  oneLineNote,
  technicalNote,
  actions = [],
  tone = 'rich',
  width = 'normal',
} = Astro.props;

const widthClass: Record<NonNullable<Props['width']>, string> = {
  narrow: 'ph-w-narrow',
  medium: 'ph-w-medium',
  wide:   'ph-w-wide',
  normal: 'ph-w-normal',
};

// Domain palette — applied via inline style to bypass any Tailwind JIT edge case.
const eyebrowColorByDomain: Record<Domain, string> = {
  math:       '#4338ca',
  physics:    '#0d9488',
  chemistry:  '#b45309',
  bio:        '#9333ea',
  cosmo:      '#1e3a8a',
  geo:        '#78350f',
  art:        '#7c3aed',
  meta:       '#64748b',
};

const eyebrowColor = eyebrowColorByDomain[domain];
const eyebrowStyle = `color: ${eyebrowColor}; background-color: ${eyebrowColor}1a;`; // 1a = ~10% alpha

// If heroNote contains "→", treat as a logical chain and render one pill per step.
const heroNoteParts = heroNote ? heroNote.split(/\s*→\s*/) : [];
const isChain = heroNoteParts.length > 1;
---

<section class:list={['ph-hero', tone === 'simple' && 'ph-hero-simple']}>
  <div class:list={['ph-hero-inner', widthClass[width]]}>
    <p class="ph-eyebrow" style={eyebrowStyle}>{eyebrow}</p>
    <h1 class="ph-title">{title}</h1>
    {kicker && (
      <p class="ph-kicker">
        {kicker.split('\n').map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    )}

    {dek && <p class="ph-dek">{dek}</p>}
    {dekL1 && <p class="ph-dek" data-max-depth="L1">{dekL1}</p>}
    {dekL2 && <p class="ph-dek" data-min-depth="L2">{dekL2}</p>}

    {heroNote && !isChain && <div class="ph-hero-note">{heroNote}</div>}
    {heroNote && isChain && (
      <div class="ph-hero-chain" aria-label={heroNote}>
        {heroNoteParts.map((part, i) => (
          <>
            <span class="ph-hero-chip">{part}</span>
            {i < heroNoteParts.length - 1 && <i aria-hidden="true">→</i>}
          </>
        ))}
      </div>
    )}

    {oneLineNote && (
      <p class="ph-note">
        <strong>{oneLineNote.label} :</strong> {oneLineNote.body}
      </p>
    )}

    {technicalNote && (
      <p class="ph-technical-note" data-min-depth="L3">
        <strong>{technicalNote.label} :</strong> {technicalNote.body}
      </p>
    )}

    {actions.length > 0 && (
      <div class="ph-actions">
        {actions.map((a) => (
          <a
            href={a.href}
            class:list={[
              'ph-action',
              (a.tone ?? 'primary') === 'primary' && 'ph-action-primary',
              a.tone === 'outline' && 'ph-action-outline',
              a.tone === 'soft' && 'ph-action-soft',
            ]}
          >
            {a.label}
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .ph-hero {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-bottom: 1px solid #dbe3ec;
  }
  .ph-hero-simple {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .ph-hero-inner {
    margin: 0 auto;
    padding: 72px 16px 44px;
  }
  .ph-w-narrow  { max-width: 768px; }   /* matches max-w-3xl */
  .ph-w-medium  { max-width: 896px; }   /* matches max-w-4xl */
  .ph-w-wide    { max-width: 1024px; }  /* matches max-w-5xl */
  .ph-w-normal  { max-width: 1152px; }  /* matches max-w-6xl */

  .ph-hero-simple .ph-hero-inner {
    padding: 48px 16px 28px;
  }

  .ph-eyebrow {
    display: inline-flex;
    margin: 0;
    padding: 4px 10px;
    border-radius: 6px;
    font: 800 0.78rem/1.1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .ph-title {
    max-width: 900px;
    margin: 18px 0 22px;
    color: #1f4e79; /* thmblue — anchor color, matches BigBang/Time hero */
    font-size: clamp(2.25rem, 5.4vw, 4.15rem);
    line-height: 1.02;
    font-weight: 900;
    letter-spacing: 0;
  }

  .ph-hero-simple .ph-title {
    font-size: clamp(1.75rem, 3.6vw, 2.6rem);
  }

  .ph-kicker {
    max-width: 900px;
    margin: 0 0 22px;
    color: #c7661f; /* derorange */
    font: 800 clamp(1.2rem, 2.5vw, 1.85rem)/1.18 ui-sans-serif, system-ui, sans-serif;
  }

  .ph-dek {
    max-width: 100%;
    margin: 0 0 18px;
    color: #292524;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .ph-hero-note {
    display: inline-flex;
    margin: 0 0 22px;
    padding: 10px 16px;
    border: 1px solid #fbbf24;
    border-radius: 999px;
    color: #92400e;
    background: #fffbeb;
    font: 700 0.9rem/1.2 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .ph-hero-chain {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
  }
  .ph-hero-chip {
    display: inline-flex;
    padding: 8px 14px;
    border: 1px solid #fbbf24;
    border-radius: 999px;
    color: #92400e;
    background: #fffbeb;
    font: 700 0.9rem/1.2 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  .ph-hero-chain i {
    color: #b45309;
    font-style: normal;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .ph-note,
  .ph-technical-note {
    margin: 0 0 18px;
    padding: 12px 16px;
    border-radius: 8px;
    color: #334155;
    font-size: 1rem;
    line-height: 1.6;
  }

  .ph-note {
    border: 1px solid #fbbf24;
    background: #fffbeb;
  }

  .ph-technical-note {
    border: 1px solid #dbe3ec;
    background: #f8fafc;
  }

  .ph-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .ph-action {
    padding: 12px 20px;
    border-radius: 6px;
    font: 600 1rem/1 ui-sans-serif, system-ui, sans-serif;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  .ph-action-primary {
    background: #14566b;
    color: #fff;
  }
  .ph-action-primary:hover { background: #0f4453; }

  .ph-action-outline {
    background: #fff;
    border: 1px solid #14566b;
    color: #14566b;
  }
  .ph-action-outline:hover { background: rgba(20, 86, 107, 0.05); }

  .ph-action-soft {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #1e293b;
  }
  .ph-action-soft:hover { background: #eef2f7; }

  @media (max-width: 620px) {
    .ph-hero-inner {
      padding: 40px 0 28px;
    }
  }
</style>
