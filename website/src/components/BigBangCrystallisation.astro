const base = fr ? '' : '/en';
const gammaBars = [
  { p: '2', gamma: '0.866960', width: 86.696, role: fr ? 'infrastructure' : 'infrastructure', tone: 'infra' },
  { p: '3', gamma: '0.807614', width: 80.761, role: fr ? 'cascade' : 'cascade', tone: 'cascade' },
  { p: '5', gamma: '0.696316', width: 69.632, role: fr ? 'cascade' : 'cascade', tone: 'cascade' },
  { p: '7', gamma: '0.595468', width: 59.547, role: fr ? 'cascade' : 'cascade', tone: 'cascade' },
  { p: '11', gamma: '0.425733', width: 42.573, role: fr ? 'écho' : 'echo', tone: 'echo' },
];

const basinPoints = [
  { mu: '12', tone: 'edge', label: fr ? 'entrée basse' : 'lower entry' },
  { mu: '13', tone: 'basin', label: fr ? 'glisse' : 'slides' },
  { mu: '14', tone: 'basin', label: fr ? 'glisse' : 'slides' },
  { mu: '15', tone: 'star', label: fr ? 'attracteur' : 'attractor' },
  { mu: '16', tone: 'basin', label: fr ? 'revient' : 'returns' },
  { mu: '17', tone: 'raw', label: fr ? 'brut' : 'raw' },
  { mu: '18+', tone: 'outside', label: fr ? 'hors bassin' : 'outside' },
];

const guideCards = [
  {
    title: fr ? 'Ce qui est hiérarchique' : 'What is hierarchical',
    body: fr
      ? 'La frise ne date pas des instants physiques. Elle ordonne les seuils premiers : chaque étape ajoute une capacité de distinction dans une cascade instantanée.'
      : 'The timeline does not date physical instants. It orders prime thresholds: each step adds a capacity for distinction in an instantaneous cascade.',
  },
  {
    title: fr ? 'Ce qui arrive à 2' : 'What happens to 2',
    body: fr
      ? '2 n’est pas supprimé. Il passe de terme de la somme brute à condition de séparation, comme une membrane qui rend pair/impair lisible.'
      : '2 is not removed. It moves from a term in the raw sum to a separation condition, like a membrane making even/odd readable.',
  },
  {
    title: fr ? 'Pourquoi 15 est spécial' : 'Why 15 is special',
    body: fr
      ? '15 = 3 + 5 + 7 garde les trois directions actives. C’est l’attracteur arithmétique du secteur réduit où le temps devenu lisible peut porter les observables.'
      : '15 = 3 + 5 + 7 keeps the three active directions. It is the arithmetic attractor of the reduced sector where readable time can carry observables.',
  },
];

const primeStatuses = [
  {
    p: '1',
    status: fr ? 'origine neutre' : 'neutral origin',
    criterion: fr ? 'pas un premier ; support avant bifurcation' : 'not a prime; support before bifurcation',
    consequence: fr ? 'il donne le point de départ logique, pas une dynamique' : 'it gives the logical starting point, not a dynamics',
    tone: 'origin',
  },
  {
    p: '2',
    status: fr ? 'infrastructure spin/parité' : 'spin/parity infrastructure',
    criterion: fr ? 'T₂ = (1), bloc dégénéré ; graine de l’involution' : 'T₂ = (1), degenerate block; seed of involution',
    consequence: fr ? 'sort de 17, devient frontière ; rend q⁺/q⁻ lisibles' : 'exits 17, becomes boundary; makes q⁺/q⁻ readable',
    tone: 'parity',
  },
  {
    p: '3',
    status: fr ? 'première face dynamique' : 'first dynamic face',
    criterion: fr ? 'T₃ antidiagonale ; verrouille s = 1/2' : 'T₃ antidiagonal; locks s = 1/2',
    consequence: fr ? 'début de la cascade active et premier axe spatial' : 'start of active cascade and first spatial axis',
    tone: 'active-red',
  },
  {
    p: '5',
    status: fr ? 'pivot central' : 'central pivot',
    criterion: fr ? 'au-dessus du seuil γ > 1/2 ; centre de 3-5-7' : 'above γ > 1/2; centre of 3-5-7',
    consequence: fr ? 'stabilise μ* = 15 et porte les signatures médianes' : 'stabilises μ* = 15 and carries median signatures',
    tone: 'active-green',
  },
  {
    p: '7',
    status: fr ? 'bord actif / pic analytique' : 'active edge / analytic peak',
    criterion: fr ? 'dernier γ > 1/2 ; maximum entier de ln(p)/√p' : 'last γ > 1/2; integer maximum of ln(p)/√p',
    consequence: fr ? 'ferme les trois directions actives ; prépare la signature temporelle avant les échos' : 'closes the three active directions; prepares the temporal signature before echoes',
    tone: 'active-blue',
  },
  {
    p: '11,13',
    status: fr ? 'échos' : 'echoes',
    criterion: fr ? 'sous le seuil ; plateau du drift' : 'below threshold; drift plateau',
    consequence: fr ? 'contre-termes, running, corrections sans nouvelle face' : 'counter-terms, running, corrections without a new face',
    tone: 'echo',
  },
  {
    p: '17,19,23',
    status: fr ? 'super-échos' : 'super-echoes',
    criterion: fr ? 'strate de descente avant la queue p ≥ 29' : 'descent stratum before the p ≥ 29 tail',
    consequence: fr ? 'habillage hadronique et corrections d’échelle' : 'hadronic dressing and scale corrections',
    tone: 'super',
  },
  {
    p: '29+',
    status: fr ? 'queue inactive' : 'inactive tail',
    criterion: fr ? 'non-répétition / marge au seuil' : 'non-repetition / threshold margin',
    consequence: fr ? 'ne crée pas de nouveau régime Big Bang dans cette lecture' : 'does not create a new Big Bang regime in this reading',
    tone: 'cutoff',
  },
];

const proofSteps = [
  {
    code: 'N4',
    title: fr ? '2 est un premier spécial' : '2 is a special prime',
    body: fr
      ? 'Il porte l’involution spin/parité, mais T₂ = (1) ne donne pas encore une transition cyclique non triviale.'
      : 'It carries the spin/parity involution, but T₂ = (1) does not yet give a non-trivial cyclic transition.',
  },
  {
    code: 'T5',
    title: fr ? 'l’attracteur réduit sélectionne 15' : 'the reduced attractor selects 15',
    body: fr
      ? 'La somme physique stable est μ* = 3 + 5 + 7 = 15. C’est un point fixe au sens arithmétique et un attracteur dans le bassin réduit ; la somme brute 17 y glisse lorsque 2 se cristallise.'
      : 'The stable physical sum is μ* = 3 + 5 + 7 = 15. It is a fixed point arithmetically and an attractor in the reduced basin; the raw sum 17 slides into it when 2 crystallises.',
  },
  {
    code: 'γ > 1/2',
    title: fr ? 'la porte active est tranchée' : 'the active gate is sharp',
    body: fr
      ? 'À μ* = 15, les seuls premiers dynamiques au-dessus du seuil sont 3, 5, 7 ; 11 est déjà sous le seuil.'
      : 'At μ* = 15, the only dynamic primes above threshold are 3, 5, 7; 11 is already below threshold.',
  },
  {
    code: 'q⁺/q⁻',
    title: fr ? 'la parité devient deux branches' : 'parity becomes two branches',
    body: fr
      ? 'q⁺ porte la cardinalité discrète ; q⁻ porte la dispersion continue. L’échange des branches dégrade les calculs.'
      : 'q⁺ carries discrete cardinality; q⁻ carries continuous dispersion. Swapping branches degrades the computations.',
  },
];

const standardProblems = [
  {
    title: fr ? 'Singularité initiale' : 'Initial singularity',
    standard: fr ? 'Le modèle chaud extrapolé vers t = 0 devient une frontière où la relativité classique cesse de parler.' : 'The hot model extrapolated toward t = 0 reaches a boundary where classical relativity stops speaking.',
    pt: fr ? 'PT ne part pas d’un t = 0 déjà physique. La cascade est hors-temps, p=2 cristallise, puis le temps devient lisible juste avant μ* = 15.' : 'PT does not start from an already physical t = 0. The cascade is pre-temporal, p=2 crystallises, then time becomes readable just before μ* = 15.',
  },
  {
    title: fr ? 'Conditions initiales' : 'Initial conditions',
    standard: fr ? 'Il faut expliquer pourquoi les paramètres initiaux sont si particuliers.' : 'One must explain why the initial parameters are so special.',
    pt: fr ? 'T5 sélectionne l’attracteur du secteur réduit ; les degrés libres ne sont pas choisis continûment mais fermés par le bassin 12…17 → 15.' : 'T5 selects the attractor of the reduced sector; degrees of freedom are not continuously chosen but closed by the basin 12…17 → 15.',
  },
  {
    title: fr ? 'Horizon / homogénéité' : 'Horizon / homogeneity',
    standard: fr ? 'Des régions causalement séparées semblent partager la même température.' : 'Causally separated regions appear to share the same temperature.',
    pt: fr ? 'La cohérence vient d’une contrainte globale du crible avant le temps causal ordinaire, pas d’un échange préalable entre régions.' : 'Coherence comes from a global sieve constraint before ordinary causal time, not from prior exchange between regions.',
  },
  {
    title: fr ? 'Platitude' : 'Flatness',
    standard: fr ? 'La courbure initiale doit être extrêmement fine pour rester proche de zéro.' : 'Initial curvature must be extremely fine-tuned to remain close to zero.',
    pt: fr ? 'La géométrie n’est pas libre : la signature lorentzienne et les trois directions actives sont héritées de l’attracteur μ* = 15.' : 'Geometry is not free: Lorentzian signature and the three active directions are inherited from the μ* = 15 attractor.',
  },
  {
    title: fr ? 'Flèche entropique' : 'Entropic arrow',
    standard: fr ? 'Le très bas état entropique initial demande une explication.' : 'The very low initial entropy state requires an explanation.',
    pt: fr ? 'GFT sépare structure persistante DKL et entropie H : la flèche commence quand la cascade hors-temps devient évolution mesurable.' : 'GFT separates persistent structure DKL and entropy H: the arrow begins when the pre-temporal cascade becomes measurable evolution.',
  },
];

const timeline = [
  {
    stage: fr ? 'pré-lecture' : 'pre-reading',
    label: '1',
    title: fr ? 'unité neutre' : 'neutral unit',
    body: fr ? 'Aucune séparation encore : le support logique est là, mais pas de parité ni de cascade.' : 'No split yet: the logical support is present, but no parity and no cascade.',
    meta: fr ? 'origine' : 'origin',
    tone: 'origin',
  },
  {
    stage: fr ? 'Big Bang informationnel' : 'informational Big Bang',
    label: '2',
    title: fr ? 'parité cristallisée' : 'crystallised parity',
    body: fr ? 'La couche p=2 sépare pair/impair. Dans le passage 17 → 15, elle quitte la somme et devient membrane spin/parité.' : 'The p=2 layer separates even/odd. In the 17 → 15 passage, it exits the sum and becomes the spin/parity membrane.',
    meta: fr ? 'spin / frontière' : 'spin / boundary',
    tone: 'parity',
  },
  {
    stage: fr ? 'première dynamique' : 'first dynamics',
    label: '3',
    title: fr ? 'matrice T₃, s=1/2' : 'T₃ matrix, s=1/2',
    body: fr ? 'Premier transfert non trivial : l’antidiagonale impose l’alternance et stabilise l’invariant s=1/2.' : 'First non-trivial transfer: the antidiagonal imposes alternation and stabilises s=1/2.',
    meta: fr ? 'début cascade' : 'cascade starts',
    tone: 'active-red',
  },
  {
    stage: fr ? 'indétermination' : 'indetermination',
    label: '5',
    title: fr ? 'niveau central' : 'central layer',
    body: fr ? 'p=5 complète le cœur 3-5-7 et sert de pivot dans plusieurs signatures, dont 42 = 210/5.' : 'p=5 completes the 3-5-7 core and acts as a pivot in several signatures, including 42 = 210/5.',
    meta: fr ? 'pivot' : 'pivot',
    tone: 'active-green',
  },
  {
    stage: fr ? 'espace 3D' : '3D space',
    label: '7',
    title: fr ? 'troisième direction active' : 'third active direction',
    body: fr ? 'Avec 3,5,7 la cascade prépare sa fermeture : trois directions actives, puis la signature temporelle devient lisible.' : 'With 3,5,7 the cascade prepares its closure: three active directions, then temporal signature becomes readable.',
    meta: fr ? 'avant μ* = 15' : 'before μ* = 15',
    tone: 'active-blue',
  },
  {
    stage: fr ? 'refroidissement' : 'cooling',
    label: '11 · 13',
    title: fr ? 'échos' : 'echoes',
    body: fr ? 'Sous le seuil γ < 1/2 : plus des faces actives, mais des corrections perturbatives visibles.' : 'Below γ < 1/2: no longer active faces, but visible perturbative corrections.',
    meta: fr ? 'sous seuil' : 'below threshold',
    tone: 'echo',
  },
  {
    stage: fr ? 'queue structurée' : 'structured tail',
    label: '17 · 19 · 23',
    title: fr ? 'super-échos' : 'super-echoes',
    body: fr ? 'La frise continue en corrections tardives : les super-échos gardent une trace du crible sans redevenir la cascade principale.' : 'The line continues as late corrections: super-echoes retain a sieve trace without becoming the main cascade again.',
    meta: fr ? 'corrections' : 'corrections',
    tone: 'super',
  },
  {
    stage: fr ? 'borne' : 'bound',
    label: '29',
    title: t.timelineCut,
    body: fr ? 'p=29 sert de borne pédagogique : la lecture actuelle s’arrête ici par non-répétition plutôt que d’ajouter une nouvelle face.' : 'p=29 acts as the pedagogical bound: the current reading stops here by non-repetition rather than adding a new face.',
    meta: fr ? 'exclu' : 'excluded',
    tone: 'cutoff',
  },
];

const sourceLinks = [
  { href: `${base}/theorems/T5`, label: t.t5 },
  { href: `${base}/theorems/N4`, label: t.n4 },
  { href: `${base}/theorems/GFT`, label: t.gft },
  { href: `${base}/chain`, label: t.chain },
];
---

<section class="bb-shell">
  <header class="bb-hero">
    <div class="bb-hero-inner">
      <p class="bb-eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p class="bb-dek">{t.dek}</p>
      <div class="bb-hero-note">{t.heroNote}</div>
    </div>
  </header>

  <div class="bb-stats" aria-label={fr ? 'Nombres structurants' : 'Structural numbers'}>
    <div>
      <span>{t.statRaw}</span>
      <strong>μ = 17</strong>
      <em>2 + 3 + 5 + 7</em>
    </div>
    <div>
      <span>{t.statPhysical}</span>
      <strong>μ* = 15</strong>
      <em>3 + 5 + 7</em>
    </div>
    <div>
      <span>{t.statBoundary}</span>
      <strong>17 − 15 = 2</strong>
      <em>p₁</em>
    </div>
  </div>

  <section class="guide-section" aria-label={t.guideTitle}>
    <div class="guide-copy">
      <p class="bb-level">{t.plainLabel}</p>
      <h2>{t.guideTitle}</h2>
      <div class="copy-stack">
        {t.guideTextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="guide-grid">
      {guideCards.map((card) => (
        <article>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="time-emergence" data-min-depth="L2">
    <div>
      <p class="bb-level">{t.standardLabel}</p>
      <h2>{t.timeTitle}</h2>
      <div class="copy-stack">
        {t.timeTextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="time-flow" aria-label={t.timeTitle}>
      <span>{t.timeBefore}</span>
      <strong>1 → 2</strong>
      <i aria-hidden="true">→</i>
      <span>{t.timeCut}</span>
      <strong>3 · 5 · 7</strong>
      <i aria-hidden="true">→</i>
      <span>{t.timeSignature}</span>
      <strong>μ* = 15</strong>
      <i aria-hidden="true">→</i>
      <span>{t.timeFixedPoint}</span>
    </div>
  </section>

  <section class="timeline-section" aria-label={t.timelineAria}>
    <div class="timeline-heading">
      <p class="bb-level">{t.plainLabel}</p>
      <h2>{t.timelineHeadline}</h2>
      <div class="copy-stack">
        {t.timelineTextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="timeline-frame">
      <div class="timeline-scroll" role="list">
        <div class="timeline-line" aria-hidden="true"></div>
        {timeline.map((item) => (
          <article class={`timeline-card ${item.tone}`} role="listitem">
            <span class="timeline-stage">{item.stage}</span>
            <strong class="timeline-prime">{item.label}</strong>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <em>{item.meta}</em>
          </article>
        ))}
      </div>
      <div class="timeline-reduction">
        <span>{t.timelineReduction}</span>
        <strong>2 + 3 + 5 + 7 = 17</strong>
        <i aria-hidden="true">→</i>
        <strong>3 + 5 + 7 = 15</strong>
      </div>
    </div>
  </section>

  <section class="bb-band">
    <div class="bb-copy">
      <p class="bb-level">{t.plainLabel}</p>
      <h2>{t.l1Title}</h2>
      <div class="copy-stack">
        {t.l1TextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="crystalliser" aria-label={fr ? 'Schéma de cristallisation 17 vers 15' : 'Crystallisation diagram from 17 to 15'}>
      <div class="phase before">
        <p class="phase-title">{t.before}</p>
        <div class="nodes raw">
          {['2', '3', '5', '7'].map((p) => <span class={p === '2' ? 'node p2' : 'node'}>p={p}</span>)}
        </div>
        <div class="phase-sum">{t.total} = <strong>17</strong></div>
        <div class="phase-caption">{t.rawActive}</div>
      </div>

      <div class="membrane" aria-hidden="true">
        <span class="seed">p=2</span>
        <span class="line"></span>
        <span class="equation">17 − 15 = 2</span>
        <span class="membrane-label">{t.membrane}</span>
      </div>

      <div class="phase after">
        <p class="phase-title">{t.after}</p>
        <div class="nodes stable">
          {['3', '5', '7'].map((p) => <span class="node">p={p}</span>)}
        </div>
        <div class="phase-sum">{t.total} = <strong>15</strong></div>
        <div class="phase-caption">{t.cascadeActive}</div>
      </div>
    </div>
  </section>

  <section class="attractor-section" data-min-depth="L2">
    <div class="bb-copy">
      <p class="bb-level">{t.standardLabel}</p>
      <h2>{t.attractorTitle}</h2>
      <div class="copy-stack">
        {t.attractorTextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="attractor-graph" aria-label={t.attractorTitle}>
      <div class="basin-track" aria-hidden="true">
        <span class="basin-zone collapse"></span>
        <span class="basin-zone stable"></span>
        <span class="basin-zone outside"></span>
      </div>
      <div class="basin-points">
        {basinPoints.map((point) => (
          <div class={`basin-point ${point.tone}`}>
            <strong>{point.mu}</strong>
            <span>{point.label}</span>
          </div>
        ))}
      </div>
      <div class="basin-arrows" aria-hidden="true">
        <span>12</span>
        <i>→</i>
        <span>13</span>
        <i>→</i>
        <strong>15</strong>
        <i>←</i>
        <span>17 − 2</span>
        <b>18+</b>
      </div>
      <p>{t.attractorCaption}</p>
    </div>
  </section>

  <section class="prime-status-section" data-min-depth="L2">
    <div class="section-intro">
      <p class="bb-level">{t.standardLabel}</p>
      <h2>{t.primeStatusTitle}</h2>
      <div class="copy-stack">
        {t.primeStatusTextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="prime-status-table" role="table" aria-label={t.primeStatusTitle}>
      <div class="prime-status-head" role="row">
        <span>{fr ? 'Seuil' : 'Threshold'}</span>
        <span>{fr ? 'Statut PT' : 'PT status'}</span>
        <span>{fr ? 'Critère' : 'Criterion'}</span>
        <span>{fr ? 'Conséquence' : 'Consequence'}</span>
      </div>
      {primeStatuses.map((item) => (
        <article class={`prime-status-row ${item.tone}`} role="row">
          <strong role="cell">{item.p}</strong>
          <span role="cell">{item.status}</span>
          <span role="cell">{item.criterion}</span>
          <span role="cell">{item.consequence}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="bb-band bb-band-alt" data-min-depth="L2">
    <div class="bb-copy">
      <p class="bb-level">{t.standardLabel}</p>
      <h2>{t.l2Title}</h2>
      <div class="copy-stack">
        {t.l2TextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="gamma-panel">
      <div class="gamma-head">
        <h3>{t.gammaTitle}</h3>
        <span>s = 1/2</span>
      </div>
      <div class="gamma-chart">
        <div class="threshold" aria-hidden="true"></div>
        {gammaBars.map((bar) => (
          <div class="gamma-row">
            <span class="prime">p={bar.p}</span>
            <div class="track">
              <span class={`fill ${bar.tone}`} style={`width: ${bar.width}%`}></span>
            </div>
            <span class="value">{bar.gamma}</span>
            <span class={`role ${bar.tone}`}>{bar.role}</span>
          </div>
        ))}
      </div>
      <p>{t.gammaCaption}</p>
    </div>
  </section>

  <section class="proof-chain" data-min-depth="L3">
    <div class="section-intro">
      <p class="bb-level">{t.technicalLabel}</p>
      <h2>{t.proofTitle}</h2>
      <div class="copy-stack">
        {t.proofTextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="proof-steps">
      {proofSteps.map((step) => (
        <article>
          <strong>{step.code}</strong>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bb-band fork-band" data-min-depth="L2">
    <div class="bb-copy">
      <p class="bb-level">{t.standardLabel}</p>
      <h2>{t.l3Title}</h2>
      <div class="copy-stack">
        {t.l3TextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="fork">
      <div class="fork-source">
        <span>p=2</span>
        <strong>{fr ? 'frontière' : 'boundary'}</strong>
      </div>
      <div class="fork-branch plus">
        <small>{t.discrete}</small>
        <strong>q⁺ = 13/15</strong>
        <span>0.866666...</span>
        <em>{t.vertex}</em>
      </div>
      <div class="fork-branch minus">
        <small>{t.continuous}</small>
        <strong>q⁻ = e<sup>−1/15</sup></strong>
        <span>0.935506...</span>
        <em>{t.propagator}</em>
      </div>
    </div>
  </section>

  <section class="standard-problems" data-min-depth="L2">
    <div class="section-intro">
      <p class="bb-level">{t.standardLabel}</p>
      <h2>{t.standardProblemsTitle}</h2>
      <div class="copy-stack">
        {t.standardProblemsTextParts.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="problem-grid">
      {standardProblems.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <dl>
            <div>
              <dt>{fr ? 'Big Bang standard' : 'Standard Big Bang'}</dt>
              <dd>{item.standard}</dd>
            </div>
            <div>
              <dt>{fr ? 'Lecture PT' : 'PT reading'}</dt>
              <dd>{item.pt}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="bb-two" data-min-depth="L3">
    <div class="proof-block">
      <p class="bb-level">{t.technicalLabel}</p>
      <h2>{t.ablationTitle}</h2>
      <p>{t.ablationText}</p>
      <dl class="number-list">
        <div><dt>1/α(q⁺)</dt><dd>136.28</dd></div>
