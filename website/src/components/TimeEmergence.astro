<script define:vars={{ fr }}>
  const format = (value, digits = 2) => Number(value).toFixed(digits);
  const text = {
    spaceKind: fr ? 'séparation spatiale' : 'spatial separation',
    nullKind: fr ? 'frontière nulle' : 'null boundary',
    timeKind: fr ? 'séparation temporelle' : 'temporal separation',
    space: fr
      ? 'Le terme spatial domine : l’intervalle reste du côté des longueurs.'
      : 'The spatial term dominates: the interval remains on the side of lengths.',
    null: fr
      ? 'Les deux termes se compensent : c’est la frontière nulle, l’analogue pédagogique du trajet lumineux.'
      : 'The two terms compensate: this is the null boundary, the pedagogical analogue of a lightlike path.',
    time: fr
      ? 'Le terme temporel domine : la direction interne n’ajoute pas une longueur, elle produit une durée propre.'
      : 'The temporal term dominates: the internal direction does not add a length; it produces proper duration.',
  };

  document.querySelectorAll('[data-interval-demo]').forEach((demo) => {
    const dxInput = demo.querySelector('[data-interval-dx]');
    const gInput = demo.querySelector('[data-interval-g]');
    const update = () => {
      const dx = Number(dxInput.value);
      const g = Number(gInput.value);
      const spatial = dx * dx;
      const temporal = g;
      const interval = spatial - temporal;
      const kind = Math.abs(interval) < 0.08 ? text.nullKind : interval > 0 ? text.spaceKind : text.timeKind;
      const reading = Math.abs(interval) < 0.08 ? text.null : interval > 0 ? text.space : text.time;
      demo.querySelector('[data-interval-space]').textContent = format(spatial);
      demo.querySelector('[data-interval-time]').textContent = format(temporal);
      demo.querySelector('[data-interval-value]').textContent = format(interval);
      demo.querySelector('[data-interval-kind]').textContent = kind;
      demo.querySelector('[data-interval-text]').textContent = reading;
      demo.querySelector('[data-interval-space-bar]').style.width = `${Math.max(4, Math.min(100, (spatial / 4) * 100))}%`;
      demo.querySelector('[data-interval-time-bar]').style.width = `${Math.max(4, Math.min(100, (temporal / 4) * 100))}%`;
    };
    dxInput.addEventListener('input', update);
    gInput.addEventListener('input', update);
    update();
  });
</script>

