---
import '@/styles/global.css';
import { type Lang, useTranslations, getLangFromUrl, alternateLangPath } from '@/i18n/strings';
import Search from '@components/Search.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang: Lang = lang === 'fr' ? 'en' : 'fr';
const otherLangHref = alternateLangPath(Astro.url, otherLang);

const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const pageDescription = description ?? t('site.description');
const path = (fr: string, en: string) => (lang === 'fr' ? fr : en);
const navGroups = [
  {
    id: 'math-menu',
    label: t('nav.math'),
    items: [
      { href: path('/premier-principe', '/en/premier-principe'), label: t('nav.first_principle') },
      { href: path('/mathematique', '/en/mathematique'), label: t('nav.math_atlas') },
      { href: path('/theorems', '/en/theorems'), label: t('nav.theorems') },
      { href: path('/gaps-premiers', '/en/gaps-premiers'), label: t('nav.prime_gaps') },
      { href: path('/chain', '/en/chain'), label: t('nav.chain') },
      { href: path('/scripts', '/en/scripts'), label: t('nav.scripts') },
    ],
  },
  {
    id: 'physics-menu',
    label: t('nav.physics'),
    items: [
      { href: path('/observables', '/en/observables'), label: t('nav.observables') },
      { href: path('/resultats', '/en/resultats'), label: t('nav.results') },
      { href: path('/temps', '/en/temps'), label: t('nav.time') },
      { href: path('/relativite', '/en/relativite'), label: t('nav.relativity') },
      { href: path('/gravite-quantique', '/en/gravite-quantique'), label: t('nav.quantum_gravity') },
      { href: path('/nucleaire', '/en/nucleaire'), label: t('nav.nuclear') },
      { href: path('/cosmologie', '/en/cosmologie'), label: t('nav.cosmology') },
      { href: path('/calculator', '/en/calculator'), label: t('nav.calculator') },
      { href: path('/audit', '/en/audit'), label: t('nav.audit') },
    ],
  },
  {
    id: 'chemistry-menu',
    label: t('nav.chemistry'),
    items: [
      { href: path('/tableau-periodique', '/en/tableau-periodique'), label: t('nav.periodic_table') },
      { href: path('/preuve-interactive', '/en/preuve-interactive'), label: t('nav.interactive_proof') },
      { href: path('/energies-ionisation', '/en/energies-ionisation'), label: t('nav.ionization_energies') },
      { href: path('/affinites-electroniques', '/en/affinites-electroniques'), label: t('nav.electron_affinities') },
    ],
  },
];
const moreItems = [
  { href: path('/monograph', '/en/monograph'), label: t('nav.monograph') },
  { href: path('/statuts-resultats', '/en/statuts-resultats'), label: t('nav.result_status') },
  { href: path('/difficile-a-rejeter', '/en/difficile-a-rejeter'), label: t('nav.hard_to_dismiss') },
  { href: path('/limites', '/en/limites'), label: t('nav.limits') },
  { href: path('/faq', '/en/faq'), label: t('nav.faq') },
  { href: path('/glossary', '/en/glossary'), label: t('nav.glossary') },
  { href: path('/about', '/en/about'), label: t('nav.about') },
];

// hreflang alternate links for SEO
const baseUrl = 'https://persistencetheory.org';
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="yan senez" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="fr" href={`${baseUrl}${alternateLangPath(Astro.url, 'fr')}`} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}${alternateLangPath(Astro.url, 'en')}`} />
    <link rel="alternate" hreflang="x-default" href={`${baseUrl}${alternateLangPath(Astro.url, 'fr')}`} />
    <link rel="canonical" href={`${baseUrl}${currentPath}`} />

    <!-- KaTeX CSS for math rendering (loaded only on pages that use it) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />

    <!-- KaTeX auto-render for $...$ in frontmatter-injected text (titles, summaries, shorts).
         MDX bodies are already pre-rendered at build time by remark-math + rehype-katex,
         so this only catches the leftover raw $...$ in frontmatter strings. -->
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"
      integrity="sha384-7zkQWkzuo3B5mTepMUcHkMB5jZaolc2xDwL6VFqjFALcbeS9Ggm/Yr2r3Dy4lfFg"
      crossorigin="anonymous"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
      integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk"
      crossorigin="anonymous"
      onload="renderMathInElement(document.body, { delimiters: [{left:'$$', right:'$$', display:true}, {left:'$', right:'$', display:false}], throwOnError: false, ignoredTags: ['script','noscript','style','textarea','pre','code'] });"
    ></script>

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col">
    <header class="border-b border-slate-200 bg-white/90 backdrop-blur sticky top-0 z-30 shadow-sm shadow-slate-900/5">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-4">
        <a href={lang === 'fr' ? '/' : '/en/'} class="font-sans font-bold text-lg text-thmblue hover:underline whitespace-nowrap shrink-0">
          {t('site.title')}
        </a>

        <!-- Primary nav (lg+) -->
        <nav class="hidden lg:flex items-center gap-4 text-sm font-sans flex-1 justify-end">
          <a href={lang === 'fr' ? '/commencer-ici' : '/en/commencer-ici'} class="hover:underline whitespace-nowrap">{t('nav.start')}</a>
          <a href={lang === 'fr' ? '/essays' : '/en/essays'} class="hover:underline whitespace-nowrap">{t('nav.essays')}</a>
          {navGroups.map((group) => (
            <details id={group.id} data-nav-menu class="relative">
              <summary class="cursor-pointer hover:underline list-none flex items-center gap-1 select-none whitespace-nowrap">
                {group.label}
                <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M1 3 L5 7 L9 3 Z"/></svg>
              </summary>
              <div class="absolute left-0 mt-2 w-56 bg-white border border-slate-200 rounded-md shadow-xl shadow-slate-900/10 py-1">
                {group.items.map((item) => (
                  <a href={item.href} class="block px-4 py-2 hover:bg-stone-50 whitespace-nowrap">{item.label}</a>
                ))}
              </div>
            </details>
          ))}
          <a href={lang === 'fr' ? '/articles' : '/en/articles'} class="hover:underline whitespace-nowrap">{t('nav.articles')}</a>

          <!-- "Plus" dropdown -->
          <details id="more-menu" data-nav-menu class="relative">
            <summary class="cursor-pointer hover:underline list-none flex items-center gap-1 select-none">
              {t('nav.more')}
              <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M1 3 L5 7 L9 3 Z"/></svg>
            </summary>
            <div class="absolute right-0 mt-2 w-44 bg-white border border-slate-200 rounded-md shadow-xl shadow-slate-900/10 py-1">
              {moreItems.map((item) => (
                <a href={item.href} class="block px-4 py-2 hover:bg-stone-50">{item.label}</a>
              ))}
            </div>
          </details>
        </nav>

        <!-- Search + Lang (always visible on lg+; hidden under hamburger below lg) -->
        <div class="hidden lg:flex items-center gap-3">
          <Search lang={lang} />
          <a href={otherLangHref} class="px-2 py-1 border border-slate-300 rounded-md hover:bg-slate-100 text-sm font-sans whitespace-nowrap" title={lang === 'fr' ? 'English' : 'Français'}>
            {t('action.switch_lang')}
          </a>
        </div>

        <!-- Mobile hamburger (< lg) -->
        <details id="mobile-menu" class="lg:hidden ml-auto relative">
          <summary class="cursor-pointer p-2 list-none rounded hover:bg-slate-100" aria-label={t('nav.menu')}>
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 6h16M3 11h16M3 16h16" stroke-linecap="round"/>
            </svg>
          </summary>
          <div class="absolute right-0 mt-2 w-64 bg-white border border-slate-200 rounded-md shadow-xl shadow-slate-900/10 py-2 text-sm font-sans">
            <a href={lang === 'fr' ? '/commencer-ici' : '/en/commencer-ici'} class="block px-4 py-2 hover:bg-stone-50">{t('nav.start')}</a>
            <a href={lang === 'fr' ? '/essays' : '/en/essays'} class="block px-4 py-2 hover:bg-stone-50">{t('nav.essays')}</a>
            {navGroups.map((group) => (
              <div class="border-t border-stone-100 mt-1 pt-1">
                <div class="px-4 pt-2 pb-1 text-[11px] font-semibold uppercase tracking-wide text-stone-500">{group.label}</div>
                {group.items.map((item) => (
                  <a href={item.href} class="block px-4 py-2 hover:bg-stone-50">{item.label}</a>
                ))}
              </div>
            ))}
            <a href={lang === 'fr' ? '/articles' : '/en/articles'} class="block px-4 py-2 hover:bg-stone-50">{t('nav.articles')}</a>
            {moreItems.map((item) => (
              <a href={item.href} class="block px-4 py-2 hover:bg-stone-50">{item.label}</a>
            ))}
            <a href={otherLangHref} class="block px-4 py-2 border-t border-stone-100 mt-1 text-thmblue hover:bg-stone-50">{t('action.switch_lang')}</a>
          </div>
        </details>
      </div>
    </header>

    <!-- Auto-close <details> menus when clicking outside -->
    <script is:inline>
      (function () {
        document.addEventListener('click', (e) => {
          document.querySelectorAll('details[data-nav-menu], #mobile-menu').forEach(d => {
            if (d && d.open && !d.contains(e.target)) d.open = false;
          });
        });
        // Close on link click within details
        document.querySelectorAll('details[data-nav-menu] a, #mobile-menu a').forEach(a => {
          a.addEventListener('click', () => {
            const m = a.closest('details');
            if (m) m.open = false;
          });
        });
      })();
    </script>

    <main class="flex-1" data-pagefind-body data-pagefind-meta={`title:${pageTitle},lang:${lang}`}>
      <slot />
    </main>

    <!-- Depth toggle (V2.3) — fixed bottom-right widget -->
    <div
      id="pt-depth-toggle"
      class="fixed bottom-4 right-4 z-40 bg-white border border-stone-300 shadow-lg rounded-full px-1 py-1 flex items-center gap-0.5 text-xs font-sans"
      role="group"
      aria-label={t('depth.label')}
    >
      <span class="px-2 text-stone-500 hidden sm:inline">{t('depth.label')}</span>
      <button data-depth-set="L1" class="depth-btn px-2.5 py-1 rounded-full text-stone-600 hover:bg-stone-100">{t('depth.L1')}</button>
      <button data-depth-set="L2" class="depth-btn px-2.5 py-1 rounded-full text-stone-600 hover:bg-stone-100">{t('depth.L2')}</button>
      <button data-depth-set="L3" class="depth-btn px-2.5 py-1 rounded-full text-stone-600 hover:bg-stone-100">{t('depth.L3')}</button>
    </div>

    <script is:inline>
      (function () {
        const KEY = 'pt-depth';
        const valid = ['L1', 'L2', 'L3'];
        let current = localStorage.getItem(KEY);
        if (!valid.includes(current)) current = 'L2';
        function apply(d) {
          document.documentElement.setAttribute('data-depth', d);
          localStorage.setItem(KEY, d);
          current = d;
          document.querySelectorAll('.depth-btn').forEach(b => {
            const sel = b.getAttribute('data-depth-set') === d;
            b.classList.toggle('bg-thmblue', sel);
            b.classList.toggle('text-white', sel);
            b.classList.toggle('text-stone-600', !sel);
          });
        }
        apply(current);
        document.querySelectorAll('.depth-btn').forEach(b => {
          b.addEventListener('click', () => apply(b.getAttribute('data-depth-set')));
        });
      })();
    </script>

    <!-- Term popover -->
    <div
      id="pt-term-popover"
      role="tooltip"
      class="hidden fixed z-50 max-w-sm bg-white border border-stone-300 shadow-lg rounded-md p-3 text-sm text-stone-800 font-sans pointer-events-none"
    >
      <div id="pt-term-popover-label" class="font-semibold text-thmblue mb-1"></div>
      <div id="pt-term-popover-def" class="text-stone-700"></div>
    </div>

    <script is:inline>
      (function () {
        const pop = document.getElementById('pt-term-popover');
        const lbl = document.getElementById('pt-term-popover-label');
        const def = document.getElementById('pt-term-popover-def');
        if (!pop) return;

        function show(target) {
          const definition = target.getAttribute('data-pt-term-def');
          const label = target.getAttribute('data-pt-term-label');
          if (!definition) return;
          lbl.textContent = label || '';
          def.textContent = definition;
          pop.classList.remove('hidden');
          // Position: below target, clamped to viewport
          const r = target.getBoundingClientRect();
          const margin = 8;
          // Render to measure width
          pop.style.visibility = 'hidden';
          pop.style.left = '0px';
          pop.style.top = '0px';
          const pw = pop.offsetWidth, ph = pop.offsetHeight;
          let x = r.left;
          let y = r.bottom + margin;
          if (x + pw > window.innerWidth - margin) x = window.innerWidth - pw - margin;
          if (x < margin) x = margin;
          if (y + ph > window.innerHeight - margin) y = r.top - ph - margin;
          if (y < margin) y = margin;
          pop.style.left = `${x}px`;
          pop.style.top = `${y}px`;
          pop.style.visibility = 'visible';
        }
        function hide() {
          pop.classList.add('hidden');
        }
        document.addEventListener('mouseover', (e) => {
          const t = e.target;
          if (t && t.classList && t.classList.contains('pt-term')) show(t);
        });
        document.addEventListener('mouseout', (e) => {
          const t = e.target;
          if (t && t.classList && t.classList.contains('pt-term')) hide();
        });
        document.addEventListener('focusin', (e) => {
          const t = e.target;
          if (t && t.classList && t.classList.contains('pt-term')) show(t);
        });
        document.addEventListener('focusout', (e) => {
          const t = e.target;
          if (t && t.classList && t.classList.contains('pt-term')) hide();
        });
      })();
    </script>

    <footer class="border-t border-stone-200 bg-white mt-12">
      <div class="max-w-6xl mx-auto px-4 py-6 text-sm text-stone-600 font-sans grid gap-3 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <span>© 2026 {t('footer.author')}</span>
          <span class="mx-2">·</span>
          <span>{t('footer.code_license')}</span>
          <span class="mx-2">·</span>
          <span>{t('footer.content_license')}</span>
        </div>
        <div class="text-stone-500 italic md:text-right">
          {t('footer.preprint_notice')}
        </div>
        <p class="md:col-span-2 text-xs text-slate-500 border-t border-slate-100 pt-3">
          {t('footer.dev_notice')}
        </p>
      </div>
    </footer>
  </body>
</html>
