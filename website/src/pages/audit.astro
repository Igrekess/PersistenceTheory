---
import BaseLayout from '@layouts/BaseLayout.astro';

const commitments = [
  { id: 'C1', label: 'Calibration SCU comme convention de Buckingham π', detail: '1 SCU ≡ 1 MeV. Dissoute en convention d\'unité ; cf. App. P §C1.' },
  { id: 'C2', label: 'N(p) = (p+1)^(p+1) − 1 universel', detail: 'Domaine [p+1] via ZFC + L0 max-entropie ; preuve simplifiée plain Set + ZFC additivité.' },
  { id: 'C3', label: 'n_up = 9/8 via Fisher 2-boucles sur T³', detail: 'Amplitude T³ Fisher dérivée ; cf. ch10 thm:n_up_fisher_T3.' },
  { id: 'C4', label: 'Coefficient NNLO 5/18 = p₂/(2p₁²)', detail: 'Pontryagin + Wick + fermeture de boucle de phase cyclique T6.' },
  { id: 'C5', label: 'Fisher–Koide NLO 1/21', detail: '1/21 = Haar(Z/3Z) × Haar(Z/7Z) ; f₅ exclu NNLO via T6.' },
  { id: 'C6', label: 'Holonomie de Berry 3π', detail: 'Limite N_gen × π justifiée par auto-cohérence.' },
  { id: 'C7', label: 'γ₃ linéaire dans la resommation spirale', detail: 'Promu THM 2026-04-26 ; App. P §C7 p. 681-683.' },
  { id: 'C8', label: '24 exposants de quark', detail: 'Catalogue clos par énumération combinatoire.' },
  { id: 'C9', label: 'Portail de Higgs δ = m_H²/M²', detail: 'Hiérarchie inverse exclue ; cf. App. P §C9.' },
  { id: 'C10', label: 'Super-écho {11,13,17,19,23}', detail: 'Cutoff p = 23 hadronique dérivé.' },
];
---

<BaseLayout title="Audit transparent">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">Audit transparent</h1>
    <p class="text-stone-700 mb-6 max-w-3xl">
      La Théorie de la Persistance se soumet à un audit interne explicite. Cette
      page rend public l’inventaire des choix structurels, des audits externes et
      des corrections appliquées.
    </p>

    <h2 class="text-xl font-semibold text-thmblue mt-10 mb-3 font-sans">
      Les 10 engagements structurels (C1–C10)
    </h2>
    <p class="text-stone-700 mb-4">
      Chaque choix discret de la chaîne de dérivation est <strong>fermé par un
      argument mathématique classique indépendant</strong>. Les dix sont au niveau
      <span class="pt-tag pt-tag-thm">THM</span>. Aucun n’est un paramètre continu ;
      aucun ne peut être ajusté pour améliorer un fit.
    </p>

    <div class="grid md:grid-cols-2 gap-3 mb-10">
      {commitments.map(c => (
        <div class="pt-card text-sm">
          <div class="flex items-center gap-2 mb-1">
            <span class="font-sans font-bold text-thmblue">{c.id}</span>
            <span class="pt-tag pt-tag-thm">THM</span>
          </div>
          <p class="text-stone-800 font-sans font-semibold">{c.label}</p>
          <p class="text-stone-600 mt-1">{c.detail}</p>
        </div>
      ))}
    </div>

    <h2 class="text-xl font-semibold text-thmblue mt-10 mb-3 font-sans">
      Statut de revue par les pairs
    </h2>
    <p class="text-stone-700">
      <strong>Préimpression — non révisée par les pairs.</strong> L’auteur
      accueille la critique scrupuleuse et la vérification indépendante. Le
      registre canonique compte 56 scripts Python compagnons,
      2 694/2 695 contrôles passants et 1 échec connu
      indépendant des ajouts récents ; les scripts publics restent
      reproductibles.
    </p>
  </section>
</BaseLayout>
