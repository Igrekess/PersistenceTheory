---
import BaseLayout from '@layouts/BaseLayout.astro';
import DashboardHero from '@components/DashboardHero.astro';

const commitments = [
  { id: 'C1', status: 'THM', cls: 'pt-tag-thm', label: 'Calibration SCU comme convention de Buckingham π', detail: '1 SCU ≡ 1 MeV. Dissoute en convention d\'unité ; cf. App. P §C1.' },
  { id: 'C2', status: 'THM', cls: 'pt-tag-thm', label: 'N(p) = (p+1)^(p+1) − 1 universel', detail: 'Domaine [p+1] via ZFC + L0 max-entropie ; preuve simplifiée plain Set + ZFC additivité.' },
  { id: 'C3', status: 'DER/COND', cls: 'pt-tag-cond', label: 'n_up = 9/8 via Fisher 2-boucles sur T³', detail: 'Amplitude T³ Fisher dérivée ; cf. ch10 thm:n_up_fisher_T3.' },
  { id: 'C4', status: 'DER/COND', cls: 'pt-tag-cond', label: 'Coefficient NNLO 5/18 = p₂/(2p₁²)', detail: 'Exact une fois posées sa topologie d\'incidence et son affectation de rôle ; statut conditionnel (requalification B4, 14 août 2026).' },
  { id: 'C5', status: 'DER/COND', cls: 'pt-tag-cond', label: 'Fisher–Koide NLO 1/21', detail: '1/21 = Haar(Z/3Z) × Haar(Z/7Z) ; f₅ exclu NNLO via T6.' },
  { id: 'C6', status: 'DER/COND', cls: 'pt-tag-cond', label: 'Holonomie de Berry 3π', detail: 'Limite N_gen × π justifiée par auto-cohérence.' },
  { id: 'C7', status: 'THM', cls: 'pt-tag-thm', label: 'γ₃ linéaire dans la resommation spirale', detail: 'Promu THM 2026-04-26 ; App. P §C7 p. 681-683.' },
  { id: 'C8', status: 'DER/COND', cls: 'pt-tag-cond', label: '24 exposants de quark', detail: 'Catalogue clos par énumération combinatoire.' },
  { id: 'C9', status: 'THM', cls: 'pt-tag-thm', label: 'Portail de Higgs δ = m_H²/M²', detail: 'Hiérarchie inverse exclue ; cf. App. P §C9.' },
  { id: 'C10', status: 'THM', cls: 'pt-tag-thm', label: 'Super-écho {11,13,17,19,23}', detail: 'Cutoff p = 23 hadronique dérivé.' },
];
---

<BaseLayout title="Audit transparent">
  <DashboardHero
    eyebrow="Technique · traçabilité"
    title="Audit transparent"
    plain="Cette page rassemble les choix structurels, les vérifications internes, les audits externes et les corrections appliquées. Elle sert de registre de lecture critique du site et de la monographie."
    standard="Chaque engagement C1–C10 est présenté comme un choix discret, avec son statut épistémique. Depuis la requalification B4 du 14 août 2026, le compteur officiel C1–C12 est à 5 [THM] + 6 [DER]/[COND] + 1 [VAL]. L’objectif est de séparer ce qui est démontré, dérivé, validé, prédit ou encore ouvert."
    note="Préimpression ouverte : le site conserve la trace des points solides et des points à vérifier."
  />

  <section class="max-w-4xl mx-auto px-4 py-10 md:py-14">

    <h2 class="text-xl font-semibold text-thmblue mt-10 mb-3 font-sans">
      Les engagements structurels C1–C10
    </h2>
    <p class="text-stone-700 mb-4">
      Chaque choix discret de la chaîne de dérivation est fermé par un argument
      explicite et porte son propre statut épistémique. Depuis la
      <strong>requalification B4 du 14 août 2026</strong>, le compteur officiel
      court sur C1–C12 et vaut
      <strong>5 <span class="pt-tag pt-tag-thm">THM</span> + 6
      <span class="pt-tag pt-tag-cond">DER/COND</span> + 1
      <span class="pt-tag pt-tag-val">VAL</span></strong>. Parmi les dix
      engagements listés ci-dessous, cinq sont THM et cinq sont DER/COND ; C11
      (VAL) et C12 (DER/COND) ne sont pas détaillés sur cette page. Aucun n’est
      un paramètre continu ; aucun ne peut être ajusté pour améliorer un fit.
    </p>

    <div class="grid md:grid-cols-2 gap-3 mb-10">
      {commitments.map(c => (
        <div class="pt-card text-sm">
          <div class="flex items-center gap-2 mb-1">
            <span class="font-sans font-bold text-thmblue">{c.id}</span>
            <span class={`pt-tag ${c.cls}`}>{c.status}</span>
          </div>
          <p class="text-stone-800 font-sans font-semibold">{c.label}</p>
          <p class="text-stone-600 mt-1">{c.detail}</p>
        </div>
      ))}
    </div>

    <h2 class="text-xl font-semibold text-thmblue mt-10 mb-3 font-sans">
      Statut de revue par les pairs
    </h2>
    <p class="text-stone-700">
      <strong>Préimpression — non révisée par les pairs.</strong> L’auteur
      accueille la critique scrupuleuse et la vérification indépendante. Le
      registre canonique compte 45 entrées de scripts Python compagnons,
      2 522/2 523 contrôles passants et 1 échec connu ; les scripts publics restent
      reproductibles.
    </p>
  </section>
</BaseLayout>
