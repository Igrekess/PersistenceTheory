const experimentalCount = confirmations.filter((c) => c.status === 'experimental').length;
const classicalCount = confirmations.filter((c) => c.status === 'classical').length;
const preprintCount = confirmations.filter((c) => c.status === 'preprint').length;

const featured = confirmations.filter((c) => c.status === 'published');
---

<BaseLayout
  title="Confirmations externes"
  description={`${totalCount} résultats expérimentaux, théorèmes mathématiques classiques et publications récentes (peer-reviewed et arXiv) compatibles avec PT — sans avoir été conçus pour la tester.`}
>
  <PageHero
    eyebrow="Simple · validation externe"
    domain="meta"
    title={`${totalCount} confirmations indépendantes`}
    kicker="Pas conçues pour PT. Compatibles avec PT, sans ajustement."
    dekL1="Une théorie peut être interne et auto-cohérente sans pour autant dire quelque chose sur le monde. Pour PT, le test est différent : si la théorie est juste, des résultats indépendants — théorèmes mathématiques classiques, mesures expérimentales, publications récentes — devraient lui être compatibles sans réajustement."
    dekL2={`${totalCount} confirmations dans 7 domaines distincts. Aucune n’a été produite pour valider PT ; toutes lui sont compatibles. Ce n’est pas une preuve, mais c’est une garantie de cohérence externe rare en physique théorique alternative.`}
  />

  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14">

    <!-- LEGENDE STATUTS -->
    <section class="mb-10">
      <p class="pt-tag pt-tag-id mb-3">Simple</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Lire les statuts en un coup d’œil</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="rounded-lg border-2 border-emerald-500 bg-emerald-50 p-4">
          <p class="font-mono text-2xl mb-1">★</p>
          <p class="font-sans font-bold text-emerald-900 text-sm">Publié peer-reviewed</p>
          <p class="text-xs text-emerald-800 mt-1">{publishedCount} entrées</p>
          <p class="text-xs text-emerald-700 mt-1">Phys. Rev. D, PRR, Nat. Commun., Proc. R. Soc., PRL</p>
        </div>
        <div class="rounded-lg border-2 border-violet-400 bg-violet-50 p-4">
          <p class="font-mono text-2xl mb-1">▲</p>
          <p class="font-sans font-bold text-violet-900 text-sm">Mesure expérimentale</p>
          <p class="text-xs text-violet-800 mt-1">{experimentalCount} entrées</p>
          <p class="text-xs text-violet-700 mt-1">CODATA, PDG, Planck, Fermilab, Borexino</p>
        </div>
        <div class="rounded-lg border-2 border-blue-400 bg-blue-50 p-4">
          <p class="font-mono text-2xl mb-1">◆</p>
          <p class="font-sans font-bold text-blue-900 text-sm">Théorème classique</p>
          <p class="text-xs text-blue-800 mt-1">{classicalCount} entrées</p>
          <p class="text-xs text-blue-700 mt-1">Cencov, Mihăilescu, Wiles, Bekenstein, etc.</p>
        </div>
        <div class="rounded-lg border-2 border-amber-400 bg-amber-50 p-4">
          <p class="font-mono text-2xl mb-1">○</p>
          <p class="font-sans font-bold text-amber-900 text-sm">Prépublication arXiv</p>
          <p class="text-xs text-amber-800 mt-1">{preprintCount} entrées</p>
          <p class="text-xs text-amber-700 mt-1">Non encore revues par les pairs</p>
        </div>
      </div>
    </section>

    <!-- PUBLICATIONS PEER-REVIEWED MISES EN AVANT -->
    {featured.length > 0 && (
      <section class="mb-12" data-min-depth="L2">
        <p class="pt-tag pt-tag-val mb-3">Standard</p>
        <h2 class="text-3xl font-bold text-thmblue mb-4">Publications récentes peer-reviewed</h2>
        <p class="text-base text-slate-700 leading-relaxed mb-6" data-min-depth="L2">
          Convergences indépendantes publiées dans des revues à comité de
          lecture entre 2021 et 2026. Ce sont les confirmations les plus
          fortes : article relu, accepté, ressorti structurellement compatible
          avec PT.
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          {featured.map((c) => (
            <div class="rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5 shadow-sm">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xl">★</span>
                <span class="font-mono text-xs text-emerald-700">{c.year}</span>
                <span class="font-sans text-xs uppercase tracking-wider text-emerald-800 ml-auto">{c.field}</span>
              </div>
              <h3 class="font-sans font-bold text-emerald-900 text-base mb-2">{c.label}</h3>
              <p class="text-xs text-emerald-800 italic mb-3">{c.statusLabel}</p>
              <p class="text-sm text-emerald-900 leading-relaxed mb-3" set:html={c.role.replace(/\$([^$]+)\$/g, '<em>$1</em>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
              <div class="flex flex-wrap gap-2 mt-3">
                {c.links.doi && (
                  <a href={c.links.doi} target="_blank" rel="noopener noreferrer" class="text-xs font-sans font-semibold text-emerald-800 bg-white border border-emerald-400 rounded-full px-3 py-1 hover:bg-emerald-100">
                    DOI ↗
                  </a>
                )}
                {c.links.arxiv && (
                  <a href={c.links.arxiv} target="_blank" rel="noopener noreferrer" class="text-xs font-sans font-semibold text-emerald-800 bg-white border border-emerald-400 rounded-full px-3 py-1 hover:bg-emerald-100">
                    arXiv ↗
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- DOMAINES -->
    <section class="mb-12">
      <p class="pt-tag pt-tag-id mb-3">Simple</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Sept domaines indépendants</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {fields.map((f) => (
          <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-xs font-sans uppercase tracking-wider text-stone-500 mb-1">Domaine</p>
            <p class="font-sans font-semibold text-thmblue text-sm">{f}</p>
            <p class="text-xs text-stone-500 mt-2">{confirmations.filter((c) => c.field === f).length} confirmation(s)</p>
          </div>
        ))}
      </div>
    </section>

    <!-- TABLE COMPLETE -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-val mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Les {totalCount}, par domaine</h2>
      <div class="space-y-4">
        {fields.map((field) => {
          const items = confirmations.filter((c) => c.field === field);
          return (
            <div>
              <h3 class="font-sans text-xs font-bold uppercase tracking-wider text-stone-600 border-b border-stone-300 pb-1 mb-3">{field} <span class="text-stone-400 font-normal">· {items.length}</span></h3>
              <div class="space-y-3">
                {items.map((c) => (
                  <div class={`rounded-lg border p-5 shadow-sm ${c.status === 'published' ? 'border-emerald-300 bg-emerald-50/40' : 'border-slate-200 bg-white'}`}>
                    <div class="flex items-start gap-3 mb-3">
                      <span class={`flex-shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full font-mono text-sm ${c.status === 'published' ? 'bg-emerald-200 text-emerald-900' : c.status === 'preprint' ? 'bg-amber-200 text-amber-900' : c.status === 'classical' ? 'bg-blue-200 text-blue-900' : 'bg-violet-200 text-violet-900'}`}>
                        {statusIcon[c.status]}
                      </span>
                      <div class="flex-1">
                        <div class="flex flex-wrap items-baseline gap-2 mb-1">
                          <h4 class="font-sans text-base md:text-lg font-bold text-thmblue">{c.label}</h4>
                          <span class="font-mono text-xs text-stone-600">{c.year}</span>
                          <span class={`text-xs font-sans uppercase tracking-wider border rounded-full px-2 py-0.5 ${statusBadgeClasses[c.status]}`}>
                            {c.statusLabel}
                          </span>
                        </div>
                      </div>
                    </div>
                    <p class="text-sm text-slate-800 leading-relaxed mb-2">
                      <strong class="text-derorange">Énoncé :</strong> <span set:html={c.role.replace(/\$([^$]+)\$/g, '<em>$1</em>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
                    </p>
                    <p class="text-sm text-slate-700 leading-relaxed mb-3">
                      <strong class="text-emerald-700">Lien PT :</strong> <span set:html={c.why.replace(/\$([^$]+)\$/g, '<em>$1</em>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\*(.*?)\*/g, '<em>$1</em>')} />
                    </p>
                    {c.flag && (
                      <p class="text-xs text-rose-800 bg-rose-50 border border-rose-300 rounded px-3 py-2 mb-3">
                        <strong>⚠ {c.flag}</strong>
                      </p>
                    )}
                    <div class="flex flex-wrap gap-2 mt-2">
                      {c.links.wikipedia && (
                        <a href={c.links.wikipedia} target="_blank" rel="noopener noreferrer" class="text-xs font-sans text-blue-800 bg-white border border-blue-300 rounded-full px-3 py-1 hover:bg-blue-50">
                          Wikipédia ↗
                        </a>
                      )}
                      {c.links.doi && (
                        <a href={c.links.doi} target="_blank" rel="noopener noreferrer" class="text-xs font-sans text-emerald-800 bg-white border border-emerald-400 rounded-full px-3 py-1 hover:bg-emerald-50">
                          DOI ↗
                        </a>
                      )}
                      {c.links.arxiv && (
                        <a href={c.links.arxiv} target="_blank" rel="noopener noreferrer" class="text-xs font-sans text-amber-800 bg-white border border-amber-400 rounded-full px-3 py-1 hover:bg-amber-50">
                          arXiv ↗
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- METHODOLOGIE -->
    <section class="mb-12" data-min-depth="L3">
      <p class="pt-tag pt-tag-thm mb-3">Technique · méthodologie</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Ce que chaque confirmation veut dire</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
          <h3 class="font-sans font-semibold text-emerald-800 text-lg mb-2">Confirmation théorique</h3>
          <p class="text-sm text-emerald-900 leading-relaxed">
            Un théorème mathématique classique (Čencov, Mihăilescu, Wiles)
            est utilisé par PT comme <strong>brique structurelle</strong>. Si
            ce théorème est faux, PT s’effondre. Confirmation = théorème
            reste valide.
          </p>
        </div>
        <div class="rounded-lg border-2 border-blue-300 bg-blue-50 p-5">
          <h3 class="font-sans font-semibold text-blue-800 text-lg mb-2">Confirmation expérimentale</h3>
          <p class="text-sm text-blue-900 leading-relaxed">
            Une mesure indépendante (CODATA, PDG, Planck, Fermilab)
            <strong>rétrodit</strong> une valeur PT à $\sigma$ près. Si la
            mesure s’éloigne significativement, PT est falsifiée.
          </p>
        </div>
        <div class="rounded-lg border-2 border-violet-300 bg-violet-50 p-5">
          <h3 class="font-sans font-semibold text-violet-800 text-lg mb-2">Confirmation négative</h3>
          <p class="text-sm text-violet-900 leading-relaxed">
            Une mesure cherche un effet (axion, SUSY, KK modes) que PT
            <strong>interdit</strong>. L’absence durable de ces effets
            confirme PT négativement (P10–P14).
          </p>
        </div>
        <div class="rounded-lg border-2 border-amber-300 bg-amber-50 p-5">
          <h3 class="font-sans font-semibold text-amber-800 text-lg mb-2">Compatibilité structurelle</h3>
          <p class="text-sm text-amber-900 leading-relaxed">
            Un cadre indépendant (Verlinde, Jacobson, Bekenstein, Bianconi)
            propose une structure compatible avec PT sans s’y référer.
            Convergence d’idées → indication de cohérence externe.
          </p>
        </div>
      </div>
    </section>

    <!-- LIENS -->
    <section class="mb-8">
      <p class="pt-tag pt-tag-bridge mb-3">Aller plus loin</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Approfondir</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/observables" class="pt-card block group">
          <span class="pt-tag pt-tag-val">Validation</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">43 observables vs PDG</h3>
          <p class="text-sm text-slate-700">La rétrodiction massive : 41/43 sous 0,5 % d’erreur, aucun paramètre continu ajusté.</p>
        </a>
        <a href="/predictions" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">Prédictions</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">28 Tier-1 falsifiables</h3>
          <p class="text-sm text-slate-700">Les confirmations futures attendues : DUNE, JUNO, Euclid, LEGEND.</p>
        </a>
        <a href="/limites" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Honnêteté</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Limites et points ouverts</h3>
          <p class="text-sm text-slate-700">Ce que les confirmations ne disent PAS, et ce qui reste à fermer.</p>
        </a>
        <a href="/principes-architecturaux" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">Méta-théorie</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">7 principes architecturaux</h3>
          <p class="text-sm text-slate-700">L’universalité interne qui rend les confirmations externes plausibles.</p>
        </a>
        <a href="/audit" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Audit</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Engagements C1–C10</h3>
          <p class="text-sm text-slate-700">Les fermetures internes que les confirmations externes mettent à l’épreuve.</p>
        </a>
        <a href="/difficile-a-rejeter" class="pt-card block group">
          <span class="pt-tag pt-tag-bridge">Robustesse</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Pourquoi PT est dur à rejeter</h3>
          <p class="text-sm text-slate-700">Les 5 critères de robustesse, dont la cohérence externe.</p>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
