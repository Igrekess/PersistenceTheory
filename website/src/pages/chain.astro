---
import BaseLayout from '@layouts/BaseLayout.astro';

const lang = 'fr';
const tBase = '/theorems';
const nodes = [
  { id: 'T0', label: 'T0', sub: 'champ dynamique', x: 60, y: 90, kind: 'thm', href: `${tBase}/T0`, tooltip: 'BA0 se ferme : la suite des écarts {g_n} est l’unique champ dynamique admissible.' },
  { id: 'L0', label: 'L0', sub: 'distribution unique', x: 190, y: 90, kind: 'thm', href: `${tBase}/L0`, tooltip: 'Géométrique = unique distribution sans mémoire à entropie max.' },
  { id: 'T1', label: 'T1', sub: 'transitions interdites', x: 310, y: 90, kind: 'thm', href: `${tBase}/T1`, tooltip: 'Les transitions 1→1 et 2→2 mod 3 sont interdites. Cette diagonale nulle force s = 1/2.' },
  { id: 'P2', label: 'p = 2', sub: 'dynamique spin', x: 430, y: 90, kind: 'bridge', href: `${tBase}/N4`, tooltip: 'p=2 porte la dynamique spin/parité : deux canaux ±, dont s=1/2 est la moyenne.' },
  { id: 's', label: 's = 1/2', sub: 'moyenne de parité', x: 560, y: 90, kind: 'thm', href: `${tBase}/T1`, tooltip: 'Symétrie dérivée par T1/T4 : invariant moyen du doublet de parité, pas paramètre choisi.' },
  { id: 'T2', label: 'T2', sub: 'conservation α = s²', x: 690, y: 90, kind: 'thm', href: `${tBase}/T2`, tooltip: 'Conservation spectrale : |λ₂(T₃₀)| = 1/4 = s².' },
  { id: 'GFT', label: 'GFT', sub: 'log m = D_KL + H', x: 820, y: 90, kind: 'thm', href: `${tBase}/GFT`, tooltip: 'Principe fondamental de la persistance : capacité = persistance + entropie.' },
  { id: 'T3', label: 'T3', sub: 'transfert antidiagonal', x: 950, y: 90, kind: 'thm', href: `${tBase}/T3`, tooltip: 'Le noyau mod 3 devient purement antidiagonal après T1.' },
  { id: 'T4', label: 'T4', sub: 'convergence αₖ → ½', x: 220, y: 220, kind: 'thm', href: `${tBase}/T4`, tooltip: 'Mertens + Gordin + CRT : le crible finit le travail.' },
  { id: 'T6', label: 'T6', sub: 'holonomie sin²θ_p', x: 360, y: 220, kind: 'thm', href: `${tBase}/T6`, tooltip: 'sin²θ_p = δ_p(2 − δ_p). La trigonométrie émerge.' },
  { id: 'T5', label: 'T5', sub: 'μ* = 3 + 5 + 7 = 15', x: 540, y: 220, kind: 'thm', href: `${tBase}/T5`, tooltip: 'Le point fixe arithmétique attractif du secteur réduit.' },
  { id: 'BIF', label: 'Bifurcation', sub: 'q⁺ / q⁻', x: 760, y: 220, kind: 'bridge', href: null, tooltip: 'Engendrée par p=2, puis figée à μ* = 15 : q⁺ = 1 − 2/μ ; q⁻ = e^(−1/μ).' },
  { id: 'qplus', label: 'q⁺', sub: 'couplages, leptons, α_EM', x: 600, y: 360, kind: 'der', href: '/observables', tooltip: 'Vertex, α_EM = 1/137, masses leptons, PMNS.' },
  { id: 'qminus', label: 'q⁻', sub: 'géométrie, quarks, CKM', x: 920, y: 360, kind: 'der', href: '/observables', tooltip: 'Propagateur, métrique, masses quarks, CKM.' },
  { id: 'OBS', label: '43 observables', sub: 'erreur moy. 0,316 %', x: 760, y: 470, kind: 'val', href: '/observables', tooltip: 'Modèle Standard reproduit, 0 paramètre continu ajusté.' },
];

const edges = [
  ['T0', 'L0'], ['L0', 'T1'], ['T1', 'P2'], ['P2', 's'], ['s', 'T2'], ['T2', 'GFT'], ['GFT', 'T3'],
  ['T3', 'T4'], ['T4', 'T6'], ['T6', 'T5'], ['P2', 'BIF'], ['T5', 'BIF'],
  ['BIF', 'qplus'], ['BIF', 'qminus'],
  ['qplus', 'OBS'], ['qminus', 'OBS'],
];

function fill(kind: string) {
  return {
    input: { fill: '#fef3c7', stroke: '#d97706', text: '#78350f' },
    thm: { fill: '#dbeafe', stroke: '#1d4ed8', text: '#1e3a8a' },
    bridge: { fill: '#ede9fe', stroke: '#7c3aed', text: '#4c1d95' },
    der: { fill: '#fed7aa', stroke: '#ea580c', text: '#7c2d12' },
    val: { fill: '#d1fae5', stroke: '#059669', text: '#064e3b' },
  }[kind] || { fill: 'white', stroke: '#888', text: '#333' };
}

const W = 1080, H = 540;
---

<BaseLayout
  title="Chaîne causale"
  description="Du crible aux 43 observables : la chaîne causale interactive de la Théorie de la Persistance. Cliquer sur un maillon ouvre le théorème correspondant."
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">Chaîne causale</h1>
    <p class="text-stone-700 mb-6 max-w-3xl">
      De la chaîne arithmétique à la symétrie dérivée <span class="font-mono">s = 1/2</span>,
      puis aux 43 observables du Modèle Standard. Les maillons distinguent théorèmes, ponts,
      dérivations et validations. Clique sur un maillon pour ouvrir sa fiche.
    </p>

    <div class="bg-white border border-stone-200 rounded-lg p-4 overflow-x-auto">
      <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[900px]" aria-label="Chaîne causale PT" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#475569" />
          </marker>
        </defs>

        {edges.map(([from, to]) => {
          const a = nodes.find(n => n.id === from)!;
          const b = nodes.find(n => n.id === to)!;
          const dx = b.x - a.x, dy = b.y - a.y;
          const len = Math.sqrt(dx*dx + dy*dy);
          const nx = dx/len, ny = dy/len;
          // Pull endpoints in by node half-extent (~55,30)
          const ax = a.x + nx * 55, ay = a.y + ny * 28;
          const bx = b.x - nx * 55, by = b.y - ny * 28;
          return (
            <line x1={ax} y1={ay} x2={bx} y2={by} stroke="#475569" stroke-width="1.6" marker-end="url(#arrow)" />
          );
        })}

        {nodes.map(n => {
          const c = fill(n.kind);
          const w = n.id === 'OBS' ? 180 : (n.id === 'BIF' ? 130 : 110);
          const h = n.id === 'OBS' ? 60 : 50;
          return (
            <g class="chain-node" data-tooltip={n.tooltip}>
              <a href={n.href} class={n.href ? '' : 'pointer-events-none'}>
                <rect x={n.x - w/2} y={n.y - h/2} width={w} height={h} rx="6" fill={c.fill} stroke={c.stroke} stroke-width="1.5" />
                <text x={n.x} y={n.y - 5} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="14" font-weight="700" fill={c.text}>{n.label}</text>
                <text x={n.x} y={n.y + 13} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill={c.text}>{n.sub}</text>
              </a>
            </g>
          );
        })}
      </svg>
    </div>

    <div id="chain-tooltip" class="mt-4 px-4 py-3 rounded bg-stone-50 border border-stone-200 text-sm text-stone-700 italic min-h-[3rem]">
      Survole un maillon pour voir sa description, clique pour ouvrir sa fiche.
    </div>

    <div class="grid md:grid-cols-2 gap-4 mt-8 text-sm">
      <div class="pt-card">
        <h3 class="font-sans font-semibold text-thmblue mb-2">Le chemin critique</h3>
        <p class="text-stone-700">
          La chaîne part du champ dynamique fermé par T0, puis L0 fixe la loi
          de gaps et T1 impose la diagonale nulle. Le canal <span class="font-mono">p = 2</span>
          porte la dynamique spin/parité, dont <span class="font-mono">s = 1/2</span>
          est l’invariant moyen. T2 et GFT expriment la conservation, T6 fait
          émerger la trigonométrie, puis T5 ferme l’attracteur réduit.
        </p>
      </div>
      <div class="pt-card">
        <h3 class="font-sans font-semibold text-thmblue mb-2">La bifurcation</h3>
        <p class="text-stone-700">
          La scission vient d’abord de <span class="font-mono">p = 2</span> :
          parité, deux canaux <span class="font-mono">±</span>. À
          <span class="font-mono">μ* = 15</span>, cette scission est figée comme
          <span class="font-mono">q⁺/q⁻</span>. La branche <span class="font-mono">q⁺</span>
          donne les couplages ; <span class="font-mono">q⁻</span> donne la géométrie.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap gap-x-4 gap-y-1 mt-6 text-xs font-sans text-stone-600">
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#fef3c7;border:1px solid #d97706"></span>entrée</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#dbeafe;border:1px solid #1d4ed8"></span>théorème</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#ede9fe;border:1px solid #7c3aed"></span>pont</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#fed7aa;border:1px solid #ea580c"></span>dérivation</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#d1fae5;border:1px solid #059669"></span>vérifié</span>
    </div>
  </section>

  <script is:inline>
    (function () {
      const tooltip = document.getElementById('chain-tooltip');
      const defaultText = tooltip.textContent;
      document.querySelectorAll('.chain-node').forEach(node => {
        node.addEventListener('mouseenter', () => {
          tooltip.textContent = node.getAttribute('data-tooltip') || defaultText;
          tooltip.classList.remove('italic');
        });
        node.addEventListener('mouseleave', () => {
          tooltip.textContent = defaultText;
          tooltip.classList.add('italic');
        });
      });
    })();
  </script>
</BaseLayout>
