---
import BaseLayout from '@layouts/BaseLayout.astro';
import faqData from '@/data/faq.json';

const total = faqData.categories.reduce((s, c) => s + c.entries.length, 0);
---

<BaseLayout
  title="FAQ"
  description="Réponses aux questions fréquentes sur la Théorie de la Persistance : statut épistémique, lecture du formalisme, rapport au Modèle Standard, falsifiabilité, ce que la théorie ne dit pas."
>
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">Foire aux questions</h1>
    <p class="text-stone-700 mb-2 max-w-3xl">
      {total} questions, organisées en {faqData.categories.length} sections.
      Cliquer sur une question pour développer la réponse.
    </p>
    <p class="text-sm text-stone-500 mb-8">
      Tu ne trouves pas ta réponse ? La page <a href="/audit" class="underline hover:text-thmblue">audit</a>
      détaille les choix structurels (C1–C10) de la théorie. Pour une critique
      de fond, voir <a href="/about" class="underline hover:text-thmblue">À propos</a>.
    </p>

    {faqData.categories.map(cat => (
      <div class="mb-8">
        <h2 class="text-xl font-sans font-semibold text-thmblue mb-3 border-b border-stone-200 pb-1">
          {cat.fr}
        </h2>
        <div class="space-y-2">
          {cat.entries.map(e => (
            <details class="group bg-white border border-stone-200 rounded-md">
              <summary class="cursor-pointer list-none px-4 py-3 font-sans text-stone-800 hover:bg-stone-50 flex items-start gap-2">
                <span class="text-thmblue font-mono text-sm mt-0.5 group-open:rotate-90 transition-transform">▸</span>
                <span class="flex-1 font-medium">{e.fr.q}</span>
              </summary>
              <div class="px-4 pb-4 pl-9 text-stone-700">
                {e.fr.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}

    <p class="text-sm text-stone-500 mt-12 italic">
      Cette FAQ est vivante. Si une question importante manque ou si une réponse
      est imprécise, contacte yan.senez@protonmail.com.
    </p>
  </section>
</BaseLayout>
