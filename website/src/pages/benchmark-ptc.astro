              <td class="py-2 px-3 text-right tabular-nums font-bold text-thmblue">{m.timing.ptc.per_bin['A+B (n≤8)'].total_s.toFixed(2)} s</td>
              <td class="py-2 px-3 text-right tabular-nums font-bold">× {Math.round(m.timing.b3lyp_def2tzvp.per_bin['A+B (n≤8)'].total_s / m.timing.ptc.per_bin['A+B (n≤8)'].total_s).toLocaleString('fr-FR')}</td>
            </tr>
