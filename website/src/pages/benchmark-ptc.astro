---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import metricsData from '@data/benchmarkMetrics.json';
import bench1Data from '@data/benchmark1000.json';

const m = metricsData as any;
const b1 = m.bench1;
const b2 = m.bench2;
const b3 = m.bench3;

const heroMetrics = [
  { label: '0 variable d\'ajustement', value: '0', sub: 'Aucun coefficient ajusté' },
  { label: 'Molécules testées', value: b1.n.toLocaleString('fr-FR'), sub: 'ATcT 0K · expérience' },
  { label: 'MAE PTC vs expérience', value: `${b1.mae_eV} eV`, sub: `${b1.mae_pct} % relative` },
  { label: 'Win rate vs B3LYP', value: `${b2.ptc_win_rate_pct} %`, sub: 'sur 855 mol appariées' },
];

// Pre-format bench3 summary into a table-ready structure
const b3Bins = ['A (n=2-4)', 'B (n=5-8)', 'C (n=9-12)', 'A+B+C (n≤12)'];
const b3Methods = ['B3LYP/6-31G*', 'B3LYP/def2-TZVP', 'PTC'];
const b3Cell = (bin: string, method: string) =>
  b3.summary.find((r: any) => r.bin === bin && r.method === method);

// Categories for bench1 table
const cat1 = b1.per_category;

// Stats for the 1000-mol table
const totalRows = bench1Data.rows.length;
const buckets = (bench1Data as any).reliability_buckets ?? {};
const tiers = (bench1Data as any).tiers ?? {};
const verifiedGreen = buckets.green ?? 0;
---

<BaseLayout
  title="Benchmark PTC"
  description="Benchmark de PTC sur 994 molécules ATcT (MAE 0,73 eV, 0 variable d'ajustement), comparaison vs B3LYP/6-31G* (gain −35 %, win rate 70,8 %), et comparaison 3-voies vs B3LYP/def2-TZVP. Données traçables, sources NIST/ATcT/JANAF, CSV téléchargeables, code MIT public."
>
  <PageHero
    eyebrow="Chimie · benchmark"
    domain="chemistry"
    title="Benchmark PTC"
    kicker="0 variable d'ajustement, −35 % d’erreur vs B3LYP/6-31G* sur 855 molécules ATcT."
    dek="Trois benchmarks distincts présentés ici : (1) PTC face aux mesures expérimentales sur 994 molécules ; (2) PTC vs B3LYP/6-31G* sur 855 molécules appariées ; (3) PTC vs B3LYP/def2-TZVP sur 536 molécules de taille n ≤ 12. Toutes les données sont sourcées (NIST WebBook, ATcT v1.130, JANAF, etc.), traçables au niveau de la molécule, et reproductibles depuis le code MIT public."
    oneLineNote={{ label: 'Statut', body: `tous les calculs PTC dérivent analytiquement de l’unique input s = 1/2 (T1, transitions interdites), de l’ossature arithmétique des premiers actifs {2, 3, 5, 7, 11, 13} (canal de parité Z/2Z, cascade 3·5·7, premiers d’écho 11·13), et des principes PT — cycle de phase (holonomie T6), bilan informationnel (identité GFT log₂ m = D_KL + H), cascade séquentielle 3 → 5 → 7, bifurcation q₊/q₋, anti-double-comptage. 0 variable d’ajustement, aucun degré de liberté, aucun choix libre dans la sélection des primes ni dans les principes. B3LYP utilise trois paramètres ajustés calibrés sur G2. Aucune comparaison n’est faite ici contre G4 / W1 / CCSD(T) — méthodes composites à ~0,04 eV de précision mais avec ~10 variables d'ajustement.` }}
    width="normal"
  />

  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14 space-y-14">

    <!-- HERO METRICS -->
    <section>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {heroMetrics.map((m) => (
          <div class="rounded-lg border-2 border-amber-300 bg-amber-50 p-5">
            <p class="text-xs font-sans uppercase tracking-wider text-amber-800 mb-1">{m.label}</p>
            <p class="text-3xl md:text-4xl font-bold text-thmblue tabular-nums">{m.value}</p>
            <p class="text-xs text-stone-600 mt-1">{m.sub}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============================================== -->
    <!-- WHAT PTC COMPUTES                              -->
    <!-- ============================================== -->
    <section>
      <p class="pt-tag pt-tag-val mb-3">Ce que PTC calcule</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">Toutes ces observables — un seul moteur, un seul input</h2>
      <p class="text-slate-700 leading-relaxed mb-6 max-w-4xl">
        PTC n’est pas spécialisé sur l’énergie d’atomisation : c’est un
        calculateur ab initio PT qui dérive analytiquement <strong>toutes
        les observables moléculaires</strong> depuis l’unique input
        s = 1/2 + l’ossature des premiers actifs {'{2, 3, 5, 7, 11, 13}'}.
        Le tableau ci-dessous récapitule les observables couvertes, leur
        précision actuelle et leur statut. La suite de la page se concentre
        sur D_atomisation — l’observable la plus testée à grande échelle —
        mais le moteur produit aussi r_e, ω_e, IE, EA, NICS, σ_RMN, etc.
        sans le moindre paramètre ajusté à des données.
      </p>

      <div class="overflow-x-auto">
        <table class="text-sm font-sans w-full">
          <thead class="bg-slate-50 border-b border-stone-300 text-xs text-stone-600 uppercase">
            <tr>
              <th class="text-left py-2 px-3">Niveau</th>
              <th class="text-left py-2 px-3">Observable</th>
              <th class="text-left py-2 px-3">Précision actuelle</th>
              <th class="text-left py-2 px-3">Statut</th>
            </tr>
          </thead>
          <tbody class="text-slate-700">
            <tr class="border-b border-stone-200 bg-amber-50/40">
              <td class="py-2 px-3 font-medium" rowspan="2">Atomique<br/><span class="text-xs text-stone-500">Z = 1 → 118</span></td>
              <td class="py-2 px-3">IE — énergie d’ionisation</td>
              <td class="py-2 px-3 tabular-nums">MAE <strong>0,046 %</strong></td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span> · 118 éléments</td>
            </tr>
            <tr class="border-b border-stone-200 bg-amber-50/40">
              <td class="py-2 px-3">EA — affinité électronique</td>
              <td class="py-2 px-3 tabular-nums">MAE <strong>0,98 %</strong></td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span> · 73 atomes neutres</td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-3 font-medium" rowspan="4">Liaison<br/><span class="text-xs text-stone-500">BondResult</span></td>
              <td class="py-2 px-3">D₀ — énergie de dissociation</td>
              <td class="py-2 px-3 tabular-nums">cf. D_at moléculaire</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-3">r<sub>e</sub> — distance d’équilibre</td>
              <td class="py-2 px-3 text-stone-600">métrique Bianchi I, sans table de rayons covalents</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-3">ω<sub>e</sub> — fréquence vibrationnelle harmonique</td>
              <td class="py-2 px-3 text-stone-600">~10 % typique sur diatomiques</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-3">θ — angles de liaison</td>
              <td class="py-2 px-3 text-stone-600">fraction de face × angle solide, sans VSEPR</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span></td>
            </tr>
            <tr class="border-b border-stone-200 bg-amber-50/40">
              <td class="py-2 px-3 font-medium" rowspan="2">Moléculaire<br/><span class="text-xs text-stone-500">TransferResult</span></td>
              <td class="py-2 px-3"><strong>D_at — énergie d’atomisation totale</strong></td>
              <td class="py-2 px-3 tabular-nums">
                MAE <strong>3,22 %</strong> (994 ATcT) ·{' '}
                <strong>6,55 %</strong> (650 Burcat)
              </td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span> · objet de cette page</td>
            </tr>
            <tr class="border-b border-stone-200 bg-amber-50/40">
              <td class="py-2 px-3">Décomposition per-face P₁/P₂/P₃ + spectral T<sub>P₁</sub></td>
              <td class="py-2 px-3 text-stone-600">contribution σ+π / d-back / ionique par liaison</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-3 font-medium" rowspan="2">Aromaticité<br/><span class="text-xs text-stone-500">nics.py · NICSResult</span></td>
              <td class="py-2 px-3">NICS — Nucleus-Independent Chemical Shift</td>
              <td class="py-2 px-3 text-stone-600">Pauling-London PT, ~3 ppm sur benzène</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-3">Classification σ/π — règle de Hückel signée</td>
              <td class="py-2 px-3 text-stone-600">aromatique / antiaromatique / radical</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span></td>
            </tr>
            <tr class="border-b border-stone-200 bg-amber-50/40">
              <td class="py-2 px-3 font-medium" rowspan="3">Magnétique<br/><span class="text-xs text-stone-500">lcao/ · GIAO + CPHF</span></td>
              <td class="py-2 px-3">σ — tenseur de blindage chimique RMN</td>
              <td class="py-2 px-3 text-stone-600">¹H MAE 1,4 ppm sur le set de Haan</td>
              <td class="py-2 px-3"><span class="text-amber-700">production partielle</span> · ¹H ✓</td>
            </tr>
            <tr class="border-b border-stone-200 bg-amber-50/40">
              <td class="py-2 px-3">Cascade post-HF : MP2, CCD, CCSD, Λ-CCSD</td>
              <td class="py-2 px-3 text-stone-600">σ_p^CCSD-Λ-GIAO complet</td>
              <td class="py-2 px-3"><span class="text-amber-700">production partielle</span></td>
            </tr>
            <tr class="border-b border-stone-200 bg-amber-50/40">
              <td class="py-2 px-3">Densité de courant induite (GIMIC PT-pur)</td>
              <td class="py-2 px-3 text-stone-600">flux à travers la liaison · NICS via Biot-Savart</td>
              <td class="py-2 px-3"><span class="text-amber-700">recherche</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-3 font-medium" rowspan="2">Topologie<br/><span class="text-xs text-stone-500">utilitaire moteur</span></td>
              <td class="py-2 px-3">SMILES → topologie</td>
              <td class="py-2 px-3 text-stone-600">parser RDKit + reconstruction PT</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span></td>
            </tr>
            <tr>
              <td class="py-2 px-3">Formule → topologie (crible variationnel)</td>
              <td class="py-2 px-3 text-stone-600">choisit l’isomère minimum sans SMILES</td>
              <td class="py-2 px-3"><span class="text-emerald-700">production</span> · base du test Burcat</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-stone-600 mt-3 leading-relaxed max-w-4xl">
        <strong>Note méthodologique.</strong> Toutes les précisions
        ci-dessus sont mesurées avec exactement la même contrainte :
        <strong> 0 variable d’ajustement, aucun degré de liberté</strong>,
        l’unique input s = 1/2 et l’ossature {'{2, 3, 5, 7, 11, 13}'} avec
        les principes PT (cycle de phase, bilan informationnel, cascade,
        bifurcation q₊/q₋, anti-double-comptage). Le moteur ne reçoit
        jamais de paramètre calibré sur l’expérience.
      </p>
    </section>

    <!-- ============================================== -->
    <!-- COVERAGE COMPARISON                            -->
    <!-- ============================================== -->
    <section>
      <p class="pt-tag pt-tag-val mb-3">Comparaison de couverture</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">PTC face aux autres calculateurs : qui produit quoi, et avec combien de paramètres ?</h2>
      <p class="text-slate-700 leading-relaxed mb-6 max-w-4xl">
        Reproduire des observables ab initio est un sport courant. Le faire
        <em>sans aucun paramètre ajusté à des données</em> est plus rare —
        et le faire pour D_at, géométrie, IE, EA, NICS, σ_RMN <em>en même
        temps</em>, depuis un seul input mathématique, à notre
        connaissance, n’existe pas ailleurs. Le tableau ci-dessous
        confronte PTC aux familles de méthodes les plus utilisées en
        chimie quantique. Une coche signifie que la méthode produit
        l’observable couramment ; une coche grise = en principe possible
        mais peu utilisée. La dernière colonne distingue ce qui est{' '}
        <em>strictement non-empirique</em> (issu de premiers principes,
        pas calibré sur les observables qu’on cherche à reproduire) du
        reste.
      </p>

      <div class="overflow-x-auto">
        <table class="text-xs md:text-sm font-sans w-full">
          <thead class="bg-slate-50 border-b border-stone-300 text-xs text-stone-600 uppercase">
            <tr>
              <th class="text-left py-2 px-2">Méthode</th>
              <th class="text-center py-2 px-1">D_at</th>
              <th class="text-center py-2 px-1">r<sub>e</sub></th>
              <th class="text-center py-2 px-1">ω<sub>e</sub></th>
              <th class="text-center py-2 px-1">IE/EA</th>
              <th class="text-center py-2 px-1">NICS</th>
              <th class="text-center py-2 px-1">σ_RMN</th>
              <th class="text-left py-2 px-2">Précision D_at</th>
              <th class="text-left py-2 px-2">Temps / mol</th>
              <th class="text-left py-2 px-2">Paramètres ajustés</th>
            </tr>
          </thead>
          <tbody class="text-slate-700">
            <tr class="border-b border-stone-200 bg-amber-50">
              <td class="py-2 px-2 font-bold text-thmblue">PTC</td>
              <td class="text-center text-emerald-700">✓</td>
              <td class="text-center text-emerald-700">✓</td>
              <td class="text-center text-emerald-700">✓</td>
              <td class="text-center text-emerald-700">✓</td>
              <td class="text-center text-emerald-700">✓</td>
              <td class="text-center text-emerald-700">✓</td>
              <td class="py-2 px-2 tabular-nums"><strong>0,73 eV (3,2 %)</strong> sur 994 ATcT</td>
              <td class="py-2 px-2 tabular-nums">~0,1 s (analytique)</td>
              <td class="py-2 px-2 font-bold text-emerald-700">0 <span class="font-normal text-xs text-stone-500">(s = 1/2 + premiers)</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-2 font-medium">B3LYP/6-31G*</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="py-2 px-2 tabular-nums">~0,93 eV (mesuré, 855 mol overlap)</td>
              <td class="py-2 px-2 tabular-nums">~minutes</td>
              <td class="py-2 px-2"><strong>3</strong> calibrés sur G2 (B88, Becke, LYP)</td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-2 font-medium">B3LYP/def2-TZVP</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="py-2 px-2 tabular-nums">~0,15–0,3 eV typique</td>
              <td class="py-2 px-2 tabular-nums">~30 min – plusieurs heures</td>
              <td class="py-2 px-2"><strong>3</strong> (idem B3LYP)</td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-2 font-medium">DFT moderne (M06-2X, ωB97X, …)</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="py-2 px-2 tabular-nums">~0,1–0,2 eV</td>
              <td class="py-2 px-2 tabular-nums">~minutes – heures</td>
              <td class="py-2 px-2"><strong>10–50</strong> calibrés sur jeux thermochimiques</td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-2 font-medium">Hartree-Fock</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center text-stone-400">~</td>
              <td class="text-center">✓</td>
              <td class="py-2 px-2 tabular-nums">~2 eV <span class="text-stone-500">(pas de corrélation)</span></td>
              <td class="py-2 px-2 tabular-nums">~minutes</td>
              <td class="py-2 px-2"><strong>0</strong> <span class="text-stone-500">(base atomique paramétrée)</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-2 font-medium">MP2 / CCSD / CCSD(T)</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center">✓</td>
              <td class="text-center text-stone-400">~</td>
              <td class="text-center">✓</td>
              <td class="py-2 px-2 tabular-nums">0,02–0,2 eV <em>(gold standard)</em></td>
              <td class="py-2 px-2 tabular-nums">~heures – jours <span class="text-stone-500">(N⁵ à N⁷)</span></td>
              <td class="py-2 px-2"><strong>0</strong> <span class="text-stone-500">(base atomique paramétrée)</span></td>
            </tr>
            <tr class="border-b border-stone-200">
              <td class="py-2 px-2 font-medium">G4 / W1 (composites)</td>
              <td class="text-center">✓</td>
              <td class="text-center text-stone-400">~</td>
              <td class="text-center text-stone-400">~</td>
              <td class="text-center">✓</td>
              <td class="text-center text-stone-400">~</td>
              <td class="text-center text-stone-400">~</td>
              <td class="py-2 px-2 tabular-nums">~0,01 eV <em>(chemical accuracy +)</em></td>
              <td class="py-2 px-2 tabular-nums">~heures</td>
