---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';

const survivors = [1, 7, 11, 13, 17, 19, 23, 29];
const gaps = survivors.map((value, index) => {
  const next = survivors[(index + 1) % survivors.length] + (index === survivors.length - 1 ? 30 : 0);
  return next - value;
});
const x = (n: number) => 48 + ((n - 1) / 28) * 704;
const gapMid = (a: number, b: number) => (x(a) + x(b)) / 2;
const propositions = [
  {
    tag: 'exact',
    title: 'Densité sur tore fini',
    formula: String.raw`\varphi(M_A)=M_A\prod_{p\in A}(1-1/p)`,
    text: 'Sur une période complète du crible, chaque premier actif enlève exactement sa direction locale de collapse.',
  },
  {
    tag: 'exact',
    title: 'Fenêtre racine',
    formula: String.raw`S(x;\lfloor\sqrt{x}\rfloor)=1+\pi(x)-\pi(\lfloor\sqrt{x}\rfloor)`,
    text: 'À cette profondeur, survivre signifie être 1 ou premier : tout composite aurait déjà un diviseur visible.',
  },
  {
    tag: 'exact',
    title: 'Transport des survivants',
    formula: String.raw`\Phi(x,a)=\Phi(x,a-1)-\Phi(\lfloor x/p_a\rfloor,a-1)`,
    text: 'Ajouter un premier ne multiplie pas seulement une densité : il transporte le problème vers une fenêtre contractée.',
  },
  {
    tag: 'candidat',
    title: 'Noyau PT-Buchstab',
    formula: String.raw`K_{PT}(u)=e^\gamma\,\omega(u),\quad u=\log x/\log y`,
    text: 'Candidat naturel pour la loi universelle des survivants rugueux, avec le point racine $K_{PT}(2)=e^\\gamma/2$.',
  },
];
---

<BaseLayout
  title="Mécanique PT des gaps premiers"
  description="Une page mathématique sur la mécanique PT des gaps de survivants, la réduction exacte aux nombres premiers et le statut de la loi des gaps premiers."
>
  <PageHero
    eyebrow="Mathématique PT / crible et premiers"
    domain="math"
    title="Mécanique PT des gaps : du crible aux nombres premiers"
    dekL1="L’idée est simple : on laisse agir un crible, certains nombres survivent, et les écarts entre survivants dessinent une mécanique. À la bonne profondeur, ces survivants deviennent exactement les nombres premiers."
    dekL2="La PT ne pose pas les gaps premiers comme une suite mystérieuse donnée d’avance. Elle part d’une dynamique de survivance : les points qui persistent sous les contraintes du crible forment des écarts, puis la fenêtre $y=\lfloor\sqrt{x}\rfloor$ réduit exactement ces survivants aux premiers."
  />

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid lg:grid-cols-[0.88fr_1.12fr] gap-8 items-center mb-12">
      <div>
        <span class="pt-tag pt-tag-bridge">Image</span>
        <h2 class="text-3xl font-bold text-thmblue mt-4 mb-4">
          Un gap est d’abord un écart entre survivants
        </h2>
        <p class="text-slate-700 leading-relaxed mb-4">
          Si l’on retire les multiples de 2, 3 et 5, les positions encore
          vivantes modulo 30 sont 1, 7, 11, 13, 17, 19, 23 et 29. Les gaps
          6, 4, 2, 4, 2, 4, 6, 2 ne sont pas ajoutés à la main : ils sont la
          forme laissée par le crible.
        </p>
        <p class="text-slate-700 leading-relaxed">
          C’est cette idée que la PT généralise : le discret n’est pas un
          ingrédient arbitraire, mais l’ensemble des points qui persistent dans
          une mécanique de contraintes.
        </p>
      </div>

      <div class="bg-white border border-slate-200 rounded-lg p-5">
        <h3 class="font-sans font-semibold text-thmblue mb-3">Survivants modulo 30</h3>
        <svg viewBox="0 0 800 260" class="w-full h-auto" role="img" aria-label="Gaps entre survivants du crible modulo 30">
          <line x1="48" y1="112" x2="752" y2="112" stroke="#d7e1ea" stroke-width="5" stroke-linecap="round" />
          {[1,5,10,15,20,25,30].map((tick) => (
            <g>
              <line x1={x(tick)} x2={x(tick)} y1="102" y2="122" stroke="#94a3b8" />
              <text x={x(tick)} y="152" text-anchor="middle" font-size="14" fill="#5f6f80" font-family="ui-sans-serif, system-ui">{tick}</text>
            </g>
          ))}
          {survivors.map((n) => (
            <g>
              <circle cx={x(n)} cy="112" r="15" fill="#e8f5ee" stroke="#198754" stroke-width="4" />
              <text x={x(n)} y="84" text-anchor="middle" font-size="14" fill="#14566b" font-weight="700" font-family="ui-sans-serif, system-ui">{n}</text>
            </g>
          ))}
          {survivors.slice(0, -1).map((n, i) => {
            const next = survivors[i + 1];
            return (
              <g>
                <path d={`M ${x(n)} 188 C ${x(n)} 214, ${x(next)} 214, ${x(next)} 188`} fill="none" stroke="#c96f24" stroke-width="3" />
                <text x={gapMid(n, next)} y="230" text-anchor="middle" font-size="15" fill="#9a4f13" font-weight="700" font-family="ui-sans-serif, system-ui">{gaps[i]}</text>
              </g>
            );
          })}
          <path d={`M ${x(29)} 42 C ${x(29)} 18, ${x(1)} 18, ${x(1)} 42`} fill="none" stroke="#c96f24" stroke-width="3" />
          <text x="400" y="26" text-anchor="middle" font-size="15" fill="#9a4f13" font-weight="700" font-family="ui-sans-serif, system-ui">2</text>
          <text x="400" y="252" text-anchor="middle" font-size="13" fill="#5f6f80" font-family="ui-sans-serif, system-ui">
            les gaps sont produits par les positions persistantes
          </text>
        </svg>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-4 mb-12">
      <div class="pt-card">
        <span class="pt-tag pt-tag-thm">exact</span>
        <h3 class="font-sans font-semibold text-thmblue text-xl mt-3 mb-2">Gaps du crible</h3>
        <p class="text-sm text-slate-700">
          Les résidus copremiers d’un primoriel donnent une suite circulaire de
          survivants ; leurs différences donnent les gaps du crible.
        </p>
      </div>
      <div class="pt-card">
        <span class="pt-tag pt-tag-thm">exact</span>
        <h3 class="font-sans font-semibold text-thmblue text-xl mt-3 mb-2">Réduction aux premiers</h3>
        <p class="text-sm text-slate-700">
          À la fenêtre {String.raw`$\sqrt{x}$`}, tout composite a déjà été éliminé. Les
          survivants restants sont donc {String.raw`$1$`} et les premiers.
        </p>
      </div>
      <div class="pt-card">
        <span class="pt-tag pt-tag-cond">ouvert</span>
        <h3 class="font-sans font-semibold text-thmblue text-xl mt-3 mb-2">Gap premier exact</h3>
        <p class="text-sm text-slate-700">
          Ce n’est pas encore une loi fermée donnant chaque
          {String.raw`$p_{n+1}-p_n$`} sans connaître les premiers. C’est une mécanique de
          réduction et de transport.
        </p>
      </div>
    </div>

    <div data-min-depth="L2" class="mb-12">
      <span class="pt-tag pt-tag-der">Standard</span>
      <h2 class="text-3xl font-bold text-thmblue mt-4 mb-4">
        Le point clé : la fenêtre racine
      </h2>
      <div class="grid lg:grid-cols-[1fr_0.9fr] gap-6 items-start">
        <div class="text-slate-700 leading-relaxed">
          <p class="mb-4">
            Soit {String.raw`$S(x;y)$`} le nombre d’entiers {String.raw`$n\le x$`} qui ne sont divisibles
            par aucun premier {String.raw`$\le y$`}. Si l’on choisit
            {String.raw`$y=\lfloor\sqrt{x}\rfloor$`}, alors un composite ne peut plus
            survivre : il possède forcément un diviseur premier
            {String.raw`$\le\sqrt{n}\le\sqrt{x}$`}.
          </p>
          <p class="mb-4">
            Les survivants sont donc exactement {String.raw`$1$`} et les premiers dans
            l’intervalle {String.raw`$(\sqrt{x},x]$`}. On obtient :
          </p>
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 font-mono text-sm text-slate-900 overflow-x-auto">
            {String.raw`$\pi(x)=S(x;\lfloor\sqrt{x}\rfloor)+\pi(\lfloor\sqrt{x}\rfloor)-1$`}
          </div>
          <p class="mt-4">
            Cette formule change le problème : comprendre la distribution des
            premiers revient à comprendre une loi de survivance à fenêtre finie.
          </p>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-lg p-5">
          <h3 class="font-sans font-semibold text-thmblue mb-3">Ce que la PT déplace</h3>
          <ol class="space-y-3 text-sm text-slate-700">
            <li><strong>1.</strong> D’abord construire les survivants du crible.</li>
            <li><strong>2.</strong> Lire leurs gaps comme écarts de persistance.</li>
            <li><strong>3.</strong> Descendre à la fenêtre {String.raw`$\sqrt{x}$`}.</li>
            <li><strong>4.</strong> Obtenir les premiers comme survivants ultimes.</li>
          </ol>
        </div>
      </div>
    </div>

    <div data-min-depth="L3">
      <span class="pt-tag pt-tag-val">Technique</span>
      <h2 class="text-3xl font-bold text-thmblue mt-4 mb-4">
        Formules de la mécanique
      </h2>
      <div class="grid md:grid-cols-2 gap-4">
        {propositions.map((item) => (
          <div class="bg-white border border-slate-200 rounded-lg p-5">
            <div class="flex items-center justify-between gap-3 mb-3">
              <h3 class="font-sans font-semibold text-thmblue">{item.title}</h3>
              <span class={`pt-tag ${item.tag === 'exact' ? 'pt-tag-thm' : 'pt-tag-cond'}`}>{item.tag}</span>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-md px-3 py-3 font-mono text-sm text-slate-900 overflow-x-auto">
              {`$${item.formula}$`}
            </div>
            <p class="mt-3 text-sm text-slate-700">{item.text}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 bg-white border border-slate-200 rounded-lg p-6">
        <h3 class="font-sans font-semibold text-thmblue text-xl mb-3">
          Le seuil cubique
        </h3>
        <p class="text-slate-700 leading-relaxed mb-4">
          Dans le transport exact, la fenêtre contractée
          {String.raw`$\lfloor x/p_a\rfloor$`} possède sa propre profondeur naturelle.
          Dès que {String.raw`$p_a^3>x$`}, cette fenêtre est déjà criblée au-delà de son
          seuil racine natif. Le terme transporté devient alors un terme de
          bord essentiellement premier.
        </p>
        <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 font-mono text-sm text-slate-900 overflow-x-auto">
          {String.raw`$x^{1/3}<p\le x^{1/2}$`} : bande naturelle de distorsion fenêtre/bord.
        </div>
      </div>

      <div class="mt-8 grid md:grid-cols-2 gap-4">
        <div class="pt-card">
          <h3 class="font-sans font-semibold text-thmblue mb-2">Ce qui est fermé</h3>
          <p class="text-sm text-slate-700">
            Densité de tore fini, identité de reconstruction de {String.raw`$\pi(x)$`},
            transport exact des survivants, seuil cubique d’oversieve.
          </p>
        </div>
        <div class="pt-card">
          <h3 class="font-sans font-semibold text-thmblue mb-2">Ce qui reste ouvert</h3>
          <p class="text-sm text-slate-700">
            Fermer indépendamment la loi de fenêtre, contrôler les canaux de
            correction, puis seulement viser une loi générative complète des
            gaps premiers.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
