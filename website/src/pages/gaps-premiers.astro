        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm bg-white border border-slate-200 rounded-lg">
            <thead class="bg-slate-50">
              <tr>
                <th class="text-left px-4 py-3">Shell</th>
                <th class="text-center px-4 py-3">Seuil AT</th>
