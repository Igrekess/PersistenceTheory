---
import BaseLayout from '@layouts/BaseLayout.astro';
import DashboardHero from '@components/DashboardHero.astro';
import ObservablesTable from '@components/ObservablesTable.astro';
import observables from '@/data/observables.json';

const errors = observables.map((o) => o.error_pct);
const nonStructural = observables.filter((o) => !o.sc && !o.exact);
const nonStructuralErrors = nonStructural.map((o) => o.error_pct);
const mean = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length;
const median = (values: number[]) => {
  const sorted = [...values].sort((a, b) => a - b);
  const mid = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
};
const pctFr = (value: number, digits = 3) => value.toFixed(digits).replace('.', ',');
const under05 = observables.filter((o) => o.error_pct < 0.5).length;

const errBuckets = [
  { label: '< 0,01 %', count: observables.filter((o) => o.error_pct < 0.01).length, color: '#1e6f47' },
  { label: '0,01–0,1 %', count: observables.filter((o) => o.error_pct >= 0.01 && o.error_pct < 0.1).length, color: '#2c8959' },
  { label: '0,1–0,5 %', count: observables.filter((o) => o.error_pct >= 0.1 && o.error_pct < 0.5).length, color: '#7da64a' },
  { label: '0,5–1 %', count: observables.filter((o) => o.error_pct >= 0.5 && o.error_pct < 1).length, color: '#c9a64a' },
  { label: '1–2 %', count: observables.filter((o) => o.error_pct >= 1 && o.error_pct < 2).length, color: '#c96f24' },
  { label: '> 2 %', count: observables.filter((o) => o.error_pct >= 2).length, color: '#a83232' },
];
const maxCount = Math.max(...errBuckets.map((b) => b.count));

const sectors = [
  { label: 'Jauge', count: 4, examples: ['1/α_EM', 'α_s', 'sin²θ_W', 'sin²θ_eff'] },
  { label: 'Leptons', count: 5, examples: ['m_e', 'm_μ', 'm_τ', 'Q_Koide', 'C_Koide'] },
  { label: 'Quarks', count: 6, examples: ['m_u', 'm_d', 'm_s', 'm_c', 'm_b', 'm_t'] },
  { label: 'Bosons', count: 4, examples: ['m_W', 'm_Z', 'm_H', 'λ_H'] },
  { label: 'CKM', count: 4, examples: ['V_us', 'V_cb', 'V_ub', 'δ_CP'] },
  { label: 'PMNS', count: 4, examples: ['sin²θ_12', 'sin²θ_13', 'sin²θ_23', 'δ_CP'] },
  { label: 'Neutrinos', count: 3, examples: ['m_ν₃', 'Δm²_31', 'Δm²_21'] },
  { label: 'QCD', count: 3, examples: ['σ_QCD', 'f_π', 'm_π'] },
  { label: 'Gravité / cosmo', count: 6, examples: ['G/α', 'H₀', 'Ω_info', 'Ω_Λ', 'n_s', 'F_echo'] },
  { label: 'Combinatoires', count: 4, examples: ['N_c', 'N_gen', 'C_F', 'D=2'] },
];

const benchmarks = [
  { label: 'Erreur moyenne', value: `${pctFr(mean(errors), 3)} %`, tone: 'thmblue' },
  { label: 'Erreur médiane', value: `${pctFr(median(errors), 3)} %`, tone: 'derorange' },
  { label: 'Observables sous 0,5 %', value: `${under05} / ${observables.length}`, tone: 'emerald' },
  { label: 'Paramètres continus ajustés', value: '0', tone: 'rose' },
  { label: 'Convention dimensionnelle', value: 'SCU', tone: 'amber' },
  { label: 'Agrégat conservateur', value: `${nonStructural.length} obs.`, tone: 'sky' },
];

const toneClasses: Record<string, string> = {
  thmblue: 'border-thmblue text-thmblue',
  derorange: 'border-derorange text-derorange',
  emerald: 'border-emerald-500 text-emerald-700',
  rose: 'border-rose-500 text-rose-700',
  amber: 'border-amber-500 text-amber-700',
  sky: 'border-sky-500 text-sky-700',
};

// Layout SVG histogramme
const chart = { left: 110, right: 720, top: 30, bottom: 220 };
const barW = 70;
const barX = (i: number) => 130 + i * 100;
const barY = (count: number) => chart.bottom - (count / maxCount) * (chart.bottom - chart.top);
---

<BaseLayout
  title="43 observables"
  description={`Les 43 observables du Modèle Standard dérivés depuis s = 1/2 et μ* = 15. Erreur moyenne ${pctFr(mean(errors), 3)} %, médiane ${pctFr(median(errors), 3)} %, zéro paramètre continu ajusté.`}
>
  <DashboardHero
    eyebrow="Vulgarisé · validation quantitative"
    title="43 observables, 0 paramètre continu ajusté"
    plain="Toutes les valeurs sont dérivées de la symétrie s = 1/2 (théorème T1), à l’attracteur physique du secteur réduit μ* = 15 (T5). Aucun paramètre continu n’est ajusté."
    standard={`Sur 43 observables comparés au PDG, l’erreur moyenne est de ${pctFr(mean(errors), 3)} %, la médiane de ${pctFr(median(errors), 3)} %. L’agrégat conservateur hors auto-cohérences et entiers exacts contient ${nonStructural.length} entrées réelles indépendantes.`}
    note="SCU fixe l’unité de lecture dimensionnelle, comme c en SI, sans introduire un fit."
  />

  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14">

    <!-- TABLE COMPLETE FILTRABLE -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-val mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-3">Les 43 observables, filtrables</h2>
      <p class="text-slate-700 mb-6 max-w-3xl">
        Filtrez par secteur, recherchez par nom. Cliquez sur une ligne pour
        développer la dérivation détaillée (formule PT, chapitre monographie,
        statut épistémique).
      </p>
      <ObservablesTable lang="fr" />
    </section>

    <!-- METRIQUES CLES -->
    <section class="mb-12">
      <p class="pt-tag pt-tag-thm mb-3">Vulgarisé</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Six chiffres à retenir</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {benchmarks.map((b) => (
          <div class={`rounded-lg border-2 bg-white p-5 ${toneClasses[b.tone]}`}>
            <p class="text-xs font-sans uppercase tracking-wider text-stone-500 mb-2">{b.label}</p>
            <p class="text-3xl font-bold font-mono">{b.value}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- HISTOGRAMME ERREURS -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-id mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Comment se répartissent les 43 erreurs ?</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-sm text-stone-600 mb-4 font-sans">
          Distribution des écarts |PT − PDG| / PDG sur les 43 observables.
        </p>
        <svg viewBox="0 0 760 280" class="w-full h-auto" role="img" aria-label="Histogramme distribution erreurs 43 observables">
          <rect x="0" y="0" width="760" height="280" rx="8" fill="#ffffff" />
          {[0, 4, 8, 12, 16].map((tick) => (
            <g>
              <line x1={chart.left} x2={chart.right} y1={barY(tick)} y2={barY(tick)} stroke="#e2e8f0" />
              <text x="80" y={barY(tick) + 4} font-size="11" fill="#5f6f80" font-family="ui-sans-serif, system-ui" text-anchor="end">{tick}</text>
            </g>
          ))}
          <text x="80" y="20" font-size="11" fill="#5f6f80" font-family="ui-sans-serif, system-ui" text-anchor="end">obs</text>
          {errBuckets.map((bucket, i) => {
            const x = barX(i);
            const yTop = barY(bucket.count);
            return (
              <g>
                <rect x={x} y={yTop} width={barW} height={chart.bottom - yTop} fill={bucket.color} rx="4" />
                <text x={x + barW / 2} y={yTop - 8} text-anchor="middle" font-size="13" font-weight="700" fill="#17202a" font-family="ui-sans-serif, system-ui">{bucket.count}</text>
                <text x={x + barW / 2} y={chart.bottom + 18} text-anchor="middle" font-size="11" fill="#17202a" font-weight="600" font-family="ui-sans-serif, system-ui">{bucket.label}</text>
              </g>
            );
          })}
          <text x="380" y="265" text-anchor="middle" font-size="12" fill="#5f6f80" font-family="ui-sans-serif, system-ui">
            {under05} observables sur {observables.length} sous 0,5 % d’erreur
          </text>
        </svg>
      </div>
    </section>

    <!-- COMPOSITION PAR SECTEUR -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-der mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Quels secteurs du Modèle Standard sont couverts ?</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {sectors.map((sec) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-baseline justify-between mb-3">
              <h3 class="font-sans font-semibold text-thmblue text-lg">{sec.label}</h3>
              <span class="font-mono text-2xl font-bold text-derorange">{sec.count}</span>
            </div>
            <p class="text-xs font-sans text-stone-500 uppercase tracking-wider mb-1">Exemples</p>
            <p class="text-sm text-slate-700 font-mono">{sec.examples.join(', ')}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- STATUT EPISTEMIQUE -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-thm mb-3">Standard · statut épistémique</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Une distinction importante</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-lg border border-emerald-300 bg-emerald-50 p-5">
          <h3 class="font-sans font-semibold text-emerald-800 text-lg mb-2">4 auto-cohérences (SC)</h3>
          <p class="text-sm text-emerald-900 leading-relaxed">
            Q_Koide = 2/3, N_c = 3, N_gen = 3, m_e = 1/2 (SCU). Ces valeurs
            ne sont <strong>pas des prédictions</strong> au sens strict :
            elles sont des contraintes d’auto-cohérence interne au crible.
          </p>
        </div>
        <div class="rounded-lg border border-blue-300 bg-blue-50 p-5">
          <h3 class="font-sans font-semibold text-blue-800 text-lg mb-2">2 valeurs entières exactes</h3>
          <p class="text-sm text-blue-900 leading-relaxed">
            N_c = 3 (combinatoire mod 3) et N_gen = 3 (Catalan : 3² − 2³ = 1).
            Pas d’erreur attendue ni mesurable.
          </p>
        </div>
        <div class="rounded-lg border border-orange-300 bg-orange-50 p-5">
          <h3 class="font-sans font-semibold text-orange-800 text-lg mb-2">{nonStructural.length} entrées indépendantes</h3>
          <p class="text-sm text-orange-900 leading-relaxed">
            <strong>Erreur moyenne {pctFr(mean(nonStructuralErrors), 3)} %, médiane {pctFr(median(nonStructuralErrors), 3)} %.</strong>
            Ce bloc exclut les auto-cohérences SC et les entiers exacts. Les entrées
            restent dérivées sans paramètre continu ajusté, puis confrontées à la mesure.
          </p>
        </div>
      </div>
    </section>

    <!-- LECTURE TECHNIQUE -->
    <section class="mb-12" data-min-depth="L3">
      <p class="pt-tag pt-tag-val mb-3">Technique</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Comment lire les agrégats</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue text-lg mb-2">Erreur moyenne</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            La moyenne est calculée sur les écarts relatifs absolus
            <span class="font-mono">|PT − exp| / exp</span>. Elle est sensible
            aux quelques observables les plus éloignées.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue text-lg mb-2">Médiane</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            La médiane donne le cas typique : la moitié des observables est
            plus proche, l’autre moitié plus éloignée. Elle résiste mieux aux
            valeurs extrêmes.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue text-lg mb-2">Agrégat conservateur</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Les auto-cohérences SC et les entiers exacts sont séparés des
            entrées réelles indépendantes afin de ne pas gonfler artificiellement
            le score global.
          </p>
        </div>
      </div>
    </section>

    <!-- LIENS -->
    <section class="mb-8">
      <p class="pt-tag pt-tag-bridge mb-3">Aller plus loin</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Pour vérifier soi-même</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/scripts" class="pt-card block group">
          <span class="pt-tag pt-tag-val">Reproductibilité</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Lancer les scripts en navigateur</h3>
          <p class="text-sm text-slate-700">Pyodide WASM exécute les vérifications T5, T6, α_EM, lemmes E/F/G en direct.</p>
        </a>
        <a href="/calculator" class="pt-card block group">
          <span class="pt-tag pt-tag-val">Manipulation</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Calculatrice α_EM, γ_p, sin²θ_p</h3>
          <p class="text-sm text-slate-700">Trois calculettes interactives pour voir les formules à l’œuvre.</p>
        </a>
        <a href="/predictions" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">Prédictions</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">28 prédictions Tier-1 falsifiables</h3>
          <p class="text-sm text-slate-700">Au-delà des 43 reproductions : ce que PT prédit pour DUNE, JUNO, Euclid.</p>
        </a>
        <a href="/monograph" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Source canonique</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Annexe A de la monographie</h3>
          <p class="text-sm text-slate-700">Table complète des 43 observables avec dérivation chapitre par chapitre.</p>
        </a>
        <a href="/statuts-resultats" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Méthodologie</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Statuts épistémiques</h3>
          <p class="text-sm text-slate-700">THM, ID, BRIDGE, DER, VAL, PRED — comprendre ce que veut dire chaque tag.</p>
        </a>
        <a href="/difficile-a-rejeter" class="pt-card block group">
          <span class="pt-tag pt-tag-bridge">Robustesse</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Pourquoi ce score est dur à rejeter</h3>
          <p class="text-sm text-slate-700">5 critères : zéro paramètre libre, tests d’ablation, statuts explicites.</p>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
