---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Tag from '@components/Tag.astro';

const all = (await getCollection('theorems_fr'))
  .sort((a, b) => a.data.order - b.data.order);
const fundamentals = all.filter(t => t.data.tier === 'fundamental');
const secondaries = all.filter(t => t.data.tier === 'secondary');
---

<BaseLayout title="Théorèmes">
  <PageHero
    width="medium"
    eyebrow="Théorèmes"
    domain="math"
    title="Théorèmes"
    dek="Les résultats centraux de la Théorie de la Persistance, en deux niveaux : les fondamentaux (GFT, puis la chaîne T₀ → T₆ et L0) qui ferment la dérivation à μ* = 15, et les secondaires (naturalité, ponts, identifications) qui élargissent et resserrent l’édifice."
  />

  <section class="max-w-4xl mx-auto px-4 py-12">
    <h2 class="text-xl font-sans font-semibold text-thmblue mt-4 mb-3">Théorèmes fondamentaux</h2>
    <p class="text-sm text-stone-600 mb-4">
      Neuf résultats. GFT donne le principe fondamental : capacité =
      persistance + entropie. T0 ferme ensuite la base axiomatique BA0, L0
      donne le lemme d’unicité, puis T1–T6 ferment la chaîne arithmétique à
      $\mu^* = 15$.
    </p>
    <div class="grid md:grid-cols-2 gap-4">
      {fundamentals.map(thm => (
        <a href={`/theorems/${thm.data.id}`} class="pt-card block group">
          <div class="flex items-start justify-between gap-3 mb-2">
            <h3 class="font-sans font-semibold text-lg text-thmblue group-hover:underline">
              {thm.data.name}
            </h3>
            <Tag level={thm.data.status} />
          </div>
          <p class="text-sm text-stone-700">{thm.data.short}</p>
        </a>
      ))}
    </div>

    {secondaries.length > 0 && (
      <>
        <h2 class="text-xl font-sans font-semibold text-thmblue mt-12 mb-3">Théorèmes secondaires</h2>
        <p class="text-sm text-stone-600 mb-4">
          Naturalité du crible (N1–N4), axiomes de pont dérivés (BA5),
          lemmes d’identification (E, F, G), et résultats structurels associés.
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          {secondaries.map(thm => (
            <a href={`/theorems/${thm.data.id}`} class="pt-card block group">
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="font-sans font-semibold text-lg text-thmblue group-hover:underline">
                  {thm.data.name}
                </h3>
                <Tag level={thm.data.status} />
              </div>
              <p class="text-sm text-stone-700">{thm.data.short}</p>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>
