---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';

const principles = [
  {
    n: 1,
    title: 'Cascade séquentielle',
    short: 'Le crible filtre dans l’ORDRE : p = 3 → p = 5 → p = 7. Chaque filtre voit les survivants du précédent.',
    detail: 'Le tree-level α_EM = ∏ sin²(θ_p) est CRT-orthogonal donc l’ordre n’y compte pas. Mais les corrections d’habillage SONT séquentielles. CKM est une cascade explicite : V_us → V_cb → V_ub (puissances de λ).',
    example: 'CKM : V_us = λ, V_cb = A·λ², V_ub = A·λ³·R',
    color: 'thmblue',
  },
  {
    n: 2,
    title: 'Cap Shannon (D_KL ≤ 1 par canal)',
    short: 'Chaque canal CRT transporte AU PLUS 1 unité d’information. sin²θ_p < 1 pour tout p.',
    detail: 'Le cap est AUTOMATIQUE pour les quantités PT. La resommation G_Fisher/cos²θ_3 = 5,12 est la somme sur TOUS les ordres du même canal (throughput total, pas instantané).',
    example: 'C_K^arbre = 4/sin²θ_3, NLO = 1/(p₁p₃)',
    color: 'sky',
  },
  {
    n: 3,
    title: 'Pythagore = CRT orthogonal',
    short: 'Les canaux sur des cercles CRT DIFFÉRENTS se combinent par Pythagore.',
    detail: 'sin²θ_W = γ_7² / (γ_3² + γ_5² + γ_7²) = norme pythagorienne. En chimie : E² = E_cov² + E_ion². Même branche/même rôle : addition directe (V_us = sin²_3 + sin²_5 sur q⁻).',
    example: 'sin²θ_W = 0,2377 (tree-level), 0,23119 (corrigé)',
    color: 'emerald',
  },
  {
    n: 4,
    title: 'Bifurcation 3 régimes',
    short: 'La bifurcation q⁺/q⁻ donne 3 régimes, pas 2.',
    detail: 'Régime 1 (couplage fort, EA/IE ≥ s) : transfert complet = confinement. Régime 2 (couplage faible, EA/IE < s) : transmission partielle = QED. Régime 3 (endothermique, BH ≤ 0) : fluctuations quantiques = VP. Le seuil s = 1/2 est exactement le seuil γ_p > 1/2 de T5.',
    example: 'IE atomes : 3 régimes lus directement',
    color: 'amber',
  },
  {
    n: 5,
    title: 'Rotation holonomique',
    short: 'L’énergie se PROJETTE sur le référentiel du crible (Ry, m_e) par rotation holonomique.',
    detail: 'L’amplitude de rotation dépend de la couverture angulaire (hybridation en chimie, phase de Berry en physique). C’est le MÉCANISME par lequel D_KL se convertit en observable. En chimie : IE se projette sur Ry via cos²θ_3 · (Ry − IE). En physique : masses = rotations holonomiques autour de m_e.',
    example: 'Intégrale de Berry 3π = N_gen · π fixe les rapports m_μ/m_e',
    color: 'violet',
  },
  {
    n: 6,
    title: 'Resommation géométrique',
    short: 'Le couplage effectif pour les fluctuations est G_Fisher/cos²θ_3 = 5,12.',
    detail: 'Resommation de TOUS les ordres de perturbation sur le canal p = 3 : G_Fisher · Σ sin²₃ⁿ = 4/(1−sin²₃) = 4/cos²₃. En physique, cela correspond au running coupling. Le rapport C_Koide / (G_Fisher/cos²₃) = cos²₃/sin²₃ = cot²θ_3 relie les deux branches.',
    example: 'Identité Fisher-Koide : C_K = 4/sin²₃ + (1+5δ₃²/18)/21',
    color: 'rose',
  },
  {
    n: 7,
    title: 'Anti-double-comptage (GFT)',
    short: 'log_2(m) = D_KL + H est une IDENTITÉ. Pas d’énergie ajoutable déjà comptée dans D_KL.',
    detail: 'La bifurcation q⁺/q⁻ est une PARTITION : sin²(q⁺) et sin²(q⁻) mesurent des projections orthogonales du même premier. Pas de double-comptage. Tout coefficient PT respecte cette identité algébrique.',
    example: 'Ω_info + Ω_Λ + Ω_baryon = 1 (Clausius split)',
    color: 'slate',
  },
];

const colorClasses: Record<string, string> = {
  thmblue: 'border-thmblue bg-blue-50',
  sky: 'border-sky-400 bg-sky-50',
  emerald: 'border-emerald-400 bg-emerald-50',
  amber: 'border-amber-400 bg-amber-50',
  violet: 'border-violet-400 bg-violet-50',
  rose: 'border-rose-400 bg-rose-50',
  slate: 'border-slate-400 bg-slate-50',
};
---

<BaseLayout
  title="Sept principes architecturaux"
  description="Les 7 principes architecturaux découverts en PTCS v0.6 (mars 2026). Propriétés émergentes du crible à μ* = 15, applicables de la chimie moléculaire à la physique des particules."
>
  <PageHero
    eyebrow="Méta-théorie"
    domain="meta"
    title="Les 7 principes architecturaux de la PT"
    kicker="Pas des règles imposées. Des propriétés émergentes du crible."
    dekL1="Quand on tente d’appliquer la PT à un domaine nouveau (chimie moléculaire, biologie, géophysique), on observe que les mêmes structures réapparaissent. Pas par convention : par nécessité architecturale. Ces sept principes ont été identifiés en mars 2026 lors du développement de PTCS v0.6 (chimie computationnelle), puis vérifiés sur les autres domaines."
    dekL2="Chaque principe est une propriété émergente du crible à $\mu^* = 15$, donc une conséquence de T5 et T6. Aucun n’est postulé. Leur force vient de leur universalité : ils s’appliquent aussi bien à $\alpha_{\rm EM}$ qu’à la liaison chimique d’une molécule diatomique."
  />

  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14">

    <!-- LES 7 PRINCIPES -->
    <section class="mb-12">
      <p class="pt-tag pt-tag-thm mb-3">Les sept</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Sept patterns universels</h2>
      <div class="space-y-5">
        {principles.map((p) => (
          <div class={`rounded-lg border-2 p-6 ${colorClasses[p.color]}`}>
            <div class="flex items-start gap-5">
              <span class="flex-shrink-0 w-14 h-14 rounded-full bg-white border-2 border-current font-mono text-3xl font-bold flex items-center justify-center">{p.n}</span>
              <div class="flex-1">
                <h3 class="font-sans text-2xl font-bold mb-2">{p.title}</h3>
                <p class="text-slate-800 font-semibold leading-relaxed mb-3">{p.short}</p>
                <p class="text-slate-700 leading-relaxed mb-3 text-sm">{p.detail}</p>
                <p class="text-xs font-mono bg-white/60 border border-current/30 rounded px-3 py-2 inline-block">
                  <strong>Ex :</strong> {p.example}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- POURQUOI 7 -->
    <section class="mb-12">
      <p class="pt-tag pt-tag-id mb-3">Question naturelle</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Pourquoi sept ?</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-slate-700 leading-relaxed mb-4">
          On peut avoir l’impression que le nombre 7 est lui-même choisi.
          Ce n’est pas le cas. Les principes 1–3 (cascade, cap Shannon, Pythagore)
          décrivent l’<strong>enchaînement</strong> des canaux ; les principes 4–6
          (bifurcation, rotation, resommation) décrivent les <strong>régimes</strong> où
          chaque canal opère ; le principe 7 (anti-double-comptage) est la
          <strong>contrainte de cohérence</strong> qui les lie tous.
        </p>
        <p class="text-slate-700 leading-relaxed mb-4">
          Trois enchaînements + trois régimes + une cohérence = 7.
          Et c’est précisément la même structure $3 + 3 + 1$ que la cascade
          principale : trois primaires actifs {`$\\{3, 5, 7\\}$`} + trois corrections
          d’habillage + une cohérence GFT.
        </p>
        <p class="text-slate-700 leading-relaxed">
          Pas une coïncidence : les principes architecturaux <strong>sont</strong> la
          cascade, lue à un méta-niveau. C’est ce qui les rend universels.
        </p>
      </div>
    </section>

    <!-- DOMAINES OU LES 7 SONT VERIFIES -->
    <section class="mb-12">
      <p class="pt-tag pt-tag-val mb-3">Universalité testée</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Où ces principes ont été vérifiés</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue mb-2">Chimie quantique (PTCS)</h3>
          <p class="text-sm text-slate-700">IE Z = 1–118 à 0,06 % MAE, EA 0,98 %, périodes exactes. Origine empirique des 7 principes.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue mb-2">Physique des particules</h3>
          <p class="text-sm text-slate-700">43 observables Modèle Standard, 0,316 % MAE, aucun paramètre continu ajusté. Toutes les corrections vérifient les 7 principes.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue mb-2">Cosmologie</h3>
          <p class="text-sm text-slate-700">H₀, n_s, Ω_info, F_echo à &lt; 0,2 % d’écart Planck. Bifurcation q⁺/q⁻ → secteur sombre.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue mb-2">Nucléaire</h3>
          <p class="text-sm text-slate-700">408/413 PASS, nombres magiques 2, 8, 20, 28, 50, 82, 126 dérivés. Résommation et bifurcation actives.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue mb-2">Biologie (PT_PROTEIN)</h3>
          <p class="text-sm text-slate-700">Bifurcation q⁺/q⁻ universelle sur 3 biopolymères ; tore Ramachandran 15/15 ; ARN cos_therm à 90 ppm.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue mb-2">Perception (SieveColorSpace)</h3>
          <p class="text-sm text-slate-700">3 canaux opposants forcés par {`{3, 5, 7}`} ; poids L-M = γ_3/Σγ_p (PT 0,385 vs mesure 0,373) ; métrique pythagorienne par CRT.</p>
        </div>
      </div>
    </section>

    <!-- LIENS -->
    <section class="mb-8">
      <p class="pt-tag pt-tag-bridge mb-3">Aller plus loin</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Approfondir</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/theorems/T5" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">T5</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Point fixe μ* = 15</h3>
          <p class="text-sm text-slate-700">D’où viennent les principes : c’est le point fixe qui les force.</p>
        </a>
        <a href="/theorems/T6" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">T6</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Identité d’holonomie</h3>
          <p class="text-sm text-slate-700">Le mécanisme géométrique par lequel les principes opèrent.</p>
        </a>
        <a href="/theorems/FisherKoide" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">Identité Fisher-Koide</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Resommation à l’œuvre</h3>
          <p class="text-sm text-slate-700">Application précise du principe 6 : C_K = 18,300 à 0,04 ppm.</p>
        </a>
        <a href="/essays/principes-pt" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Essai standard</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">11 principes méthodologiques</h3>
          <p class="text-sm text-slate-700">Côté méthodologique : ce qui empêche le sur-ajustement.</p>
        </a>
        <a href="/essays/bifurcation-q-plus-q-minus" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Essai vulgarisé</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">La bifurcation q⁺/q⁻</h3>
          <p class="text-sm text-slate-700">Application précise du principe 4 : 3 régimes, pas 2.</p>
        </a>
        <a href="/observables" class="pt-card block group">
          <span class="pt-tag pt-tag-val">Validation</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">43 observables</h3>
          <p class="text-sm text-slate-700">Les 7 principes sont les patterns derrière chaque observable dérivé.</p>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
