---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import SubProjects from '@components/SubProjects.astro';
import Citation from '@components/Citation.astro';

const primaryLinks = [
  { href: '/essays/idea-5min', label: 'L’idée en 5 minutes', tone: 'primary' as const },
  { href: '/commencer-ici', label: 'Commencer ici', tone: 'outline' as const },
  { href: '/premier-principe', label: 'Principe fondamental', tone: 'outline' as const },
  { href: '/resultats', label: 'Dashboard résultats', tone: 'soft' as const },
  { href: '/predictions', label: 'Prédictions', tone: 'soft' as const },
];

const readingPath = [
  {
    step: '01',
    title: 'Principe',
    href: '/premier-principe',
    text: 'La distinction totale se répartit entre structure persistante et dispersion entropique.',
  },
  {
    step: '02',
    title: 'Crible',
    href: '/theorems',
    text: 'Les survivants du crible donnent un laboratoire exact pour lire la contrainte.',
  },
  {
    step: '03',
    title: 'Attracteur',
    href: '/big-bang',
    text: 'Après cristallisation de 2, la cascade glisse vers l’attracteur réduit μ* = 15.',
  },
  {
    step: '04',
    title: 'Dérivations',
    href: '/observables',
    text: 'Les observables physiques et chimiques sont dérivées sans paramètre continu ajusté, avec statuts explicites.',
  },
  {
    step: '05',
    title: 'Validation',
    href: '/statuts-resultats',
    text: 'Chaque résultat reçoit un statut : théorème, pont, dérivation, validation ou prédiction.',
  },
];

const plainScenes = [
  {
    title: 'Une contrainte agit',
    text: 'La théorie commence avec une situation minimale : quelque chose est soumis à une contrainte, et cette contrainte force une séparation.',
  },
  {
    title: 'Des survivants apparaissent',
    text: 'Ce qui ne traverse pas la contrainte se disperse ; ce qui la traverse conserve une identité lisible.',
  },
  {
    title: 'La mesure devient possible',
    text: 'Les observables ne sont plus des paramètres à régler : elles mesurent la part persistante, la part dispersée et leurs modes de couplage.',
  },
  {
    title: 'Continu et discret se réconcilient',
    text: 'Relativité générale (espace-temps lisse) et mécanique quantique (niveaux discrets) semblaient incompatibles. La PT montre qu’ils sont deux propriétés du même substrat arithmétique — comme un triangle a à la fois trois sommets (discret) et trois angles (continus), sans que l’un précède l’autre. La vieille opposition se dissout.',
  },
];

const domainCards = [
  {
    href: '/theorems',
    tag: 'Mathématique',
    tagClass: 'pt-tag-thm',
    title: 'Les points de persistance',
    text: 'Survivants, gaps, GFT et théorèmes montrent comment une contrainte produit des structures stables.',
  },
  {
    href: '/big-bang',
    tag: 'Cosmogonie',
    tagClass: 'pt-tag-bridge',
    title: 'La cascade primordiale',
    text: 'La cristallisation de 2, l’émergence du temps et μ* = 15 sont présentées comme une hiérarchie instantanée.',
  },
  {
    href: '/observables',
    tag: 'Physique',
    tagClass: 'pt-tag-der',
    title: 'Le principe mis à l’épreuve',
    text: 'Couplages, masses, angles, temps et géométrie confrontent les structures persistantes aux mesures.',
  },
  {
    href: '/tableau-periodique',
    tag: 'Chimie',
    tagClass: 'pt-tag-id',
    title: 'La persistance des couches',
    text: 'La suite 2, 8, 8, 18, 18, 32, 32 devient une conséquence des canaux, spins et couches internes.',
  },
];

const auditCards = [
  {
    tag: 'L0 / GFT',
    title: 'Principe de conservation',
    text: 'La capacité informationnelle totale se répartit entre divergence KL et entropie : Hmax = DKL + H.',
  },
  {
    tag: 'T0 → T6',
    title: 'Chaîne démonstrative',
    text: 'Chaque étape doit être suivie comme un passage de statut : théorème, pont, dérivation, validation ou prédiction.',
  },
  {
    tag: 'Scripts',
    title: 'Reproductibilité',
    text: 'Les scripts compagnons vérifient les calculs emblématiques et exposent les points encore dépendants d’un pont.',
  },
];

const groupedLinks = [
  {
    title: 'Lire',
    links: [
      ['/questions-fondamentales', 'Questions fondamentales'],
      ['/limites', 'Limites'],
      ['/monograph', 'Monographie FR/EN'],
    ],
  },
  {
    title: 'Vérifier',
    links: [
      ['/predictions', 'Prédictions falsifiables'],
      ['/scripts', 'Scripts'],
      ['/preuve-interactive', 'Preuve interactive'],
      ['/lean', 'Formalisation Lean'],
      ['/difficile-a-rejeter', 'Difficile à rejeter'],
    ],
  },
  {
    title: 'Explorer',
    links: [
      ['/temps', 'Temps'],
      ['/relativite', 'Relativité'],
      ['/gravite-quantique', 'Gravité quantique'],
      ['/nucleaire', 'Nucléaire'],
      ['/cosmologie', 'Cosmologie'],
    ],
  },
  {
    title: 'Chimie',
    links: [
      ['/energies-ionisation', 'Énergies d’ionisation'],
      ['/affinites-electroniques', 'Affinités électroniques'],
      ['/demonstration-tableau-periodique', 'Démonstration tableau périodique'],
    ],
  },
];

---

<BaseLayout>
  <figure class="w-full max-w-6xl mx-auto px-4">
    <img
      src="/images/banniere.png"
      alt="Lumière filtrée par des stores, démultipliée par des miroirs sur parquet — photographie de la série De Rerum Natura, illustration des principes de filtrage et de persistance"
      class="w-full h-auto block max-h-[55vh] object-cover"
      width="1920"
      height="640"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption class="text-xs text-stone-500 mt-1 text-right italic">
      crédit photo : Yan Senez — <a href="https://www.yansenez.com" target="_blank" rel="noopener" class="hover:underline hover:text-stone-700">www.yansenez.com</a>
    </figcaption>
  </figure>

  <PageHero
    eyebrow="Simple · préimpression ouverte"
    domain="meta"
    title="La Théorie de la Persistance"
    kicker={`Quand un système traverse une contrainte,\nqu’est-ce qui se disperse — qu’est-ce qui persiste ?`}
    epigraphL1="Toute chose dit ce qu’elle est en révélant ce qu’elle n’a plus. La réalité existe dans le cône d’incertitude entre l’addition et la multiplication."
    epigraphL2="Toute chose dit ce qu’elle est (sa position additive) en révélant ce qu’elle n’a plus (sa factorisation différée — ce qui a été dispersé). La réalité existe dans le cône d’incertitude entre l’addition et la multiplication ; les premiers sont les points fixes de cette tension."
    epigraphL3={`Toute chose dit ce qu’elle est (sa position additive) en révélant ce qu’elle n’a plus (sa factorisation différée — ce qui a été dispersé). La réalité existe dans le cône d’incertitude entre la structure additive (Σ ℤ) et la structure multiplicative (Π premiers) ; le crible PT identifie les points fixes, et l’ossature {2, 3, 5, 7, 11, 13} en est la signature observable.`}
    dekL1="La théorie de la persistance (PT) part d’une idée simple : quand une contrainte agit, tout ne disparaît pas. Une part se disperse en entropie ; une autre traverse la contrainte et devient structure. Ce qui persiste n’est pas ce qui est le plus fort. C’est ce qui est le plus compatible avec la logique du filtre. La persistance n’est pas une victoire. C’est un accord. La forme n’est pas décorative : c’est la structure que la contrainte rend visible. Les observables mesurent cette distribution."
    dekL2="La théorie de la persistance (PT) part d’une idée simple : sous contrainte, une part se disperse en entropie et une autre persiste comme structure. Ce qui persiste n’est pas ce qui est le plus fort. C’est ce qui est le plus compatible avec la logique du filtre. La persistance n’est pas une victoire. C’est un accord. La forme n’est pas décorative : c’est la structure que la contrainte rend visible. Cette idée se déploie en chaîne : principe de conservation informationnelle, dynamique du crible, cristallisation de 2, glissement vers l’attracteur réduit μ* = 15, puis dérivation des observables avec statut épistémique explicite."
    oneLineNote={{ label: 'En une phrase', body: 'persister, ce n’est pas rester par inertie ; c’est survivre à une contrainte admissible sans perdre son identité structurelle.' }}
    technicalNote={{ label: 'Lecture technique', body: 'ne pas lire cette page comme une preuve globale, mais comme une carte d’audit. Les théorèmes, ponts, dérivations physiques, validations et prédictions ne portent pas le même statut.' }}
    actions={primaryLinks}
  />

  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14">

    <!-- Statut épistémique : une proposition ouverte -->
    <aside class="mb-6 rounded-lg border-l-4 border-amber-300 bg-amber-50/60 p-4 md:p-5">
      <p class="text-sm text-slate-700 leading-relaxed">
        <span class="font-sans font-semibold text-amber-900">Une proposition, pas une conclusion.</span>
        Ce que tu vas lire est <strong>une piste de recherche</strong>, soumise ouvertement à la discussion. Le cadre est cohérent,
        dérive d’un seul input (<em>s = 1/2</em>), et porte des prédictions falsifiables —
        mais c’est un travail en cours qui demande à être audité, contredit, prolongé.
        Sources publiques, code MIT, monographie en préprint : tout est ouvert.
        Si tu y trouves une faille, signale-la. Le travail n’a de valeur que s’il survit à l’épreuve.
      </p>
    </aside>

    <!-- Bande de mise en avant : formalisation Lean -->
    <a
      href="/lean"
      class="mb-8 flex flex-col md:flex-row md:items-center gap-4 rounded-lg border-2 border-thmblue/30 bg-gradient-to-r from-thmblue/5 to-thmblue/0 p-5 md:p-6 hover:border-thmblue/60 hover:shadow-md transition group"
    >
      <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 md:w-14 md:h-14 rounded-full bg-thmblue/10 border border-thmblue/20 text-thmblue text-2xl md:text-3xl font-mono font-bold">
        ✓
      </div>
      <div class="flex-1">
        <p class="pt-tag pt-tag-thm mb-1">Vérification formelle</p>
        <h2 class="font-sans font-bold text-thmblue text-lg md:text-xl mb-1 group-hover:underline">
          30 théorèmes fondationnels de PT, <em>kernel-vérifiés</em> en Lean&nbsp;4
        </h2>
        <p class="text-sm text-stone-700 leading-snug">
          Le chemin critique <span class="font-mono">T1&nbsp;→&nbsp;T3&nbsp;→&nbsp;s&nbsp;=&nbsp;½&nbsp;→&nbsp;T2&nbsp;→&nbsp;L0&nbsp;→&nbsp;T7&nbsp;→&nbsp;W7-1</span>
          est formellement vérifié par le noyau Lean, sans aucun <code>sorry</code>,
          pour un total de 187 modules (30 théorèmes du chemin critique dans 8 modules + 179 secondaires) et ~2 850 déclarations formelles.
          <span class="text-thmblue font-medium">Voir la formalisation →</span>
        </p>
      </div>
    </a>

    <!-- Notice profondeurs -->
    <aside class="mb-10 rounded-lg border border-thmblue/20 bg-thmblue/5 p-4 md:p-5">
      <p class="text-sm text-slate-700 leading-relaxed">
        <span class="font-sans font-semibold text-thmblue">Trois niveaux de lecture.</span>
        Le site existe en trois profondeurs —
        <strong>Simple</strong> (introduction accessible),
        <strong>Standard</strong> (l’enchaînement principal),
        <strong>Technique</strong> (sources, dérivations, équations).
        Le sélecteur en bas à droite ↘ permet de basculer à tout moment ;
        certaines sections n’apparaissent qu’à partir d’un niveau donné.
      </p>
    </aside>

    <section class="mb-12">
      <p class="pt-tag pt-tag-id mb-3">Simple</p>
      <h2 class="text-3xl md:text-4xl font-bold text-thmblue mb-6">
        L’idée en quatre scènes
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {plainScenes.map((scene, index) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="font-mono text-sm text-derorange">0{index + 1}</span>
            <h3 class="mt-2 mb-2 font-sans text-xl font-bold text-thmblue">{scene.title}</h3>
            <p class="text-sm text-slate-700 leading-relaxed">{scene.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12" data-min-depth="L2">
      <div class="max-w-3xl mb-6">
        <p class="pt-tag pt-tag-thm mb-3">Standard</p>
        <h2 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">
          Lire la théorie comme une chaîne, pas comme un catalogue
        </h2>
        <p class="text-slate-700 leading-relaxed">
          L’ordre compte : principe de conservation informationnelle, dynamique
          du crible, sélection de l’attracteur, dérivations numériques, puis
          audit des statuts. C’est ce fil qui évite de confondre intuition,
          théorème, pont physique et validation.
        </p>
      </div>
      <div class="grid md:grid-cols-5 gap-3">
        {readingPath.map((item) => (
          <a href={item.href} class="group rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:border-thmblue/40 hover:shadow-md transition">
            <span class="text-sm font-mono text-derorange">{item.step}</span>
            <h3 class="mt-2 mb-2 font-sans text-lg font-bold text-thmblue group-hover:underline">
              {item.title}
            </h3>
            <p class="text-sm text-slate-700 leading-relaxed">{item.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="grid lg:grid-cols-[0.92fr_1.08fr] gap-8 items-start mb-12" data-min-depth="L2">
      <div>
        <p class="pt-tag pt-tag-id mb-3">Standard</p>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          Une même contrainte, plusieurs registres
        </h2>
        <p class="text-slate-700 leading-relaxed mb-4">
          En mathématiques, la persistance se lit dans le crible
          d’Ératosthène : les nombres premiers sont les survivants
          irréductibles du couplage additif-multiplicatif, où la contrainte
          multiplicative élimine les composés tandis que la progression additive
          révèle la trace dynamique des survivants à travers les écarts entre
          premiers.
        </p>
        <p class="text-slate-700 leading-relaxed mb-4">
          En PT, un premier est aussi un point discret de résonance du crible :
          il indexe un mode de persistance. La phase cyclique associée à ce
          premier donne une amplitude ; comparée au seuil de persistance, cette
          amplitude fixe son statut : frontière, actif, écho ou super-écho.
        </p>
        <p class="text-slate-700 leading-relaxed">
          En physique et en chimie, la question devient plus risquée : les
          structures persistantes suffisent-elles à reconstruire constantes,
          masses, géométrie, couches, énergies d’ionisation et affinités
          électroniques ? Le site sépare les résultats démontrés, dérivés,
          validés et encore ouverts.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {domainCards.map((card) => (
          <a href={card.href} class="pt-card block group">
            <span class:list={['pt-tag', card.tagClass]}>{card.tag}</span>
            <h3 class="font-sans font-semibold text-thmblue text-xl mt-3 mb-2 group-hover:underline">
              {card.title}
            </h3>
            <p class="text-sm text-stone-700 leading-relaxed">{card.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section data-min-depth="L3" class="mb-12">
      <p class="pt-tag pt-tag-val mb-3">Technique</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">Premières prises d’audit</h2>
      <p class="text-slate-700 leading-relaxed mb-5 max-w-3xl">
        Le niveau technique de l’index expose les objets à contrôler avant de
        juger la théorie : conservation informationnelle, chaîne T0 → T6,
        statut des ponts et reproductibilité numérique.
      </p>
      <div class="grid md:grid-cols-3 gap-4 mb-5">
        {auditCards.map((card) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="pt-tag pt-tag-val">{card.tag}</span>
            <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2">{card.title}</h3>
            <p class="text-sm text-slate-700 leading-relaxed">{card.text}</p>
          </div>
        ))}
      </div>
      <div class="bg-stone-50 border border-stone-300 rounded-lg p-5 text-sm">
        <p class="text-xs font-sans text-stone-500 uppercase tracking-wider mb-2">Note technique</p>
        <p class="text-stone-700 leading-relaxed">
          Le cadre formel comprend des ponts de base (BA0–BA2) qui identifient
          le champ dynamique aux écarts entre premiers consécutifs, puis des ponts dérivés
          (BA3–BA5) promus ou contraints dans la chaîne, une cascade de
          sept théorèmes (T0 → T6) qui dérivent les angles d’holonomie
          sin²(θ_p) = δ_p(2 − δ_p) et les dimensions anomales γ_p, et le théorème
          T5 qui établit l’attracteur réduit μ* = 15 par exhaustion rationnelle exacte.
          L’identité log₂(m) = D_KL(P‖U_m) + H(P) (GFT) est le
          <strong>principe fondamental de la persistance</strong> : la capacité
          informationnelle totale se conserve et se répartit exactement entre
          persistance et entropie.
        </p>
      </div>
    </section>

    <section class="grid md:grid-cols-4 gap-4 mb-12" data-min-depth="L2">
      {groupedLinks.map((group) => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <h2 class="font-sans font-bold text-thmblue mb-3">{group.title}</h2>
          <div class="space-y-2">
            {group.links.map(([href, label]) => (
              <a href={href} class="block text-sm text-slate-700 hover:text-thmblue hover:underline">
                {label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 text-sm mb-10" data-min-depth="L2">
      <div class="pt-card">
        <span class="pt-tag pt-tag-thm">Théorèmes</span>
        <p class="mt-2 text-stone-700">
          T0 → T6, GFT, L0 — chaîne complète, drift nul entre les versions.
        </p>
      </div>
      <div class="pt-card">
        <span class="pt-tag pt-tag-der">Dérivations</span>
        <p class="mt-2 text-stone-700">
          43 observables, écart moyen 0,30 %, médiane 0,06 %, zéro ajustement.
        </p>
      </div>
      <div class="pt-card">
        <span class="pt-tag pt-tag-val">Vérification</span>
        <p class="mt-2 text-stone-700">
          Registre canonique : 45 entrées de scripts compagnons, 2 522/2 523 contrôles passants — scripts emblématiques exécutables en navigateur.
        </p>
      </div>
      <a
        href="/lean"
        class="pt-card block group hover:border-thmblue/40 hover:shadow-md transition"
      >
        <span class="pt-tag pt-tag-thm">Formalisation Lean</span>
        <p class="mt-2 text-stone-700">
          30 théorèmes fondationnels du chemin critique T1 → T7 → W7-1 <em>kernel-vérifiés</em> en Lean 4 + Mathlib (incluant W7-1 dans ses deux directions), plus 179 modules secondaires (187 modules au total). <span class="group-hover:underline text-thmblue">Voir la page dédiée →</span>
        </p>
      </a>
    </div>

    <SubProjects lang="fr" />

    <Citation lang="fr" />

    <aside class="mt-12 pt-6 border-t border-stone-200 max-w-3xl text-xs text-stone-500 leading-relaxed">
      <p class="font-sans font-semibold text-stone-600 mb-1">Pourquoi cette photo en bannière ?</p>
      <p>
        Une lumière continue traverse des stores et se résout en bandes discrètes — c'est un tamis.
        Plusieurs miroirs reçoivent ces bandes et les démultiplient en versions partielles : chaque
        miroir est un filtre qui sélectionne, transforme, conserve. Et quelques miroirs se reflètent
        entre eux — la scène contient sa propre image. C'est ce que la PT décrit, en arithmétique :
        du continu se résout en discret, des motifs persistent sous filtrage, et au sommet de la
        hiérarchie le filtre devient capable de se modéliser lui-même. Photo issue de la série
        <em>De Rerum Natura</em>.
      </p>
    </aside>

    <p class="mt-8 text-sm text-stone-500 italic font-sans">
      Préimpression — non révisée par les pairs. Toute critique scrupuleuse est bienvenue.
    </p>
  </main>
</BaseLayout>
