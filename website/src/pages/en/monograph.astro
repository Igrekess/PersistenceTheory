---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Monograph">
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-4">Monograph</h1>
    <p class="text-stone-700 mb-6">
      <em>The Theory of Persistence — From the Sieve to the Standard Model</em>,
      yan senez, 2026. English edition: 885 pages; French edition:
      913 pages, ~40 MB each.
    </p>

    <div class="flex flex-wrap gap-3 mb-8">
      <a
        href="https://github.com/Igrekess/PersistenceTheory/raw/main/TheTheoryOfPersistence.pdf"
        class="px-5 py-3 bg-thmblue text-white font-sans font-semibold rounded hover:bg-thmblue/90"
      >
        Download English edition
      </a>
      <a
        href="https://github.com/Igrekess/PersistenceTheory/raw/main/TheorieDeLaPersistance_FR.pdf"
        class="px-5 py-3 bg-thmblue text-white font-sans font-semibold rounded hover:bg-thmblue/90"
      >
        Download French edition
      </a>
      <a
        href="https://github.com/Igrekess/PersistenceTheory"
        class="px-5 py-3 bg-white border border-stone-300 text-stone-800 font-sans font-semibold rounded hover:bg-stone-50"
      >
        GitHub repo
      </a>
    </div>

    <h2 class="text-xl font-semibold text-thmblue mt-8 mb-3 font-sans">Online reading</h2>
    <p class="text-stone-700 mb-3 text-sm">
      The PDF loads below from GitHub (~40 MB).
      If the preview is slow, download the file instead.
    </p>

    <div class="border border-stone-300 rounded overflow-hidden bg-stone-100" style="height: 80vh;">
      <iframe
        src="https://github.com/Igrekess/PersistenceTheory/raw/main/TheTheoryOfPersistence.pdf"
        title="The Theory of Persistence — English edition"
        class="w-full h-full"
        loading="lazy"
      ></iframe>
    </div>

    <h2 class="text-xl font-semibold text-thmblue mt-12 mb-3 font-sans">Editorial status</h2>
    <ul class="list-disc list-inside text-stone-700 space-y-1 marker:text-thmblue">
      <li>Preprint — not peer-reviewed</li>
      <li>French and English editions on par (FR/EN drift = 0 on ~4,400 labels)</li>
      <li>Canonical registry: 56 companion Python scripts, 2,694/2,695 passing checks, 1 known failure independent of recent additions</li>
      <li>LaTeX sources publicly available (monograph repo)</li>
    </ul>

    <h2 class="text-xl font-semibold text-thmblue mt-12 mb-3 font-sans">Citation</h2>
    <pre class="text-xs"><code>@book&#123;senez2026persistence,
  author    = &#123;Senez, Yan&#125;,
  title     = &#123;The Theory of Persistence: From the Sieve to the Standard Model&#125;,
  year      = &#123;2026&#125;,
  publisher = &#123;Self-published preprint&#125;,
  url       = &#123;https://www.persistencetheory.org&#125;
&#125;</code></pre>
  </section>
</BaseLayout>
