---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Periodic demonstration merged"
  description="This entry has been merged into the Periodic table page."
>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <p class="pt-tag pt-tag-id mb-4">Merged page</p>
    <h1 class="text-4xl font-bold text-thmblue mb-5">
      The demonstration now lives inside the Periodic table page
    </h1>
    <p class="text-lg text-slate-700 leading-relaxed mb-6">
      To avoid two redundant entries, the compact demonstration, the three
      depth levels, polygons, periods, and PTC code are grouped into one
      canonical page.
    </p>
    <a
      href="/en/tableau-periodique"
      class="inline-block px-5 py-3 bg-thmblue text-white rounded font-sans font-semibold hover:bg-thmblue/90"
    >
      Open Periodic table
    </a>
  </section>
</BaseLayout>
