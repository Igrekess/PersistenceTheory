---
import BaseLayout from '@layouts/BaseLayout.astro';

const tBase = '/en/theorems';
const nodes = [
  { id: 'T0', label: 'T0', sub: 'dynamical field', x: 60, y: 90, kind: 'thm', href: `${tBase}/T0`, tooltip: 'BA0 closes: the gap sequence {g_n} is the unique admissible dynamical field.' },
  { id: 'L0', label: 'L0', sub: 'unique distribution', x: 190, y: 90, kind: 'thm', href: `${tBase}/L0`, tooltip: 'Geometric is the unique memoryless max-entropy distribution.' },
  { id: 'T1', label: 'T1', sub: 'forbidden transitions', x: 310, y: 90, kind: 'thm', href: `${tBase}/T1`, tooltip: 'Transitions 1→1 and 2→2 mod 3 are forbidden. This zero diagonal forces s = 1/2.' },
  { id: 'P2', label: 'p = 2', sub: 'spin dynamics', x: 430, y: 90, kind: 'bridge', href: `${tBase}/N4`, tooltip: 'p=2 carries spin/parity dynamics: two ± channels whose average is s=1/2.' },
  { id: 's', label: 's = 1/2', sub: 'parity average', x: 560, y: 90, kind: 'thm', href: `${tBase}/T1`, tooltip: 'Symmetry derived by T1/T4: the average invariant of the parity doublet, not a chosen parameter.' },
  { id: 'T2', label: 'T2', sub: 'conservation α = s²', x: 690, y: 90, kind: 'thm', href: `${tBase}/T2`, tooltip: 'Spectral conservation: |λ₂(T₃₀)| = 1/4 = s².' },
  { id: 'GFT', label: 'GFT', sub: 'log m = D_KL + H', x: 820, y: 90, kind: 'thm', href: `${tBase}/GFT`, tooltip: 'Fundamental principle of persistence: capacity = persistence + entropy.' },
  { id: 'T3', label: 'T3', sub: 'antidiagonal transfer', x: 950, y: 90, kind: 'thm', href: `${tBase}/T3`, tooltip: 'The mod-3 kernel becomes purely antidiagonal after T1.' },
  { id: 'T4', label: 'T4', sub: 'convergence αₖ → ½', x: 220, y: 220, kind: 'thm', href: `${tBase}/T4`, tooltip: 'Mertens + Gordin + CRT: the sieve finishes the job.' },
  { id: 'T6', label: 'T6', sub: 'holonomy sin²θ_p', x: 360, y: 220, kind: 'thm', href: `${tBase}/T6`, tooltip: 'sin²θ_p = δ_p(2 − δ_p). Trigonometry emerges.' },
  { id: 'T5', label: 'T5', sub: 'μ* = 3 + 5 + 7 = 15', x: 540, y: 220, kind: 'thm', href: `${tBase}/T5`, tooltip: 'The attractive arithmetic fixed point of the reduced sector.' },
  { id: 'BIF', label: 'Bifurcation', sub: 'q⁺ / q⁻', x: 760, y: 220, kind: 'bridge', href: null, tooltip: 'Seeded by p=2, then frozen at μ* = 15: q⁺ = 1 − 2/μ; q⁻ = e^(−1/μ).' },
  { id: 'qplus', label: 'q⁺', sub: 'couplings, leptons, α_EM', x: 600, y: 360, kind: 'der', href: '/en/observables', tooltip: 'Vertex, α_EM = 1/137, lepton masses, PMNS.' },
  { id: 'qminus', label: 'q⁻', sub: 'geometry, quarks, CKM', x: 920, y: 360, kind: 'der', href: '/en/observables', tooltip: 'Propagator, metric, quark masses, CKM.' },
  { id: 'OBS', label: '43 observables', sub: 'mean error 0.316%', x: 760, y: 470, kind: 'val', href: '/en/observables', tooltip: 'Standard Model reproduced, 0 continuously fitted parameters.' },
];

const edges = [
  ['T0', 'L0'], ['L0', 'T1'], ['T1', 'P2'], ['P2', 's'], ['s', 'T2'], ['T2', 'GFT'], ['GFT', 'T3'],
  ['T3', 'T4'], ['T4', 'T6'], ['T6', 'T5'], ['P2', 'BIF'], ['T5', 'BIF'],
  ['BIF', 'qplus'], ['BIF', 'qminus'],
  ['qplus', 'OBS'], ['qminus', 'OBS'],
];

function fill(kind: string) {
  return {
    input: { fill: '#fef3c7', stroke: '#d97706', text: '#78350f' },
    thm: { fill: '#dbeafe', stroke: '#1d4ed8', text: '#1e3a8a' },
    bridge: { fill: '#ede9fe', stroke: '#7c3aed', text: '#4c1d95' },
    der: { fill: '#fed7aa', stroke: '#ea580c', text: '#7c2d12' },
    val: { fill: '#d1fae5', stroke: '#059669', text: '#064e3b' },
  }[kind] || { fill: 'white', stroke: '#888', text: '#333' };
}

const W = 1080, H = 540;
---

<BaseLayout
  title="Causal chain"
  description="From the sieve to the 43 observables: the interactive causal chain of Persistence Theory. Click a node to open the corresponding theorem."
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">Causal chain</h1>
    <p class="text-stone-700 mb-6 max-w-3xl">
      From the arithmetic chain to the derived symmetry <span class="font-mono">s = 1/2</span>,
      then to the 43 Standard Model observables. Nodes distinguish theorems, bridges,
      derivations, and validations. Click a node to open its page.
    </p>

    <div class="bg-white border border-stone-200 rounded-lg p-4 overflow-x-auto">
      <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[900px]" aria-label="PT causal chain" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#475569" />
          </marker>
        </defs>

        {edges.map(([from, to]) => {
          const a = nodes.find(n => n.id === from)!;
          const b = nodes.find(n => n.id === to)!;
          const dx = b.x - a.x, dy = b.y - a.y;
          const len = Math.sqrt(dx*dx + dy*dy);
          const nx = dx/len, ny = dy/len;
          const ax = a.x + nx * 55, ay = a.y + ny * 28;
          const bx = b.x - nx * 55, by = b.y - ny * 28;
          return (
            <line x1={ax} y1={ay} x2={bx} y2={by} stroke="#475569" stroke-width="1.6" marker-end="url(#arrow)" />
          );
        })}

        {nodes.map(n => {
          const c = fill(n.kind);
          const w = n.id === 'OBS' ? 180 : (n.id === 'BIF' ? 130 : 110);
          const h = n.id === 'OBS' ? 60 : 50;
          return (
            <g class="chain-node" data-tooltip={n.tooltip}>
              <a href={n.href} class={n.href ? '' : 'pointer-events-none'}>
                <rect x={n.x - w/2} y={n.y - h/2} width={w} height={h} rx="6" fill={c.fill} stroke={c.stroke} stroke-width="1.5" />
                <text x={n.x} y={n.y - 5} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="14" font-weight="700" fill={c.text}>{n.label}</text>
                <text x={n.x} y={n.y + 13} text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill={c.text}>{n.sub}</text>
              </a>
            </g>
          );
        })}
      </svg>
    </div>

    <div id="chain-tooltip" class="mt-4 px-4 py-3 rounded bg-stone-50 border border-stone-200 text-sm text-stone-700 italic min-h-[3rem]">
      Hover a node for its description, click to open its page.
    </div>

    <div class="grid md:grid-cols-2 gap-4 mt-8 text-sm">
      <div class="pt-card">
        <h3 class="font-sans font-semibold text-thmblue mb-2">The critical path</h3>
        <p class="text-stone-700">
          The chain starts from the dynamical field closed by T0, then L0 fixes
          the gap law and T1 imposes the zero diagonal. The <span class="font-mono">p = 2</span>
          channel carries the spin/parity dynamics, whose average invariant is
          <span class="font-mono">s = 1/2</span>. T2 and GFT express conservation,
          T6 makes trigonometry emerge, and T5 closes the reduced attractor.
        </p>
      </div>
      <div class="pt-card">
        <h3 class="font-sans font-semibold text-thmblue mb-2">The bifurcation</h3>
        <p class="text-stone-700">
          The split first comes from <span class="font-mono">p = 2</span>:
          parity, two <span class="font-mono">±</span> channels. At
          <span class="font-mono">μ* = 15</span>, this split is frozen as
          <span class="font-mono">q⁺/q⁻</span>. The <span class="font-mono">q⁺</span>
          branch yields couplings; <span class="font-mono">q⁻</span> yields geometry.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap gap-x-4 gap-y-1 mt-6 text-xs font-sans text-stone-600">
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#fef3c7;border:1px solid #d97706"></span>input</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#dbeafe;border:1px solid #1d4ed8"></span>theorem</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#ede9fe;border:1px solid #7c3aed"></span>bridge</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#fed7aa;border:1px solid #ea580c"></span>derivation</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background:#d1fae5;border:1px solid #059669"></span>verified</span>
    </div>
  </section>

  <script is:inline>
    (function () {
      const tooltip = document.getElementById('chain-tooltip');
      const defaultText = tooltip.textContent;
      document.querySelectorAll('.chain-node').forEach(node => {
        node.addEventListener('mouseenter', () => {
          tooltip.textContent = node.getAttribute('data-tooltip') || defaultText;
          tooltip.classList.remove('italic');
        });
        node.addEventListener('mouseleave', () => {
          tooltip.textContent = defaultText;
          tooltip.classList.add('italic');
        });
      });
    })();
  </script>
</BaseLayout>
