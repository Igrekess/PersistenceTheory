---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Tag from '@components/Tag.astro';

const all = (await getCollection('theorems_en'))
  .sort((a, b) => a.data.order - b.data.order);
const fundamentals = all.filter(t => t.data.tier === 'fundamental');
const secondaries = all.filter(t => t.data.tier === 'secondary');
---

<BaseLayout title="Theorems">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">Theorems</h1>
    <p class="text-stone-700 mb-8 max-w-2xl">
      The central results of Persistence Theory, in two tiers: the
      <strong>fundamentals</strong> (GFT, then the $T_0 \to T_6$ chain and L0)
      closing the derivation at $\mu^* = 15$, and the <strong>secondaries</strong>
      (naturality, bridges, identifications) widening and tightening the edifice.
    </p>

    <h2 class="text-xl font-sans font-semibold text-thmblue mt-4 mb-3">Fundamental theorems</h2>
    <p class="text-sm text-stone-600 mb-4">
      Nine results. GFT gives the fundamental principle: capacity =
      persistence + entropy. T0 then closes the BA0 axiomatic basis, L0 gives
      the uniqueness lemma, and T1–T6 close the arithmetic chain at
      $\mu^* = 15$.
    </p>
    <div class="grid md:grid-cols-2 gap-4">
      {fundamentals.map(thm => (
        <a href={`/en/theorems/${thm.data.id}`} class="pt-card block group">
          <div class="flex items-start justify-between gap-3 mb-2">
            <h3 class="font-sans font-semibold text-lg text-thmblue group-hover:underline">
              {thm.data.name}
            </h3>
            <Tag level={thm.data.status} />
          </div>
          <p class="text-sm text-stone-700">{thm.data.short}</p>
        </a>
      ))}
    </div>

    {secondaries.length > 0 && (
      <>
        <h2 class="text-xl font-sans font-semibold text-thmblue mt-12 mb-3">Secondary theorems</h2>
        <p class="text-sm text-stone-600 mb-4">
          Sieve naturality (N1–N4), derived bridge axioms (BA5),
          identification lemmas (E, F, G), and associated structural results.
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          {secondaries.map(thm => (
            <a href={`/en/theorems/${thm.data.id}`} class="pt-card block group">
              <div class="flex items-start justify-between gap-3 mb-2">
                <h3 class="font-sans font-semibold text-lg text-thmblue group-hover:underline">
                  {thm.data.name}
                </h3>
                <Tag level={thm.data.status} />
              </div>
              <p class="text-sm text-stone-700">{thm.data.short}</p>
            </a>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>
