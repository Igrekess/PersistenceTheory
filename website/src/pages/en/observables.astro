---
import BaseLayout from '@layouts/BaseLayout.astro';
import ObservablesTable from '@components/ObservablesTable.astro';
---

<BaseLayout title="43 observables">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">
      43 Standard Model observables
    </h1>
    <p class="text-stone-700 mb-6 max-w-3xl">
      All values are derived from the symmetry
      <span class="font-mono">s = 1/2</span> (Theorem T1), at fixed point
      <span class="font-mono">μ* = 15</span>. No fitted parameters at any step;
      one external input (dimensional calibration 1 SCU ≡ 1 MeV).
    </p>

    <ObservablesTable lang="en" />

    <div class="mt-8 text-sm text-stone-600 space-y-2">
      <p>
        <strong class="font-sans">Epistemic status:</strong> 4 self-consistencies (SC),
        2 exact integer values (N<sub>c</sub>, N<sub>gen</sub>), 37 independent predictions
        (mean 0.082%; median 0.06%).
      </p>
      <p>
        Canonical source: <a href="/en/monograph" class="underline text-thmblue">monograph</a>,
        Appendix A. Verification: companion scripts tracked in Appendix F (→ <a href="/en/scripts" class="underline text-thmblue">/scripts</a>).
      </p>
    </div>
  </section>
</BaseLayout>
