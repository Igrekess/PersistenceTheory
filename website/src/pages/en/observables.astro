---
import BaseLayout from '@layouts/BaseLayout.astro';
import DashboardHero from '@components/DashboardHero.astro';
import ObservablesTable from '@components/ObservablesTable.astro';
import observables from '@/data/observables.json';

const errors = observables.map((o) => o.error_pct);
const nonStructural = observables.filter((o) => !o.sc && !o.exact);
const nonStructuralErrors = nonStructural.map((o) => o.error_pct);
const mean = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length;
const median = (values: number[]) => {
  const sorted = [...values].sort((a, b) => a - b);
  const mid = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
};
const pct = (value: number, digits = 3) => value.toFixed(digits);
const under05 = observables.filter((o) => o.error_pct < 0.5).length;

const errBuckets = [
  { label: '< 0.01 %', count: observables.filter((o) => o.error_pct < 0.01).length, color: '#1e6f47' },
  { label: '0.01–0.1 %', count: observables.filter((o) => o.error_pct >= 0.01 && o.error_pct < 0.1).length, color: '#2c8959' },
  { label: '0.1–0.5 %', count: observables.filter((o) => o.error_pct >= 0.1 && o.error_pct < 0.5).length, color: '#7da64a' },
  { label: '0.5–1 %', count: observables.filter((o) => o.error_pct >= 0.5 && o.error_pct < 1).length, color: '#c9a64a' },
  { label: '1–2 %', count: observables.filter((o) => o.error_pct >= 1 && o.error_pct < 2).length, color: '#c96f24' },
  { label: '> 2 %', count: observables.filter((o) => o.error_pct >= 2).length, color: '#a83232' },
];
const maxCount = Math.max(...errBuckets.map((b) => b.count));

const sectors = [
  { label: 'Gauge', count: 4, examples: ['1/α_EM', 'α_s', 'sin²θ_W', 'sin²θ_eff'] },
  { label: 'Leptons', count: 5, examples: ['m_e', 'm_μ', 'm_τ', 'Q_Koide', 'C_Koide'] },
  { label: 'Quarks', count: 6, examples: ['m_u', 'm_d', 'm_s', 'm_c', 'm_b', 'm_t'] },
  { label: 'Bosons', count: 4, examples: ['m_W', 'm_Z', 'm_H', 'λ_H'] },
  { label: 'CKM', count: 4, examples: ['V_us', 'V_cb', 'V_ub', 'δ_CP'] },
  { label: 'PMNS', count: 4, examples: ['sin²θ_12', 'sin²θ_13', 'sin²θ_23', 'δ_CP'] },
  { label: 'Neutrinos', count: 3, examples: ['m_ν₃', 'Δm²_31', 'Δm²_21'] },
  { label: 'QCD', count: 3, examples: ['σ_QCD', 'f_π', 'm_π'] },
  { label: 'Gravity / cosmo', count: 6, examples: ['G/α', 'H₀', 'Ω_info', 'Ω_Λ', 'n_s', 'F_echo'] },
  { label: 'Combinatorial', count: 4, examples: ['N_c', 'N_gen', 'C_F', 'D=2'] },
];

const benchmarks = [
  { label: 'Mean error', value: `${pct(mean(errors), 3)} %`, tone: 'thmblue' },
  { label: 'Median error', value: `${pct(median(errors), 3)} %`, tone: 'derorange' },
  { label: 'Observables under 0.5 %', value: `${under05} / ${observables.length}`, tone: 'emerald' },
  { label: 'Continuous fit parameters', value: '0', tone: 'rose' },
  { label: 'Dimensional convention', value: 'SCU', tone: 'amber' },
  { label: 'Conservative aggregate', value: `${nonStructural.length} obs.`, tone: 'sky' },
];

const toneClasses: Record<string, string> = {
  thmblue: 'border-thmblue text-thmblue',
  derorange: 'border-derorange text-derorange',
  emerald: 'border-emerald-500 text-emerald-700',
  rose: 'border-rose-500 text-rose-700',
  amber: 'border-amber-500 text-amber-700',
  sky: 'border-sky-500 text-sky-700',
};

const chart = { left: 110, right: 720, top: 30, bottom: 220 };
const barW = 70;
const barX = (i: number) => 130 + i * 100;
const barY = (count: number) => chart.bottom - (count / maxCount) * (chart.bottom - chart.top);
---

<BaseLayout
  title="43 observables"
  description={`The 43 Standard Model observables derived from s = 1/2 and μ* = 15. Mean error ${pct(mean(errors), 3)} %, median ${pct(median(errors), 3)} %, zero continuously fitted parameters.`}
>
  <DashboardHero
    eyebrow="Plain · quantitative validation"
    title="43 observables, 0 continuous fit parameters"
    plain="All values are derived from the symmetry s = 1/2 (Theorem T1), at the physical attractor of the reduced sector μ* = 15 (T5). No continuous parameter is fitted."
    standard={`Across 43 observables compared with the PDG, the mean error is ${pct(mean(errors), 3)} %, the median ${pct(median(errors), 3)} %. The conservative aggregate excluding SC self-consistencies and exact integers contains ${nonStructural.length} independent real-valued entries.`}
    note="SCU fixes the dimensional reading unit, like c in SI, without introducing a fit."
  />

  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14">

    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-val mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-3">All 43 observables, filterable</h2>
      <p class="text-slate-700 mb-6 max-w-3xl">
        Filter by sector, search by name. Click a row to expand the detailed
        derivation (PT formula, monograph chapter, epistemic status).
      </p>
      <ObservablesTable lang="en" />
    </section>

    <section class="mb-12">
      <p class="pt-tag pt-tag-thm mb-3">Plain</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Six numbers to remember</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {benchmarks.map((b) => (
          <div class={`rounded-lg border-2 bg-white p-5 ${toneClasses[b.tone]}`}>
            <p class="text-xs font-sans uppercase tracking-wider text-stone-500 mb-2">{b.label}</p>
            <p class="text-3xl font-bold font-mono">{b.value}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-id mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">How are the 43 errors distributed?</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-sm text-stone-600 mb-4 font-sans">
          Distribution of |PT − PDG| / PDG discrepancies across the 43 observables.
        </p>
        <svg viewBox="0 0 760 280" class="w-full h-auto" role="img" aria-label="Histogram error distribution 43 observables">
          <rect x="0" y="0" width="760" height="280" rx="8" fill="#ffffff" />
          {[0, 4, 8, 12, 16].map((tick) => (
            <g>
              <line x1={chart.left} x2={chart.right} y1={barY(tick)} y2={barY(tick)} stroke="#e2e8f0" />
              <text x="80" y={barY(tick) + 4} font-size="11" fill="#5f6f80" font-family="ui-sans-serif, system-ui" text-anchor="end">{tick}</text>
            </g>
          ))}
          <text x="80" y="20" font-size="11" fill="#5f6f80" font-family="ui-sans-serif, system-ui" text-anchor="end">obs</text>
          {errBuckets.map((bucket, i) => {
            const x = barX(i);
            const yTop = barY(bucket.count);
            return (
              <g>
                <rect x={x} y={yTop} width={barW} height={chart.bottom - yTop} fill={bucket.color} rx="4" />
                <text x={x + barW / 2} y={yTop - 8} text-anchor="middle" font-size="13" font-weight="700" fill="#17202a" font-family="ui-sans-serif, system-ui">{bucket.count}</text>
                <text x={x + barW / 2} y={chart.bottom + 18} text-anchor="middle" font-size="11" fill="#17202a" font-weight="600" font-family="ui-sans-serif, system-ui">{bucket.label}</text>
              </g>
            );
          })}
          <text x="380" y="265" text-anchor="middle" font-size="12" fill="#5f6f80" font-family="ui-sans-serif, system-ui">
            {under05} of {observables.length} observables below 0.5 % error
          </text>
        </svg>
      </div>
    </section>

    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-der mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Which Standard Model sectors are covered?</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {sectors.map((sec) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-baseline justify-between mb-3">
              <h3 class="font-sans font-semibold text-thmblue text-lg">{sec.label}</h3>
              <span class="font-mono text-2xl font-bold text-derorange">{sec.count}</span>
            </div>
            <p class="text-xs font-sans text-stone-500 uppercase tracking-wider mb-1">Examples</p>
            <p class="text-sm text-slate-700 font-mono">{sec.examples.join(', ')}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-thm mb-3">Standard · epistemic status</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">An important distinction</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-lg border border-emerald-300 bg-emerald-50 p-5">
          <h3 class="font-sans font-semibold text-emerald-800 text-lg mb-2">4 self-consistencies (SC)</h3>
          <p class="text-sm text-emerald-900 leading-relaxed">
            Q_Koide = 2/3, N_c = 3, N_gen = 3, m_e = 1/2 (SCU). These are
            <strong>not strict predictions</strong>: they are internal
            self-consistency constraints of the sieve.
          </p>
        </div>
        <div class="rounded-lg border border-blue-300 bg-blue-50 p-5">
          <h3 class="font-sans font-semibold text-blue-800 text-lg mb-2">2 exact integers</h3>
          <p class="text-sm text-blue-900 leading-relaxed">
            N_c = 3 (mod-3 combinatorics) and N_gen = 3 (Catalan: 3² − 2³ = 1).
            No expected nor measurable error.
          </p>
        </div>
        <div class="rounded-lg border border-orange-300 bg-orange-50 p-5">
          <h3 class="font-sans font-semibold text-orange-800 text-lg mb-2">{nonStructural.length} independent entries</h3>
          <p class="text-sm text-orange-900 leading-relaxed">
            <strong>Mean error {pct(mean(nonStructuralErrors), 3)} %, median {pct(median(nonStructuralErrors), 3)} %.</strong>
            This block excludes SC self-consistencies and exact integers. The entries
            remain derived without continuously fitted parameters, then compared with measurement.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-12" data-min-depth="L3">
      <p class="pt-tag pt-tag-val mb-3">Technical</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">How to read the aggregates</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue text-lg mb-2">Mean error</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            The mean is computed on absolute relative discrepancies
            <span class="font-mono">|PT − exp| / exp</span>. It is sensitive
            to the few observables that are furthest away.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue text-lg mb-2">Median</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            The median gives the typical case: half of the observables are
            closer, half are farther. It is more robust to outliers.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="font-sans font-semibold text-thmblue text-lg mb-2">Conservative aggregate</h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            SC self-consistencies and exact integers are separated from the
            independent real-valued entries so the global score is not
            artificially inflated.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-8">
      <p class="pt-tag pt-tag-bridge mb-3">Going further</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Verify it yourself</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/en/scripts" class="pt-card block group">
          <span class="pt-tag pt-tag-val">Reproducibility</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Run the scripts in browser</h3>
          <p class="text-sm text-slate-700">Pyodide WASM runs the T5, T6, α_EM and lemma E/F/G checks live.</p>
        </a>
        <a href="/en/calculator" class="pt-card block group">
          <span class="pt-tag pt-tag-val">Manipulation</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">α_EM, γ_p, sin²θ_p calculators</h3>
          <p class="text-sm text-slate-700">Three interactive calculators to see the formulas at work.</p>
        </a>
        <a href="/en/predictions" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">Predictions</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">28 falsifiable Tier-1 predictions</h3>
          <p class="text-sm text-slate-700">Beyond the 43 reproductions: what PT predicts for DUNE, JUNO, Euclid.</p>
        </a>
        <a href="/en/monograph" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Canonical source</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Appendix A of the monograph</h3>
          <p class="text-sm text-slate-700">Complete table of the 43 observables with chapter-by-chapter derivation.</p>
        </a>
        <a href="/en/statuts-resultats" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Methodology</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Epistemic statuses</h3>
          <p class="text-sm text-slate-700">THM, ID, BRIDGE, DER, VAL, PRED — what each tag really means.</p>
        </a>
        <a href="/en/difficile-a-rejeter" class="pt-card block group">
          <span class="pt-tag pt-tag-bridge">Robustness</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Why this score is hard to reject</h3>
          <p class="text-sm text-slate-700">5 criteria: zero free parameters, ablation tests, explicit statuses.</p>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
