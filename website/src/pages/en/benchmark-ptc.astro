  <script is:inline>
    (function () {
      const input = document.getElementById('bench1-filter');
      const verifiedOnly = document.getElementById('bench1-verified-only');
      const tbody = document.getElementById('bench1-tbody');
      const counter = document.getElementById('bench1-count');
      if (!input || !tbody || !counter) return;
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const total = rows.length;
      function applyFilter() {
        const q = input.value.trim().toLowerCase();
        const greenOnly = verifiedOnly && verifiedOnly.checked;
        let visible = 0;
        for (const r of rows) {
          const matchText = !q || (r.dataset.search || '').includes(q);
          const matchGreen = !greenOnly || r.dataset.green === '1';
          const show = matchText && matchGreen;
          r.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        counter.textContent = visible === total ? String(total) : `${visible} / ${total}`;
      }
      input.addEventListener('input', applyFilter);
      if (verifiedOnly) verifiedOnly.addEventListener('change', applyFilter);
    })();
  </script>
