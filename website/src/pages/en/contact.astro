---
import BaseLayout from '@layouts/BaseLayout.astro';
import { REPO_ISSUES, REPO_URL } from '@/lib/repo';

const email = 'yan.senez@protonmail.com';

// Formspree placeholder. Replace YOUR_FORM_ID with the ID from
// https://formspree.io/ (free tier, ~2 min setup) to enable the form.
// Until then, the form falls back to a mailto: link, which always works.
const formspreeId = 'YOUR_FORM_ID';
const formAction = formspreeId === 'YOUR_FORM_ID'
  ? `mailto:${email}`
  : `https://formspree.io/f/${formspreeId}`;
const formMethod = formspreeId === 'YOUR_FORM_ID' ? 'GET' : 'POST';
---

<BaseLayout title="Contact">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-6">Contact</h1>

    <p class="text-stone-800 leading-relaxed mb-8">
      For any question, comment, error report, or collaboration request,
      several channels are available depending on the nature of your message.
    </p>

    <div class="grid md:grid-cols-2 gap-4 mb-10">
      <a
        href={`mailto:${email}?subject=${encodeURIComponent('[PT] ')}`}
        class="pt-card block group"
      >
        <div class="text-xs font-sans text-stone-500 uppercase tracking-wider mb-2">
          Direct email
        </div>
        <h2 class="font-sans font-semibold text-thmblue mb-2 group-hover:underline">
          {email}
        </h2>
        <p class="text-sm text-stone-700">
          For private exchanges, collaboration proposals, or general questions
          about the theory.
        </p>
      </a>

      <a
        href={REPO_ISSUES}
        class="pt-card block group"
        rel="noopener"
      >
        <div class="text-xs font-sans text-stone-500 uppercase tracking-wider mb-2">
          GitHub Issues
        </div>
        <h2 class="font-sans font-semibold text-thmblue mb-2 group-hover:underline">
          Report an error or suggest a correction
        </h2>
        <p class="text-sm text-stone-700">
          Best for typos, site bugs, errors in the monograph or scripts.
          Public trace and open discussion.
        </p>
      </a>
    </div>

    <h2 class="text-xl font-semibold text-thmblue mt-10 mb-3 font-sans">Form</h2>
    <p class="text-sm text-stone-700 mb-4">
      If you prefer a form, fill in the fields below.
      {formspreeId === 'YOUR_FORM_ID' && (
        <span class="text-stone-500 italic">
          (The form opens your mail client. For direct delivery, a service
          like Formspree can be wired in later.)
        </span>
      )}
    </p>

    <form
      action={formAction}
      method={formMethod}
      enctype={formspreeId === 'YOUR_FORM_ID' ? 'text/plain' : 'application/x-www-form-urlencoded'}
      class="space-y-4 bg-white border border-stone-200 rounded-lg p-6"
    >
      <div>
        <label for="name" class="block text-sm font-semibold text-stone-700 mb-1 font-sans">
          Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-3 py-2 border border-stone-300 rounded focus:outline-none focus:ring-2 focus:ring-thmblue/40"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-stone-700 mb-1 font-sans">
          Email (optional, for reply)
        </label>
        <input
          type="email"
          id="email"
          name="email"
          class="w-full px-3 py-2 border border-stone-300 rounded focus:outline-none focus:ring-2 focus:ring-thmblue/40"
        />
      </div>

      <div>
        <label for="subject" class="block text-sm font-semibold text-stone-700 mb-1 font-sans">
          Subject
        </label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          value="[PT] "
          class="w-full px-3 py-2 border border-stone-300 rounded focus:outline-none focus:ring-2 focus:ring-thmblue/40"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-stone-700 mb-1 font-sans">
          Message
        </label>
        <textarea
          id="message"
          name="body"
          rows="6"
          required
          class="w-full px-3 py-2 border border-stone-300 rounded focus:outline-none focus:ring-2 focus:ring-thmblue/40"
        ></textarea>
      </div>

      <button
        type="submit"
        class="px-5 py-3 bg-thmblue text-white font-sans font-semibold rounded hover:bg-thmblue/90"
      >
        Send
      </button>
    </form>

    <h2 class="text-xl font-semibold text-thmblue mt-12 mb-3 font-sans">Other resources</h2>
    <ul class="list-disc list-inside text-stone-700 space-y-1 marker:text-thmblue">
      <li>
        Main GitHub repo:
        <a href={REPO_URL} class="underline text-thmblue" rel="noopener">{REPO_URL}</a>
      </li>
      <li>
        All author repos:
        <a href="https://github.com/Igrekess" class="underline text-thmblue" rel="noopener">github.com/Igrekess</a>
      </li>
    </ul>
  </section>
</BaseLayout>
