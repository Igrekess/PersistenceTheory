---
import BaseLayout from '@layouts/BaseLayout.astro';
import glossary from '@/data/glossary.json';

const items = glossary.terms
  .map(t => ({ key: t.key, term: t.en.term, definition: t.en.definition }))
  .sort((a, b) => a.term.localeCompare(b.term, 'en'));
---

<BaseLayout
  title="Glossary"
  description="Glossary of Persistence Theory-specific terms: μ*, q⁺, q⁻, sin²θ_p, GFT, and the theorems T0–T6."
>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">Glossary</h1>
    <p class="text-stone-700 mb-2 max-w-3xl">
      Technical terms specific to Persistence Theory. These terms also appear
      as hover popovers in essays and articles — try mousing over them.
    </p>
    <p class="text-sm text-stone-500 mb-8">
      For the full glossary (116 entries: authors, acronyms, mathematics),
      see the monograph’s <em>Glossary</em> chapter.
    </p>

    <div class="grid md:grid-cols-2 gap-3">
      {items.map(it => (
        <div id={it.key} class="pt-card text-sm">
          <div class="font-mono text-thmblue font-bold mb-1">{it.term}</div>
          <p class="text-stone-700">{it.definition}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
