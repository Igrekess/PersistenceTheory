---
import BaseLayout from '@layouts/BaseLayout.astro';
import DashboardHero from '@components/DashboardHero.astro';

const commitments = [
  { id: 'C1', status: 'THM', cls: 'pt-tag-thm', label: 'SCU calibration as Buckingham π convention', detail: '1 SCU ≡ 1 MeV. Dissolved as a unit convention; cf. App. P §C1.' },
  { id: 'C2', status: 'THM', cls: 'pt-tag-thm', label: 'N(p) = (p+1)^(p+1) − 1 universal', detail: 'Domain [p+1] via ZFC + L0 max-entropy; simplified plain-Set + ZFC additivity proof.' },
  { id: 'C3', status: 'DER/COND', cls: 'pt-tag-cond', label: 'n_up = 9/8 via 2-loop Fisher on T³', detail: 'T³ Fisher amplitude derived; cf. ch10 thm:n_up_fisher_T3.' },
  { id: 'C4', status: 'DER/COND', cls: 'pt-tag-cond', label: 'NNLO coefficient 5/18 = p₂/(2p₁²)', detail: 'Exact once its incidence topology and its role assignment are fixed; conditional status (B4 requalification, 14 August 2026).' },
  { id: 'C5', status: 'DER/COND', cls: 'pt-tag-cond', label: 'Fisher–Koide NLO 1/21', detail: '1/21 = Haar(Z/3Z) × Haar(Z/7Z); f₅ excluded NNLO via T6.' },
  { id: 'C6', status: 'DER/COND', cls: 'pt-tag-cond', label: 'Berry holonomy 3π', detail: 'Limit N_gen × π justified by self-consistency.' },
  { id: 'C7', status: 'THM', cls: 'pt-tag-thm', label: 'Linear γ₃ in the spiral resummation', detail: 'Promoted to THM 2026-04-26; App. P §C7 pp. 681-683.' },
  { id: 'C8', status: 'DER/COND', cls: 'pt-tag-cond', label: '24 quark exponents', detail: 'Catalogue closed by combinatorial enumeration.' },
  { id: 'C9', status: 'THM', cls: 'pt-tag-thm', label: 'Higgs portal δ = m_H²/M²', detail: 'Inverse hierarchy excluded; cf. App. P §C9.' },
  { id: 'C10', status: 'THM', cls: 'pt-tag-thm', label: 'Super-echo {11,13,17,19,23}', detail: 'Hadronic cutoff p = 23 derived.' },
];
---

<BaseLayout title="Transparent audit">
  <DashboardHero
    eyebrow="Technical · traceability"
    title="Transparent audit"
    plain="This page gathers the structural choices, internal checks, external audits and applied corrections. It acts as a critical reading register for the site and the monograph."
    standard="Each C1–C10 commitment is presented as a discrete choice with its epistemic status. Since the B4 requalification of 14 August 2026, the official counter C1–C12 stands at 5 [THM] + 6 [DER]/[COND] + 1 [VAL]. The goal is to separate what is proved, derived, validated, predicted or still open."
    note="Open preprint: the site keeps the solid points and the points still to verify visible."
  />

  <section class="max-w-4xl mx-auto px-4 py-10 md:py-14">

    <h2 class="text-xl font-semibold text-thmblue mt-10 mb-3 font-sans">
      Structural commitments C1–C10
    </h2>
    <p class="text-stone-700 mb-4">
      Each discrete choice in the derivation chain is closed by an explicit
      argument and carries its own epistemic status. Since the
      <strong>B4 requalification of 14 August 2026</strong>, the official counter
      runs over C1–C12 and stands at
      <strong>5 <span class="pt-tag pt-tag-thm">THM</span> + 6
      <span class="pt-tag pt-tag-cond">DER/COND</span> + 1
      <span class="pt-tag pt-tag-val">VAL</span></strong>. Of the ten commitments
      listed below, five are THM and five are DER/COND; C11 (VAL) and C12
      (DER/COND) are not detailed on this page. None is a continuous parameter;
      none can be tuned to improve a fit.
    </p>

    <div class="grid md:grid-cols-2 gap-3 mb-10">
      {commitments.map(c => (
        <div class="pt-card text-sm">
          <div class="flex items-center gap-2 mb-1">
            <span class="font-sans font-bold text-thmblue">{c.id}</span>
            <span class={`pt-tag ${c.cls}`}>{c.status}</span>
          </div>
          <p class="text-stone-800 font-sans font-semibold">{c.label}</p>
          <p class="text-stone-600 mt-1">{c.detail}</p>
        </div>
      ))}
    </div>

    <h2 class="text-xl font-semibold text-thmblue mt-10 mb-3 font-sans">
      Peer-review status
    </h2>
    <p class="text-stone-700">
      <strong>Preprint — not peer-reviewed.</strong> The author welcomes critical
      scrutiny and independent verification. The canonical registry has 56
      companion Python script entries, 2,522/2,523 passing checks, and 1 known failure
      independent of recent additions; the public scripts and reports remain
      reproducible.
    </p>
  </section>
</BaseLayout>
