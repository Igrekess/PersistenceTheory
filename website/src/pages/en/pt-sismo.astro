---
import BaseLayout from '@layouts/BaseLayout.astro';

const webappUrl = '';
const webappPublic = webappUrl !== '';

// Why seismic prediction is notoriously difficult
const seismicChallenges = [
  {
    label: 'No known deterministic precursor',
    detail: 'Classical seismology recognises that no single physical signal (radon, electromagnetic field, slow deformation) is universally precursory. Statistical methods (ETAS, EEPAS) predict rates, not events.',
  },
  {
    label: 'Rare and asymmetric data',
    detail: 'An M ≥ 7 earthquake is a rare event; M ≥ 6 remains rare. Validation requires long time windows (months to years) and decades of catalogue.',
  },
  {
    label: 'Huge overfitting risk',
    detail: 'With 11 regions and several candidate markers, fitting a protocol on the past easily yields F1 > 0.9 — but does not hold up prospectively. Seismology is littered with such failures.',
  },
  {
    label: 'Aftershocks contaminate statistics',
    detail: 'After a large earthquake, hundreds of aftershocks pollute the markers. Without a robust Omori filter, one keeps predicting shocks that have already passed.',
  },
];

// How PT_SISMO distinguishes itself
const ptApproach = [
  {
    title: 'Markers derived from the PT cascade, not fitted',
    detail: 'The three markers (gap T1, ρ T4, M4 CRT) come directly from the sequential PT cascade. None is fitted on the data; they are geophysical analogues of arithmetic structures.',
  },
  {
    title: 'SHA-256 hash-chain anti-retrofitting',
    detail: 'Each prediction snapshot is hashed in SHA-256 and chained in prediction_chain.json. Any retroactive modification breaks the chain. Predictions are verifiable like a lightweight blockchain.',
  },
  {
    title: '0 fitted regional parameters',
    detail: 'The 11 regions share the same thresholds. If Banda reaches F1 = 0.91 and Japan F1 = 0.81 without regional adjustment, this is not a local fit — it is a universal signature.',
  },
  {
    title: 'Closed prospective validation',
    detail: 'Predictions are issued with date and window BEFORE events. 5 earthquakes confirmed in April 2026 (Indonesia M7.4, Tohoku M7.4, etc.) validated in the system before they occurred.',
  },
];

// Architecture of the composite protocol
const markers = [
  {
    code: 'gap',
    pt: 'T1 — Forbidden mod 3 transitions',
    geo: 'Mod 3 distribution of intervals between seismic events',
    role: 'A deviation in forbidden transitions signals an imminent rupture of the stable regime. Primary cascade marker.',
  },
  {
    code: 'ρ (rho)',
    pt: 'T4 — Spectral convergence',
    geo: 'Local persistence density of the transfer matrix (spectral gap + eigenvector rotation)',
    role: 'When ρ drops abruptly relative to the baseline, the system leaves its local fixed point. Phase-shift marker.',
  },
  {
    code: 'M4',
    pt: 'CRT — Modular asymmetry',
    geo: 'Order-4 moment of magnitudes per spatial cell',
    role: 'Measures the imbalance between discrete channels (tectonic segments). Orientation marker.',
  },
];

// 5 validations (already in place)
const recentDetections = [
  {
    label: 'Indonesia — M7.4 ★ first validation of the composite protocol',
    date: '2026-04-01',
    detail: 'HIGH issued on 28 March 2026 (gap 0.43, ρ 0.37). M7.4 earthquake occurred 4 days later. First closed prospective validation of the composite protocol (gap + ρ + VLOO). Monotone declining gap 0.50 → 0.38, high ρ 0.37 vs threshold 0.34.',
    status: '★ Prospective validation confirmed',
    highlight: true,
  },
  {
    label: 'Japan Tohoku — M7.4 ★ second major validation',
    date: '2026-04-20 07:53 UTC',
    detail: 'WATCH on 28 March 2026, escalation to HIGH on 18 April (gap 0.49 → 0.33 monotone, rotation 0.98, mag_score 1492). Estimated tc p25 = 9 d / p75 = 29 d. M7.4 earthquake occurred 2 days after the switch to HIGH. Crossing recorded in hash-chain 1.4 d before the event.',
    status: '★ Prospective validation confirmed',
    highlight: true,
  },
  {
    label: 'Indonesia — M5.5',
    date: '2026-04-21',
    detail: 'Secondary hit in the Indonesia window. Crossing recorded 2.2 days before.',
    status: 'Prospective validation confirmed',
    highlight: false,
  },
  {
    label: 'Japan Tohoku — M5.6 (two events)',
    date: '2026-04-20 / 2026-04-21',
    detail: 'Two M5.6 in the Tohoku window, 1.4 d and 2.9 d after the recorded crossings. Consistent with activation of adjacent segments post-M7.4.',
    status: 'Prospective validation confirmed',
    highlight: false,
  },
  {
    label: 'Greece — M5.8',
    date: '2026-04-24',
    detail: 'HIGH triggered by h_slope rule on 20 April; earthquake 3.4 days later. Continental tectonic family, outside subduction arcs.',
    status: 'Prospective validation confirmed',
    highlight: false,
  },
  {
    label: 'Turkey — Eastern Anatolia region',
    date: '2026-03-28 (prediction)',
    detail: 'HIGH on 28 March, then re-classified as INSUFFICIENT on 18 April (catalogue dropped below threshold). Honesty: probable residual signal post-Kahramanmaras 2023, window non-scorable. Case reported for transparency.',
    status: 'Non-scorable prediction (transparency)',
    highlight: false,
  },
];

const metrics = [
  { label: 'F1 pooled', value: '0.65', context: '70/30 OOS, 252 test events' },
  { label: 'F1 Banda', value: '0.91', context: 'best region' },
  { label: 'F1 Japan', value: '0.81', context: '2nd best region' },
  { label: 'Precision', value: '93 %', context: 'filtered false alarm rate' },
  { label: 'Regions covered', value: '11', context: 'with 0 fitted regional parameter' },
  { label: 'April 2026 prospective hits', value: '5', context: 'validated in SHA-256 hash-chain' },
];

const limits = [
  { title: 'Private code, not publicly auditable', detail: 'The repo github.com/Igrekess/PT_SISMO is private: engine and pipeline are not open-source. Collaboration request possible under agreement.' },
  { title: 'No exact magnitude prediction', detail: 'PT_SISMO predicts HIGH time windows by magnitude category (M5-6, M6+, etc.), not an exact magnitude or fault-level location. Limit intrinsic to the persistence approach.' },
  { title: 'Geo ↔ PT bridge: exploratory', detail: 'The cascade T0 → T1 → CRT transposition to seismic series is not yet [DER] in the strict sense. It is an empirically validated analogy, not a bridge theorem.' },
  { title: 'Open prospective validation windows', detail: 'Beyond the 5 April 2026 hits, several predictions from 28 March 2026 have their windows open until 2026-06-26. The definitive score will require several months.' },
];
---

<BaseLayout
  title="PT_SISMO — seismic prediction by persistence cascade"
  description="PT_SISMO: empirical application of the cascade T0 → T1 → CRT to seismic prediction. 5 earthquakes announced prospectively and chained in SHA-256 (April 2026), including Indonesia M7.4 and Japan Tohoku M7.4. 70/30 backtest on 252 events (F1 0.65). Private code, open prospective validation."
>
  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14">

    <!-- ============= HERO L1 ============= -->
    <section class="mb-12">
      <div class="rounded-lg border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
        <p class="pt-tag pt-tag-val mb-5">Plain · prospective research</p>
        <h1 class="text-4xl md:text-5xl font-bold text-thmblue leading-tight mb-4">
          Seismic prediction by persistence cascade
        </h1>
        <p class="text-2xl md:text-3xl font-sans font-semibold text-derorange leading-snug mb-6">
          Five earthquakes announced beforehand. Chained in hash-chain. Verifiable.
        </p>
        <div class="rounded-lg border-l-4 border-emerald-500 bg-emerald-50 px-4 py-3 mb-4">
          <p class="text-sm text-emerald-900 leading-relaxed">
            <strong>★ 5 prospective validations confirmed by hash-chain.</strong>
            Since April 2026, PT_SISMO has prospectively announced and
            cryptographically traced (SHA-256 chained in <code class="font-mono bg-emerald-100 px-1 py-0.5 rounded">prediction_chain.json</code>)
            at least <strong>5 earthquakes occurring within the predicted window</strong>:
            Indonesia M7.4 (1<sup>st</sup> April, 4 d after HIGH on 28 March),
            Japan Tohoku M7.4 (20 April, 2 d after the HIGH escalation),
            Indonesia M5.5, Japan Tohoku M5.6 (×2), Greece M5.8.
          </p>
        </div>
        <div class="rounded-lg border-l-4 border-amber-400 bg-amber-50 px-4 py-3 mb-6">
          <p class="text-sm text-amber-900 leading-relaxed">
            <strong>Status: ongoing research, open prospective validation.</strong>
            Several predictions from 28 March 2026 still have their window
            open (verification 2026-06-26). Code and data are not
            public — repo
            <code class="font-mono bg-amber-100 px-1 py-0.5 rounded">github.com/Igrekess/PT_SISMO</code> private.
            See also <a href="/en/recherches" class="underline">the Research page</a>
            for the broader context.
          </p>
        </div>
        <p class="text-lg text-slate-700 leading-relaxed mb-3" data-max-depth="L1">
          Seismic prediction has a reputation: <em>it does not work</em>.
          Over a century of approaches (radon, electromagnetism, slow
          deformation) has not produced a universal deterministic precursor.
          PT_SISMO does not claim to have found one. It takes another
          route: apply PT's arithmetic cascade
          (<em>the same structures that derive the atom</em>)
          to series of seismic events, and look for whether a statistical
          signature appears.
        </p>
        <p class="text-base text-slate-700 leading-relaxed" data-min-depth="L2">
          The empirical result: yes, on 11 tectonic regions with 35 years
          of catalogues, F1 pooled = 0.65 (Banda 0.91, Japan 0.81). And — this
          is the hard point — 5 earthquakes in April 2026 were announced
          <strong>before</strong> the event, their snapshot hashed in SHA-256
          and chained. This page presents the protocol, the markers, and
          how you can verify the chain yourself.
        </p>
      </div>
    </section>

    <!-- ============= WHY SEISMIC PREDICTION IS HARD L1 ============= -->
    <section class="mb-12">
      <p class="pt-tag pt-tag-id mb-3">Plain</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">Why seismic prediction is notoriously difficult</h2>
      <p class="text-slate-700 leading-relaxed mb-6 max-w-3xl">
        Before presenting what PT_SISMO does, one has to understand why
        this field is a trap. Four structural obstacles make any
        approach suspect by default.
      </p>
      <div class="grid md:grid-cols-2 gap-4">
        {seismicChallenges.map((c) => (
          <div class="rounded-lg border-l-4 border-rose-400 bg-rose-50 p-5">
            <h4 class="font-sans font-semibold text-rose-900 mb-2">{c.label}</h4>
            <p class="text-sm text-rose-900 leading-relaxed">{c.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============= HOW PT_SISMO RESPONDS L2 ============= -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-thm mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">Four design choices that distinguish PT_SISMO</h2>
      <p class="text-slate-700 leading-relaxed mb-6 max-w-3xl">
        PT_SISMO is not yet another statistical fit. It is a transposition
        of the PT cascade to the seismic domain, with four structural
        guardrails.
      </p>
      <div class="grid md:grid-cols-2 gap-4">
        {ptApproach.map((a) => (
          <div class="rounded-lg border-2 border-emerald-300 bg-emerald-50 p-5">
            <h4 class="font-sans font-semibold text-emerald-800 mb-2">→ {a.title}</h4>
            <p class="text-sm text-emerald-900 leading-relaxed">{a.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============= PROTOCOL ARCHITECTURE L2 ============= -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-thm mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">Three markers, one composite signal</h2>
      <p class="text-slate-700 leading-relaxed mb-6 max-w-3xl">
        PT_SISMO combines three markers derived from the PT cascade. A
        HIGH signal is only emitted when <strong>the three markers
        converge</strong> within a ±90 day window. It is this triple
        filter that yields the 93% precision.
      </p>
      <div class="space-y-4">
        {markers.map((m) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-baseline gap-3 flex-wrap mb-3">
              <code class="font-mono text-base font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded">{m.code}</code>
              <span class="text-xs font-sans uppercase tracking-wider text-slate-600">PT origin: {m.pt}</span>
            </div>
            <p class="text-sm text-slate-700 leading-relaxed mb-2">
              <strong>Geophysical side:</strong> {m.geo}
            </p>
            <p class="text-sm text-slate-700 leading-relaxed">
              <strong>Role in the signal:</strong> {m.role}
            </p>
          </div>
        ))}
      </div>
      <div class="rounded-lg bg-blue-50 border-l-4 border-thmblue px-4 py-3 mt-6">
        <p class="text-sm text-thmblue leading-relaxed">
          <strong>Omori aftershock filter.</strong> In addition, PT_SISMO applies
          a 15-365 day Omori window to exclude aftershocks. An
          escape clause maintains HIGH if <code class="font-mono">mag_estimate ≥ M6+</code>
          or <code class="font-mono">mag_score &gt; 500</code> — the zone is
          then marked <code class="font-mono">aftershock_context</code>
          rather than filtered out.
        </p>
      </div>
    </section>

    <!-- ============= WEBAPP / PLACEHOLDER ============= -->
    <section class="mb-12">
      <p class="pt-tag pt-tag-val mb-3">Plain · tool</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">Real-time dashboard</h2>
      {webappPublic ? (
        <div class="rounded-lg border border-slate-200 bg-white p-1 shadow-sm overflow-hidden">
          <iframe
            src={webappUrl}
            title="PT_SISMO webapp"
            class="w-full"
            style="height: 720px; border: 0;"
            loading="lazy"
            referrerpolicy="no-referrer"
          />
          <p class="text-xs text-stone-500 italic px-4 py-2 border-t border-slate-200">
            Embedded preview of the PT_SISMO webapp (read-only). For the full interactive version, open <a href={webappUrl} class="text-thmblue underline">{webappUrl}</a>.
          </p>
        </div>
      ) : (
        <div class="rounded-lg border-2 border-dashed border-stone-300 bg-stone-50 p-8 text-center">
          <p class="text-lg font-sans text-stone-700 mb-3">🚧 Webapp under development</p>
          <p class="text-sm text-stone-600 max-w-2xl mx-auto leading-relaxed">
            A PT_SISMO webapp for real-time visualisation of the predictions is
            under development. When it is published, its dashboard
            will be embedded here (iframe). In the meantime, the summary of
            recent detections and metrics is shown below.
          </p>
        </div>
      )}
    </section>

    <!-- ============= METRICS ============= -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-val mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">Backtest and prospective hits</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {metrics.map((m) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-sans uppercase tracking-wider text-stone-500 mb-2">{m.label}</p>
            <p class="text-3xl font-bold font-mono text-derorange">{m.value}</p>
            <p class="text-xs text-stone-600 mt-2">{m.context}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============= 5 PROSPECTIVE VALIDATIONS ============= -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-thm mb-3">Standard</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">5 prospective validations + 1 non-scorable case</h2>
      <p class="text-sm text-stone-700 mb-5 max-w-3xl leading-relaxed">
        All the predictions below were recorded in the system
        <strong>before</strong> the corresponding events, and chained by
        SHA-256. The hashes are in <code class="font-mono bg-stone-100 px-1 py-0.5 rounded">verified_log.json</code>
        and <code class="font-mono bg-stone-100 px-1 py-0.5 rounded">prediction_chain.json</code>
        of the PT_SISMO repo (private).
      </p>
      <div class="space-y-4">
        {recentDetections.map((d) => (
          <div class={d.highlight
            ? "rounded-lg border-2 border-emerald-500 bg-emerald-50 p-5 shadow-md"
            : "rounded-lg border-2 border-amber-300 bg-amber-50 p-5"}>
            <div class="flex flex-wrap items-baseline justify-between gap-3 mb-2">
              <h3 class={d.highlight ? "font-sans font-bold text-emerald-900 text-lg" : "font-sans font-semibold text-amber-900 text-lg"}>{d.label}</h3>
              <span class={d.highlight ? "font-mono text-sm text-emerald-700" : "font-mono text-sm text-amber-700"}>{d.date}</span>
            </div>
            <p class={d.highlight ? "text-sm text-emerald-900 leading-relaxed mb-2" : "text-sm text-amber-900 leading-relaxed mb-2"}>{d.detail}</p>
            <p class={d.highlight ? "text-xs font-sans uppercase tracking-wider text-emerald-700 font-bold" : "text-xs font-sans uppercase tracking-wider text-amber-700"}>→ {d.status}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============= LIMITS L2-L3 ============= -->
    <section class="mb-12" data-min-depth="L2">
      <p class="pt-tag pt-tag-id mb-3">Standard · limits</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">Four limits to keep in mind</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {limits.map((l) => (
          <div class="rounded-lg border-2 border-rose-300 bg-rose-50 p-5">
            <h4 class="font-sans font-semibold text-rose-800 mb-2">{l.title}</h4>
            <p class="text-sm text-rose-900 leading-relaxed">{l.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============= TECHNICAL AUDIT ============= -->
    <section class="mb-12" data-min-depth="L3">
      <p class="pt-tag pt-tag-val mb-3">Technical</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">How to audit a PT_SISMO prediction</h2>
      <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
        <ol class="list-decimal pl-5 space-y-3 text-sm text-slate-700 leading-relaxed">
          <li>Each predictive window is written as a canonical snapshot: region, issue date, threshold, active markers and validation horizon.</li>
          <li>The snapshot is serialised then hashed in SHA-256; the current hash includes the previous hash to prevent local rewriting of an older entry.</li>
          <li>Validation compares the observed event with the already chained snapshot: a later entry cannot retroactively produce the earlier signal without breaking the chain.</li>
          <li>The theoretical audit remains distinct from the cryptographic audit: the chain proves anteriority of the announcements, not yet strict derived status of the geophysical bridge.</li>
        </ol>
      </div>
    </section>

    <!-- ============= LINKS ============= -->
    <section class="mb-8">
      <p class="pt-tag pt-tag-bridge mb-3">Going further</p>
      <h2 class="text-3xl font-bold text-thmblue mb-6">Deeper</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <a href="/en/recherches" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Research hub</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">The 3 parallel programmes</h3>
          <p class="text-sm text-slate-700">PT_SISMO in context with biology and SCS.</p>
        </a>
        <a href="/en/theorems/T1" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">Theorem T1</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Forbidden mod 3 transitions</h3>
          <p class="text-sm text-slate-700">The same T1 rule used as the "gap" marker in PT_SISMO.</p>
        </a>
        <a href="/en/theorems/T4" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">Theorem T4</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Spectral convergence</h3>
          <p class="text-sm text-slate-700">The ρ density used by PT_SISMO is the geo analogue of T4 convergence.</p>
        </a>
        <a href="/en/predictions" class="pt-card block group">
          <span class="pt-tag pt-tag-thm">PT predictions</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">28 falsifiable targets</h3>
          <p class="text-sm text-slate-700">PT_SISMO predictions are of the same epistemic order: falsifiable before deadline.</p>
        </a>
        <a href="/en/contact" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Contact</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Request access to the code</h3>
          <p class="text-sm text-slate-700">The private code can be shared under a collaboration agreement.</p>
        </a>
        <a href="/en/critique" class="pt-card block group">
          <span class="pt-tag pt-tag-id">Critique</span>
          <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2 group-hover:underline">Test falsifiability</h3>
          <p class="text-sm text-slate-700">How to formulate a technical objection to the PT_SISMO results.</p>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
