---
import BaseLayout from '@layouts/BaseLayout.astro';
import PeriodicPTExplorer from '@components/PeriodicPTExplorer.astro';
import { readFileSync } from 'node:fs';

type PeriodSegment = {
  type: 's' | 'p' | 'd' | 'f';
  count: number;
};

type PeriodRow = {
  k: number;
  length: number;
  range: string;
  label: string;
  segments: PeriodSegment[];
};

const blocks = [
  {
    name: 's',
    ell: 0,
    orientations: 1,
    capacity: 2,
    shape: 'duet',
    explanation: 'One orientation, two possible spin states.',
    pt: 'spin involution derived from T1',
  },
  {
    name: 'p',
    ell: 1,
    orientations: 3,
    capacity: 6,
    shape: 'triangle',
    explanation: 'Three spatial directions, filled by spin pairs.',
    pt: 'first active prime P1 = 3',
  },
  {
    name: 'd',
    ell: 2,
    orientations: 5,
    capacity: 10,
    shape: 'pentagon',
    explanation: 'Five positions, with half-filled and closed-shell stabilities.',
    pt: 'first active prime P2 = 5',
  },
  {
    name: 'f',
    ell: 3,
    orientations: 7,
    capacity: 14,
    shape: 'heptagon',
    explanation: 'Seven positions, the last active channel in PT geometry.',
    pt: 'first active prime P3 = 7',
  },
];

const periods: PeriodRow[] = [
  { k: 1, length: 2, range: '1-2', label: 'H-He', segments: [{ type: 's', count: 2 }] },
  { k: 2, length: 8, range: '3-10', label: 'Li-Ne', segments: [{ type: 's', count: 2 }, { type: 'p', count: 6 }] },
  { k: 3, length: 8, range: '11-18', label: 'Na-Ar', segments: [{ type: 's', count: 2 }, { type: 'p', count: 6 }] },
  { k: 4, length: 18, range: '19-36', label: 'K-Kr', segments: [{ type: 's', count: 2 }, { type: 'd', count: 10 }, { type: 'p', count: 6 }] },
  { k: 5, length: 18, range: '37-54', label: 'Rb-Xe', segments: [{ type: 's', count: 2 }, { type: 'd', count: 10 }, { type: 'p', count: 6 }] },
  { k: 6, length: 32, range: '55-86', label: 'Cs-Rn', segments: [{ type: 's', count: 2 }, { type: 'f', count: 14 }, { type: 'd', count: 10 }, { type: 'p', count: 6 }] },
  { k: 7, length: 32, range: '87-118', label: 'Fr-Og', segments: [{ type: 's', count: 2 }, { type: 'f', count: 14 }, { type: 'd', count: 10 }, { type: 'p', count: 6 }] },
];

const periodCells = (period: PeriodRow): PeriodSegment['type'][] =>
  period.segments.flatMap((segment) =>
    Array.from({ length: segment.count }, () => segment.type)
  );

const polygonVertices = (count: number, radius = 52, center = 80) =>
  Array.from({ length: count }, (_, index) => {
    const angle = -Math.PI / 2 + (2 * Math.PI * index) / count;
    return {
      x: center + radius * Math.cos(angle),
      y: center + radius * Math.sin(angle),
    };
  });

const polygonPoints = (count: number) =>
  polygonVertices(count)
    .map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`)
    .join(' ');

const spinPair = (
  point: { x: number; y: number },
  offset = 4.6,
  center = 80
) => {
  const dx = point.x - center;
  const dy = point.y - center;
  const norm = Math.hypot(dx, dy) || 1;
  const ux = dx / norm;
  const uy = dy / norm;
  return {
    inner: { x: point.x - ux * offset, y: point.y - uy * offset },
    outer: { x: point.x + ux * offset, y: point.y + uy * offset },
  };
};

const derivationSteps = [
  {
    tag: 'T1',
    title: 'Exclusion',
    plain: 'Inside an atom, electrons do not all pile into the same place. Two electrons can share one place only if they carry opposite spin states.',
    technical: 'T1 forbids self-transitions mod 3: a state cannot copy itself onto itself. The only allowed doubling is the spin involution, hence the factor 2.',
  },
  {
    tag: 'C1',
    title: 'Orientations',
    plain: 'Electron places are not all of the same kind. Some are simple, while others split into 3, 5, or 7 possible directions.',
    technical: 'For an orbital index ℓ, magnetic values run from -ℓ to +ℓ. This gives 2ℓ+1 discrete positions: 1, 3, 5, 7 for s, p, d, f.',
  },
  {
    tag: 'DER',
    title: 'Capacities',
    plain: 'Each direction can host two electrons, one for each spin. This is why the s, p, d, and f families hold 2, 6, 10, and 14 electrons.',
    technical: 'Each position can host two opposite spins. The capacity is therefore Cap(ℓ)=2(2ℓ+1), directly producing 2, 6, 10, 14.',
  },
  {
    tag: 'THM',
    title: 'Four blocks',
    plain: 'The periodic table can then be read as a filling map: rows are shells, and the large blocks show which family of places is being filled.',
    technical: 'Depth D=2 gives four orbital types, the V4 group. The next step would require 9 or p=11, but 9 is composite and p=11 remains in echo.',
  },
];

const beginnerConcepts = [
  {
    title: 'An atom',
    text: 'An atom contains a positively charged nucleus and electrons around it. Chemistry mostly comes from how those electrons are distributed.',
  },
  {
    title: 'A shell',
    text: 'A shell is an energy level. When a new row of the periodic table begins, a new shell starts receiving electrons.',
  },
  {
    title: 'An orbital',
    text: 'An orbital is not a tiny planetary orbit. It is an allowed shape of electron presence around the nucleus.',
  },
  {
    title: 's, p, d, f',
    text: 'These letters name four orbital families. When full, they contain respectively 2, 6, 10, and 14 electrons.',
  },
  {
    title: 'Spin',
    text: 'Spin acts like an internal polarity. The same place can host two electrons only if their spin states are opposite.',
  },
  {
    title: 'The PT reading',
    text: 'PT does not replace the basic chemical map. It asks why that map has exactly these blocks, sizes, and exceptions.',
  },
];

const comparisonRows = [
  {
    topic: 'Pauli',
    standard: 'A quantum principle imposed on electrons.',
    pt: 'Exclusion derived from T1: the spin involution gives the factor 2.',
  },
  {
    topic: 'Capacities',
    standard: 'Subshells contain 2, 6, 10, or 14 electrons.',
    pt: 'Capacity forced by 2(2ℓ+1), with 2ℓ+1 = 1, 3, 5, 7.',
  },
  {
    topic: 'Madelung',
    standard: 'Empirical n+l rule, then n.',
    pt: 'Filling order motivated by the decreasing master function of the sieve.',
  },
  {
    topic: 'Cr, Cu, Pd, Au',
    standard: 'Anomalous configurations memorized as exceptions.',
    pt: 'd5/d10 informational stabilities of the Z/10Z pentagon.',
  },
  {
    topic: 'Lanthanides / actinides',
    standard: 'Rows separated below the table for readability.',
    pt: 'Buried f channel: s -> f -> d -> p when P3 = 7 opens.',
  },
  {
    topic: 'No g block',
    standard: 'Observed absence beyond the known stable domain.',
    pt: '9 = 3^2 is composite and p=11 remains in echo below threshold.',
  },
];

const shellFamilies = [
  {
    periods: '1',
    sequence: ['s2'],
    length: 2,
    interpretation: 'The minimal shell closes only the spin-orbital s channel.',
  },
  {
    periods: '2-3',
    sequence: ['s2', 'p6'],
    length: 8,
    interpretation: 'First complete chemical motif: s opening, p closure.',
  },
  {
    periods: '4-5',
    sequence: ['s2', 'd10', 'p6'],
    length: 18,
    interpretation: 'The d pentagon appears between the s opening and the p closure.',
  },
  {
    periods: '6-7',
    sequence: ['s2', 'f14', 'd10', 'p6'],
    length: 32,
    interpretation: 'The f channel is buried before the d return, then the p closure.',
  },
];

const promotions = [
  { z: 24, symbol: 'Cr', aufbau: 'd4s2', pt: 'd5s1', reason: 'half filling' },
  { z: 29, symbol: 'Cu', aufbau: 'd9s2', pt: 'd10s1', reason: 'closure' },
  { z: 41, symbol: 'Nb', aufbau: 'd3s2', pt: 'd4s1', reason: 'near half filling' },
  { z: 42, symbol: 'Mo', aufbau: 'd4s2', pt: 'd5s1', reason: 'half filling' },
  { z: 44, symbol: 'Ru', aufbau: 'd6s2', pt: 'd7s1', reason: 'post half filling' },
  { z: 45, symbol: 'Rh', aufbau: 'd7s2', pt: 'd8s1', reason: 'post half filling' },
  { z: 46, symbol: 'Pd', aufbau: 'd8s2', pt: 'd10s0', reason: 'double closure' },
  { z: 47, symbol: 'Ag', aufbau: 'd9s2', pt: 'd10s1', reason: 'closure' },
  { z: 78, symbol: 'Pt', aufbau: 'd8s2', pt: 'd9s1', reason: 'near closure' },
  { z: 79, symbol: 'Au', aufbau: 'd9s2', pt: 'd10s1', reason: 'closure' },
  { z: 111, symbol: 'Rg', aufbau: 'd9s2', pt: 'd10s1', reason: 'relativistic closure' },
];

const codeLinks = [
  {
    fn: 'period(Z)',
    meaning: 'recovers the period from L(k) = 2 ceil(k/2)^2',
    file: 'PT_PROJECTS/PTC/ptc/periodic.py:13',
  },
  {
    fn: 'l_of(Z)',
    meaning: 'assigns the s, p, d, or f block from the position in the period',
    file: 'PT_PROJECTS/PTC/ptc/periodic.py:31',
  },
  {
    fn: 'capacity(Z)',
    meaning: 'returns 2, 6, 10, or 14 from 2(2ℓ+1)',
    file: 'PT_PROJECTS/PTC/ptc/periodic.py:115',
  },
  {
    fn: 'n_fill(Z)',
    meaning: 'adds the d5/d10 informational promotions',
    file: 'PT_PROJECTS/PTC/ptc/periodic.py:75',
  },
];

const periodicSourcePath = 'public/scripts-source/ptc/periodic.py';
const periodicSource = readFileSync(
  new URL('../../../public/scripts-source/ptc/periodic.py', import.meta.url),
  'utf-8'
);
const periodicLineCount = periodicSource.trimEnd().split('\n').length;
---

<BaseLayout
  title="The periodic table derived by PT"
  description="A rigorous and accessible PT derivation of the periodic table: s/p/d/f blocks, period lengths, no g shell, and configuration anomalies."
>
  <section class="border-b border-stone-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
      <div class="grid lg:grid-cols-[1fr_1.05fr] gap-10 items-center">
        <div>
          <p class="font-sans text-sm font-semibold uppercase tracking-wider text-derorange mb-3">
            PT chemistry / executable derivation
          </p>
          <p class="pt-tag pt-tag-id mb-4">First robust demonstration</p>
          <h1 class="text-4xl md:text-5xl font-bold text-thmblue leading-tight mb-5">
            Why does the periodic table have this shape?
          </h1>
          <p data-max-depth="L1" class="text-lg md:text-xl text-stone-700 leading-relaxed">
            The periodic table arranges atoms according to how their electrons
            fill places around the nucleus. At the plain-language level, the
            key idea is simple: electrons do not sit anywhere at random. They
            fill shells, then families of places called <code>s</code>,
            <code>p</code>, <code>d</code>, and <code>f</code>. PT proposes a
            structural reason for that organization.
          </p>
          <p data-min-depth="L2" class="text-lg md:text-xl text-stone-700 leading-relaxed">
            In PT, the table of elements is not an empirical catalogue:
            its shape follows from a short chain. Spin gives the factor 2,
            orientations give 1, 3, 5, 7, and capacities become
            2, 6, 10, 14. From there, the blocks, periods, and several
            configuration anomalies fall into place together.
          </p>
          <div class="mt-6 flex flex-wrap gap-2 font-sans text-xs">
            <span class="pt-tag pt-tag-thm">THM</span>
            <span class="pt-tag pt-tag-der">DER</span>
            <span class="pt-tag pt-tag-val">PTC code</span>
            <span class="pt-tag pt-tag-pred">No g-shell</span>
          </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-stone-200 bg-stone-50">
          <div class="grid grid-cols-4 min-h-[260px]">
            {blocks.map((block) => (
              <div class={`periodic-block periodic-block-${block.name}`}>
                <div class="font-sans text-xs uppercase tracking-wider text-stone-500">
                  block
                </div>
                <div class="text-5xl md:text-6xl font-bold text-stone-900 mt-1">
                  {block.name}
                </div>
                <div class="mt-4 orbital-sketch" aria-hidden="true">
                  {Array.from({ length: block.orientations }).map((_, index) => (
                    <span style={`--i:${index}; --n:${block.orientations}`}></span>
                  ))}
                </div>
                <div class="mt-4 font-sans text-sm text-stone-700">
                  <strong>{block.orientations}</strong> orientations
                </div>
                <div class="font-sans text-sm text-stone-700">
                  capacity <strong>{block.capacity}</strong>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section data-max-depth="L1" class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid lg:grid-cols-[0.72fr_1.28fr] gap-8 items-start">
      <div>
        <p class="font-sans text-sm font-semibold uppercase tracking-wider text-derorange mb-3">
          Plain language
        </p>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          Before reading the table
        </h2>
        <p class="text-stone-700 leading-relaxed">
          If you know no chemistry, start here. The periodic table is not just
          a list of symbols: it is a map of electron filling. Each element adds
          one more electron, and that electron must find an allowed place.
        </p>
        <p class="mt-4 text-stone-700 leading-relaxed">
          What PT tries to explain is not merely that this map exists, but why
          it repeats the same sizes: <code>2</code>, <code>6</code>,
          <code>10</code>, <code>14</code>, then the long rows
          <code>2</code>, <code>8</code>, <code>18</code>, <code>32</code>.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {beginnerConcepts.map((concept) => (
          <article class="pt-card">
            <h3 class="font-sans text-lg font-bold text-thmblue mb-2">{concept.title}</h3>
            <p class="text-stone-700 leading-relaxed">{concept.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-4 gap-4">
      {derivationSteps.map((step, index) => (
        <article class="pt-card">
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="pt-tag pt-tag-thm">{step.tag}</span>
            <span class="font-sans text-sm text-stone-400">0{index + 1}</span>
          </div>
          <h2 class="font-sans text-xl font-bold text-thmblue mb-3">{step.title}</h2>
          <p data-max-depth="L1" class="text-stone-700 leading-relaxed">{step.plain}</p>
          <p data-min-depth="L2" class="text-stone-700 leading-relaxed">{step.technical}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 grid lg:grid-cols-[0.78fr_1.22fr] gap-8 items-start">
      <div>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          Why this is a good first demonstration
        </h2>
        <p class="text-stone-700 leading-relaxed mb-4">
          The periodic table is familiar, visual, and highly constrained.
          That is exactly what a theory needs for an early test: PT cannot
          freely choose the blocks, capacities, or period lengths.
        </p>
        <p class="text-stone-700 leading-relaxed">
          The strength of this page is therefore rigidity: the numbers
          <code> 2, 6, 10, 14</code> come from
          <code> 2(2ℓ+1)</code>, the periods
          <code> 2, 8, 8, 18, 18, 32, 32</code> come from
          <code> L(k)=2⌈k/2⌉²</code>, and then
          <code> d5/d10</code> anomalies and the absence of a
          <code> g</code> block become secondary tests.
        </p>
      </div>
      <div class="bg-white border border-stone-200 rounded-lg overflow-hidden">
        <table>
          <thead class="font-sans bg-stone-50">
            <tr>
              <th>Step</th>
              <th>What is forced</th>
              <th>Chemical result</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Orientations</td>
              <td><code>2ℓ+1 = 1,3,5,7</code></td>
              <td>s, p, d, f blocks</td>
            </tr>
            <tr>
              <td>Spin</td>
              <td><code>2(2ℓ+1)</code></td>
              <td>capacities 2, 6, 10, 14</td>
            </tr>
            <tr>
              <td>Depth</td>
              <td><code>s → p → d → f</code></td>
              <td>periods 2, 8, 18, 32</td>
            </tr>
            <tr>
              <td>Stabilities</td>
              <td><code>d5</code> and <code>d10</code></td>
              <td>Cr, Cu, Pd, Ag, Au...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-12">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-8 items-start">
      <div>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          From known rules to structural causes
        </h2>
        <p class="text-stone-700 leading-relaxed">
          This page does not introduce a new nomenclature to memorize.
          It starts from the usual objects of quantum chemistry and shows
          how PT turns empirical rules into structural consequences.
        </p>
      </div>

      <div class="overflow-x-auto border border-stone-200 rounded-lg bg-white">
        <table>
          <thead class="font-sans bg-stone-50">
            <tr>
              <th>Chemical object</th>
              <th>Usual formulation</th>
              <th>PT reading</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <td class="font-sans font-semibold text-stone-900">{row.topic}</td>
                <td>{row.standard}</td>
                <td>{row.pt}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-12">
    <div class="grid lg:grid-cols-[0.52fr_1.48fr] gap-8 items-start">
      <div>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          Seeing channels as polygons
        </h2>
        <p class="text-stone-700 leading-relaxed">
          The drawing is not a picture of an orbital in space. It is a
          discrete map of the PT channel: the circle marks the channel,
          each vertex represents an available orientation, and spin doubles
          each vertex.
        </p>
        <p data-min-depth="L3" class="mt-4 font-sans text-sm text-stone-600 leading-relaxed">
          Technical reading: the channels live on the circles
          <code>Z/(2P_l)Z</code>. The active primes
          <code>3, 5, 7</code> give the triangle, pentagon, and
          heptagon; the <code>s</code> case is the minimal channel,
          one orientation doubled by spin.
        </p>
      </div>

      <div class="polygon-grid">
        {blocks.map((block) => {
          const vertices = polygonVertices(block.orientations);
          const isPolygon = block.orientations > 2;
          return (
            <article class={`polygon-card polygon-card-${block.name}`}>
              <svg viewBox="0 0 160 160" role="img" aria-label={`Channel ${block.name}: ${block.orientations} orientations, capacity ${block.capacity}`}>
                <circle class="orbital-ring" cx="80" cy="80" r="52" />
                {isPolygon && <polygon class="polygon-face" points={polygonPoints(block.orientations)} />}
                {block.orientations === 1 && (
                  <>
                    <line class="polygon-axis" x1="28" y1="80" x2="132" y2="80" />
                    <circle class="polygon-node" cx="28" cy="80" r="10" />
                    <circle class="polygon-node" cx="132" cy="80" r="10" />
                    <circle class="spin-dot spin-dot-b" cx="28" cy="80" r="4.2" />
                    <circle class="spin-dot spin-dot-a" cx="132" cy="80" r="4.2" />
                  </>
                )}
                {block.orientations > 1 && vertices.map((point) => {
                  const spins = spinPair(point);
                  return (
                    <g>
                      <circle class="polygon-node" cx={point.x} cy={point.y} r="10" />
                      <circle class="spin-dot spin-dot-b" cx={spins.inner.x} cy={spins.inner.y} r="3.4" />
                      <circle class="spin-dot spin-dot-a" cx={spins.outer.x} cy={spins.outer.y} r="3.4" />
                    </g>
                  );
                })}
              </svg>
              <div>
                <h3>block {block.name}</h3>
                <p>
                  {block.orientations} orientation{block.orientations > 1 ? 's' : ''}
                  {' '}x 2 spins = <strong>{block.capacity}</strong>
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <div data-min-depth="L3" class="polygon-stability">
      <div>
        <h3>Why the pentagon explains d anomalies</h3>
        <p>
          In the <code>d</code> channel, five orientations form the
          <code>Z/10Z</code> pentagon after spin doubling. The
          <code>d5</code> and <code>d10</code> configurations then become
          two special positions: half filling and closure. That is why
          Cr, Cu, Mo, Pd, Ag, or Au are not merely exceptions to memorize.
        </p>
      </div>
      <div class="pentagon-states" aria-label="Half filling and closure of the d channel">
        {[
          { label: 'd5', filled: 5 },
          { label: 'd10', filled: 10 },
        ].map((state) => {
          const vertices = polygonVertices(5, 42, 62);
          return (
            <figure>
              <svg viewBox="0 0 124 124" role="img" aria-label={`State ${state.label}`}>
                <circle class="orbital-ring" cx="62" cy="62" r="42" />
                <polygon class="polygon-face" points={vertices.map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(' ')} />
                {vertices.map((point) => {
                  const spins = spinPair(point, 4, 62);
                  return (
                    <g>
                      <circle class="polygon-node" cx={point.x} cy={point.y} r="9" />
                      <circle class={state.filled >= 5 ? 'spin-dot spin-dot-filled' : 'spin-dot'} cx={spins.inner.x} cy={spins.inner.y} r="3.2" />
                      <circle class={state.label === 'd10' ? 'spin-dot spin-dot-filled' : 'spin-dot'} cx={spins.outer.x} cy={spins.outer.y} r="3.2" />
                    </g>
                  );
                })}
              </svg>
              <figcaption>{state.label}</figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-stone-100 border-y border-stone-200">
    <div class="max-w-6xl mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-[0.75fr_1.25fr] gap-8 items-start">
        <div>
          <h2 class="text-3xl font-bold text-thmblue mb-4">
            The formula that makes periods
          </h2>
          <p class="text-stone-700 leading-relaxed">
            The length of period number $k$ is given by
            $L(k) = 2\lceil k/2\rceil^2$. It directly produces
            the observed sequence up to 118 elements.
          </p>
          <div data-min-depth="L3" class="mt-5 bg-white border border-stone-200 rounded-lg p-4 font-sans text-sm text-stone-700">
            Monograph source: <code>chapters_fr/ch22_chemistry.tex</code>,
            period-length section. PTC implements it in
            <code>period(Z)</code> as <code>cap = 2 * k * k</code> with
            <code>k = per // 2 + 1</code>.
          </div>
        </div>

