---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import SubProjects from '@components/SubProjects.astro';
import Citation from '@components/Citation.astro';

const primaryLinks = [
  { href: '/en/essays/idea-5min', label: 'The idea in 5 minutes', tone: 'primary' as const },
  { href: '/en/commencer-ici', label: 'Start here', tone: 'outline' as const },
  { href: '/en/premier-principe', label: 'Fundamental principle', tone: 'outline' as const },
  { href: '/en/resultats', label: 'Results dashboard', tone: 'soft' as const },
  { href: '/en/predictions', label: 'Predictions', tone: 'soft' as const },
];

const readingPath = [
  {
    step: '01',
    title: 'Principle',
    href: '/en/premier-principe',
    text: 'Total distinction partitions into persistent structure and entropic dispersion.',
  },
  {
    step: '02',
    title: 'Sieve',
    href: '/en/theorems',
    text: 'The survivors of the sieve provide an exact laboratory for reading constraint.',
  },
  {
    step: '03',
    title: 'Attractor',
    href: '/en/big-bang',
    text: 'After 2 crystallises, the cascade slides toward the reduced attractor μ* = 15.',
  },
  {
    step: '04',
    title: 'Derivations',
    href: '/en/observables',
    text: 'Physical and chemical observables are derived without continuously fitted parameters, with explicit statuses.',
  },
  {
    step: '05',
    title: 'Validation',
    href: '/en/statuts-resultats',
    text: 'Each result receives a status: theorem, bridge, derivation, validation, or prediction.',
  },
];

const plainScenes = [
  {
    title: 'A constraint acts',
    text: 'The theory starts from a minimal situation: something is placed under constraint, and that constraint forces a separation.',
  },
  {
    title: 'Survivors appear',
    text: 'What does not cross the constraint disperses; what does cross it keeps a readable identity.',
  },
  {
    title: 'Measurement becomes possible',
    text: 'Observables are no longer fitted knobs: they measure the persistent part, the dispersed part, and their modes of coupling.',
  },
];

const domainCards = [
  {
    href: '/en/theorems',
    tag: 'Mathematics',
    tagClass: 'pt-tag-thm',
    title: 'The persistence points',
    text: 'Survivors, gaps, GFT, and theorems show how a constraint produces stable structures.',
  },
  {
    href: '/en/big-bang',
    tag: 'Cosmogony',
    tagClass: 'pt-tag-bridge',
    title: 'The primordial cascade',
    text: 'The crystallisation of 2, the emergence of time, and μ* = 15 are presented as an instantaneous hierarchy.',
  },
  {
    href: '/en/observables',
    tag: 'Physics',
    tagClass: 'pt-tag-der',
    title: 'The principle tested',
    text: 'Couplings, masses, angles, time, and geometry compare persistent structures with measurements.',
  },
  {
    href: '/en/tableau-periodique',
    tag: 'Chemistry',
    tagClass: 'pt-tag-id',
    title: 'Shell persistence',
    text: 'The sequence 2, 8, 8, 18, 18, 32, 32 follows from channels, spin doubling, and internal shells.',
  },
];

const auditCards = [
  {
    tag: 'L0 / GFT',
    title: 'Conservation principle',
    text: 'Total informational capacity partitions into KL divergence and entropy: Hmax = DKL + H.',
  },
  {
    tag: 'T0 → T6',
    title: 'Demonstrative chain',
    text: 'Each step must be followed as a status transition: theorem, bridge, derivation, validation, or prediction.',
  },
  {
    tag: 'Scripts',
    title: 'Reproducibility',
    text: 'The companion scripts check the flagship calculations and expose points still dependent on a bridge.',
  },
];

const groupedLinks = [
  {
    title: 'Read',
    links: [
      ['/en/questions-fondamentales', 'Fundamental questions'],
      ['/en/limites', 'Limits'],
      ['/en/monograph', 'Monograph EN/FR'],
    ],
  },
  {
    title: 'Verify',
    links: [
      ['/en/scripts', 'Scripts'],
      ['/en/preuve-interactive', 'Interactive proof'],
      ['/en/difficile-a-rejeter', 'Hard to dismiss'],
    ],
  },
  {
    title: 'Explore',
    links: [
      ['/en/temps', 'Time'],
      ['/en/relativite', 'Relativity'],
      ['/en/gravite-quantique', 'Quantum gravity'],
      ['/en/nucleaire', 'Nuclear'],
      ['/en/cosmologie', 'Cosmology'],
    ],
  },
  {
    title: 'Chemistry',
    links: [
      ['/en/energies-ionisation', 'Ionization energies'],
      ['/en/affinites-electroniques', 'Electron affinities'],
      ['/en/demonstration-tableau-periodique', 'Periodic-table demonstration'],
    ],
  },
];

---

<BaseLayout>
  <PageHero
    eyebrow="Plain · open preprint"
    domain="meta"
    title="The Theory of Persistence"
    kicker={`When a system passes through a constraint,\nwhat disperses — what persists?`}
    epigraphL1="Everything says what it is by revealing what it no longer has. Reality exists in the cone of uncertainty between addition and multiplication."
    epigraphL2="Everything says what it is (its additive position) by revealing what it no longer has (its deferred factorisation — what was dispersed). Reality exists in the cone of uncertainty between addition and multiplication; the primes are the fixed points of that tension."
    epigraphL3={`Everything says what it is (its additive position) by revealing what it no longer has (its deferred factorisation — what was dispersed). Reality exists in the cone of uncertainty between the additive structure (Σ ℤ) and the multiplicative structure (Π primes); the PT sieve identifies the fixed points, and the active backbone {2, 3, 5, 7, 11, 13} is its observable signature.`}
    dekL1="Persistence Theory (PT) starts from a simple idea: when a constraint acts, not everything disappears. One part disperses as entropy; another crosses the constraint and becomes structure. What persists is not what is strongest. It is what is most compatible with the logic of the filter. Persistence is not a victory. It is an agreement. Form is not decoration: it is the structure made visible by constraint. Observables measure that distribution."
    dekL2="Persistence Theory (PT) starts from a simple idea: under constraint, one part disperses as entropy while another persists as structure. What persists is not what is strongest. It is what is most compatible with the logic of the filter. Persistence is not a victory. It is an agreement. Form is not decoration: it is the structure made visible by constraint. That idea unfolds as a chain: informational conservation principle, sieve dynamics, crystallisation of 2, slide toward the reduced attractor μ* = 15, then derivation of observables with explicit epistemic status."
    oneLineNote={{ label: 'In one sentence', body: 'persisting does not mean remaining by inertia; it means surviving an admissible constraint without losing structural identity.' }}
    technicalNote={{ label: 'Technical reading', body: 'do not read this page as one global proof, but as an audit map. Theorems, bridges, physical derivations, validations, and predictions do not carry the same status.' }}
    actions={primaryLinks}
  />

  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14">

    <!-- PT symbol -->
    <section class="mb-10 grid md:grid-cols-[260px_1fr] gap-6 md:gap-10 items-center">
      <div class="flex justify-center md:justify-start">
        <img src="/pt-symbol.svg" alt="PT symbol — graph T³ = Z/3Z × Z/5Z × Z/7Z with s = 1/2 core" width="240" height="240" class="w-full max-w-[240px]" />
      </div>
      <div>
        <p class="pt-tag pt-tag-id mb-3">The symbol</p>
        <h2 class="text-2xl md:text-3xl font-bold text-thmblue mb-3">All of PT in one figure</h2>
        <p class="text-slate-700 leading-relaxed mb-3">
          At the center, a <span class="font-semibold" style="color:#d4a017">yellow</span> disc:
          the <em>s = 1/2</em> core, the unique input parameter. Around it, three
          concentric layers of nodes — <span class="font-semibold" style="color:#cb181a">3 red</span> (Z/3Z, primordial cascade),
          <span class="font-semibold" style="color:#009640">5 green</span> (Z/5Z, refinement),
          <span class="font-semibold" style="color:#008eb4">7 blue</span> (Z/7Z, fine filter) — outlining
          the torus <span class="font-mono text-sm">T³ = Z/3Z × Z/5Z × Z/7Z</span> on which the
          entire PT derivation lives.
        </p>
        <p class="text-slate-700 leading-relaxed mb-3">
          Each sphere stands for a <strong>discrete stable state</strong>: a site
          that has survived the period-<em>p</em> filter, a discrete remnant of an
          underlying continuum. PT does not invent the nodes — it reveals those
          the constraint allows, and explains why only those sites can carry
          observable structure.
        </p>
        <p class="text-sm text-slate-600 leading-relaxed">
          The golden glow emanating from the center signals that everything —
          chemistry, physics, observables, predictions — descends from this core,
          transmitted by the successive filters out to the periphery.
        </p>
      </div>
    </section>

    <!-- Depth notice -->
    <aside class="mb-10 rounded-lg border border-thmblue/20 bg-thmblue/5 p-4 md:p-5">
      <p class="text-sm text-slate-700 leading-relaxed">
        <span class="font-sans font-semibold text-thmblue">Three reading levels.</span>
        The site exists at three depths —
        <strong>Plain</strong> (accessible introduction),
        <strong>Standard</strong> (the main chain),
        <strong>Technical</strong> (sources, derivations, equations).
        The selector in the bottom-right ↘ lets you switch at any time;
        some sections only appear from a given level upward.
      </p>
    </aside>

    <section class="mb-12">
      <p class="pt-tag pt-tag-id mb-3">Plain</p>
      <h2 class="text-3xl md:text-4xl font-bold text-thmblue mb-6">
        The idea in three scenes
      </h2>
      <div class="grid md:grid-cols-3 gap-4">
        {plainScenes.map((scene, index) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="font-mono text-sm text-derorange">0{index + 1}</span>
            <h3 class="mt-2 mb-2 font-sans text-xl font-bold text-thmblue">{scene.title}</h3>
            <p class="text-sm text-slate-700 leading-relaxed">{scene.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12" data-min-depth="L2">
      <div class="max-w-3xl mb-6">
        <p class="pt-tag pt-tag-thm mb-3">Standard</p>
        <h2 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">
          Read the theory as a chain, not as a catalogue
        </h2>
        <p class="text-slate-700 leading-relaxed">
          Order matters: informational conservation, sieve dynamics, attractor
          selection, numerical derivations, then epistemic audit. That thread
          keeps intuition, theorem, physical bridge, and validation separate.
        </p>
      </div>
      <div class="grid md:grid-cols-5 gap-3">
        {readingPath.map((item) => (
          <a href={item.href} class="group rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:border-thmblue/40 hover:shadow-md transition">
            <span class="text-sm font-mono text-derorange">{item.step}</span>
            <h3 class="mt-2 mb-2 font-sans text-lg font-bold text-thmblue group-hover:underline">
              {item.title}
            </h3>
            <p class="text-sm text-slate-700 leading-relaxed">{item.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="grid lg:grid-cols-[0.92fr_1.08fr] gap-8 items-start mb-12" data-min-depth="L2">
      <div>
        <p class="pt-tag pt-tag-id mb-3">Standard</p>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          One constraint, several registers
        </h2>
        <p class="text-slate-700 leading-relaxed mb-4">
          In mathematics, persistence appears in the sieve of Eratosthenes:
          primes are the irreducible survivors of the additive-multiplicative
          coupling, where the multiplicative constraint eliminates composites
          while additive progression reveals the dynamical trace of the
          survivors through prime gaps.
        </p>
        <p class="text-slate-700 leading-relaxed mb-4">
          In PT, a prime is also a discrete resonance point of the sieve: it
          indexes a persistence mode. The cyclic phase associated with that
          prime gives an amplitude; compared with the persistence threshold,
          that amplitude fixes its status: boundary, active, echo, or
          super-echo.
        </p>
        <p class="text-slate-700 leading-relaxed">
          In physics and chemistry, the question becomes riskier: are
          persistent structures sufficient to reconstruct constants, masses,
          geometry, shells, ionization energies, and electron affinities? The
          site separates what is proved, derived, validated, and still open.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {domainCards.map((card) => (
          <a href={card.href} class="pt-card block group">
            <span class:list={['pt-tag', card.tagClass]}>{card.tag}</span>
            <h3 class="font-sans font-semibold text-thmblue text-xl mt-3 mb-2 group-hover:underline">
              {card.title}
            </h3>
            <p class="text-sm text-stone-700 leading-relaxed">{card.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section data-min-depth="L3" class="mb-12">
      <p class="pt-tag pt-tag-val mb-3">Technical</p>
      <h2 class="text-3xl font-bold text-thmblue mb-4">First audit handles</h2>
      <p class="text-slate-700 leading-relaxed mb-5 max-w-3xl">
        The technical depth of the index exposes what should be checked before
        judging the theory: informational conservation, the T0 → T6 chain,
        bridge status, and numerical reproducibility.
      </p>
      <div class="grid md:grid-cols-3 gap-4 mb-5">
        {auditCards.map((card) => (
          <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
            <span class="pt-tag pt-tag-val">{card.tag}</span>
            <h3 class="font-sans font-semibold text-thmblue text-lg mt-3 mb-2">{card.title}</h3>
            <p class="text-sm text-slate-700 leading-relaxed">{card.text}</p>
          </div>
        ))}
      </div>
      <div class="bg-stone-50 border border-stone-300 rounded-lg p-5 text-sm">
        <p class="text-xs font-sans text-stone-500 uppercase tracking-wider mb-2">Technical note</p>
        <p class="text-stone-700 leading-relaxed">
          The formal framework comprises base bridge axioms (BA0–BA2) that
          identify the dynamical field with the gaps between consecutive primes,
          then derived bridges (BA3–BA5) promoted or constrained in the chain,
          and a cascade of seven theorems (T0 → T6) deriving the holonomy angles
          sin²(θ_p) = δ_p(2 − δ_p) and the anomalous dimensions γ_p, and theorem
          T5 establishing the reduced attractor μ* = 15 by exact rational exhaustion. The
          identity log₂(m) = D_KL(P‖U_m) + H(P) (GFT) is the
          <strong>fundamental principle of persistence</strong>: total informational
          capacity is conserved and partitions exactly into persistence and
          entropy.
        </p>
      </div>
    </section>

    <section class="grid md:grid-cols-4 gap-4 mb-12" data-min-depth="L2">
      {groupedLinks.map((group) => (
        <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <h2 class="font-sans font-bold text-thmblue mb-3">{group.title}</h2>
          <div class="space-y-2">
            {group.links.map(([href, label]) => (
              <a href={href} class="block text-sm text-slate-700 hover:text-thmblue hover:underline">
                {label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <div class="grid md:grid-cols-3 gap-4 text-sm mb-10" data-min-depth="L2">
      <div class="pt-card">
        <span class="pt-tag pt-tag-thm">Theorems</span>
        <p class="mt-2 text-stone-700">
          T0 → T6, GFT, L0 — complete chain, zero drift across versions.
        </p>
      </div>
      <div class="pt-card">
        <span class="pt-tag pt-tag-der">Derivations</span>
        <p class="mt-2 text-stone-700">
          43 observables, mean error 0.30%, median 0.06%, zero fit.
        </p>
      </div>
      <div class="pt-card">
        <span class="pt-tag pt-tag-val">Verification</span>
        <p class="mt-2 text-stone-700">
          Canonical registry: 45 companion script entries, 2,522/2,523 passing checks — flagship scripts runnable in the browser.
        </p>
      </div>
    </div>

    <SubProjects lang="en" />

    <Citation lang="en" />

    <p class="mt-12 text-sm text-stone-500 italic font-sans">
      Preprint — not peer-reviewed. Critical scrutiny is welcomed.
    </p>
  </main>
</BaseLayout>
