---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Tag from '@components/Tag.astro';

const VISIBLE_SLUGS = new Set<string>();
const items = (await getCollection('articles', ({ data }) =>
    data.lang === 'en' && VISIBLE_SLUGS.has(data.slug)))
  .sort((a, b) => a.data.order - b.data.order);

const domainLabel: Record<string, string> = {
  math: 'Mathematics',
  physics: 'Physics',
  chemistry: 'Chemistry',
  biology: 'Biology',
  cosmology: 'Cosmology',
  geophysics: 'Geophysics',
};
---

<BaseLayout title="Thematic articles">
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-thmblue mb-3">
      Thematic articles
    </h1>
    <p class="text-stone-700 mb-8 max-w-3xl">
      A selection of research articles from the PT programme.
      Each applies the PT framework to a specific domain with empirical
      validation or falsifiable prediction.
    </p>

    <div class="grid md:grid-cols-2 gap-4">
      {items.map(art => (
        <a href={`/en/articles/${art.data.slug}`} class="pt-card block group">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="text-xs font-sans text-stone-500 uppercase tracking-wider">
              {domainLabel[art.data.domain]}
            </div>
            <Tag level={art.data.status} />
          </div>
          <h2 class="font-sans font-semibold text-base text-thmblue group-hover:underline mb-2">
            {art.data.title}
          </h2>
          <p class="text-sm text-stone-700">{art.data.abstract}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
