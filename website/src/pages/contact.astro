---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import { REPO_ISSUES, REPO_URL } from '@/lib/repo';

const email = 'yan.senez@protonmail.com';

const formspreeId = 'xpqbzbvl';
const formAction = `https://formspree.io/f/${formspreeId}`;
---

<BaseLayout title="Contact">
  <PageHero
    width="narrow"
    eyebrow="Contact"
    domain="meta"
    tone="simple"
    title="Contact"
    dek="Pour toute question, remarque, signalement d’erreur ou demande de collaboration, plusieurs canaux sont à votre disposition selon la nature du message."
  />

  <section class="max-w-3xl mx-auto px-4 py-12">

    <div class="grid md:grid-cols-2 gap-4 mb-10">
      <a
        href={`mailto:${email}?subject=${encodeURIComponent('[PT] ')}`}
        class="pt-card block group"
      >
        <div class="text-xs font-sans text-stone-500 uppercase tracking-wider mb-2">
          Email direct
        </div>
        <h2 class="font-sans font-semibold text-thmblue mb-2 group-hover:underline">
          {email}
        </h2>
        <p class="text-sm text-stone-700">
          Pour les échanges privés, propositions de collaboration, ou questions
          générales sur la théorie.
        </p>
      </a>

      <a
        href={REPO_ISSUES}
        class="pt-card block group"
        rel="noopener"
      >
        <div class="text-xs font-sans text-stone-500 uppercase tracking-wider mb-2">
          GitHub Issues
        </div>
        <h2 class="font-sans font-semibold text-thmblue mb-2 group-hover:underline">
          Signaler une erreur ou suggérer une correction
        </h2>
        <p class="text-sm text-stone-700">
          Idéal pour les coquilles, bugs du site, erreurs dans la monographie
          ou les scripts. Trace publique et discussion ouverte.
        </p>
      </a>
    </div>

    <h2 class="text-xl font-semibold text-thmblue mt-10 mb-3 font-sans">Formulaire</h2>
    <p class="text-sm text-stone-700 mb-4">
      Si vous préférez un formulaire, remplissez les champs ci-dessous.
    </p>

    <form
      action={formAction}
      method="POST"
      class="space-y-4 bg-white border border-stone-200 rounded-lg p-6"
    >
      <div>
        <label for="name" class="block text-sm font-semibold text-stone-700 mb-1 font-sans">
          Nom
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-3 py-2 border border-stone-300 rounded focus:outline-none focus:ring-2 focus:ring-thmblue/40"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-stone-700 mb-1 font-sans">
          Email (optionnel pour réponse)
        </label>
        <input
          type="email"
          id="email"
          name="email"
          class="w-full px-3 py-2 border border-stone-300 rounded focus:outline-none focus:ring-2 focus:ring-thmblue/40"
        />
      </div>

      <div>
        <label for="subject" class="block text-sm font-semibold text-stone-700 mb-1 font-sans">
          Sujet
        </label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          value="[PT] "
          class="w-full px-3 py-2 border border-stone-300 rounded focus:outline-none focus:ring-2 focus:ring-thmblue/40"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold text-stone-700 mb-1 font-sans">
          Message
        </label>
        <textarea
          id="message"
          name="body"
          rows="6"
          required
          class="w-full px-3 py-2 border border-stone-300 rounded focus:outline-none focus:ring-2 focus:ring-thmblue/40"
        ></textarea>
      </div>

      <button
        type="submit"
        class="px-5 py-3 bg-thmblue text-white font-sans font-semibold rounded hover:bg-thmblue/90"
      >
        Envoyer
      </button>
    </form>

    <h2 class="text-xl font-semibold text-thmblue mt-12 mb-3 font-sans">Autres ressources</h2>
    <ul class="list-disc list-inside text-stone-700 space-y-1 marker:text-thmblue">
      <li>
        Repo GitHub principal :
        <a href={REPO_URL} class="underline text-thmblue" rel="noopener">{REPO_URL}</a>
      </li>
      <li>
        Tous les repos de l’auteur :
        <a href="https://github.com/Igrekess" class="underline text-thmblue" rel="noopener">github.com/Igrekess</a>
      </li>
    </ul>
  </section>
</BaseLayout>
