---
import BaseLayout from '@layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';

type PeriodSegment = {
  type: 's' | 'p' | 'd' | 'f';
  count: number;
};

type PeriodRow = {
  k: number;
  length: number;
  range: string;
  label: string;
  segments: PeriodSegment[];
};

const blocks = [
  {
    name: 's',
    ell: 0,
    orientations: 1,
    capacity: 2,
    shape: 'duet',
    explanation: 'Une seule orientation, deux spins possibles.',
    pt: 'involution spin issue de T1',
  },
  {
    name: 'p',
    ell: 1,
    orientations: 3,
    capacity: 6,
    shape: 'triangle',
    explanation: 'Trois directions spatiales, remplies par paires de spin.',
    pt: 'premier actif P1 = 3',
  },
  {
    name: 'd',
    ell: 2,
    orientations: 5,
    capacity: 10,
    shape: 'pentagon',
    explanation: 'Cinq positions, avec les stabilités demi-remplie et pleine.',
    pt: 'premier actif P2 = 5',
  },
  {
    name: 'f',
    ell: 3,
    orientations: 7,
    capacity: 14,
    shape: 'heptagon',
    explanation: 'Sept positions, dernier canal actif de la géométrie PT.',
    pt: 'premier actif P3 = 7',
  },
];

const periods: PeriodRow[] = [
  { k: 1, length: 2, range: '1-2', label: 'H-He', segments: [{ type: 's', count: 2 }] },
  { k: 2, length: 8, range: '3-10', label: 'Li-Ne', segments: [{ type: 's', count: 2 }, { type: 'p', count: 6 }] },
  { k: 3, length: 8, range: '11-18', label: 'Na-Ar', segments: [{ type: 's', count: 2 }, { type: 'p', count: 6 }] },
  { k: 4, length: 18, range: '19-36', label: 'K-Kr', segments: [{ type: 's', count: 2 }, { type: 'd', count: 10 }, { type: 'p', count: 6 }] },
  { k: 5, length: 18, range: '37-54', label: 'Rb-Xe', segments: [{ type: 's', count: 2 }, { type: 'd', count: 10 }, { type: 'p', count: 6 }] },
  { k: 6, length: 32, range: '55-86', label: 'Cs-Rn', segments: [{ type: 's', count: 2 }, { type: 'f', count: 14 }, { type: 'd', count: 10 }, { type: 'p', count: 6 }] },
  { k: 7, length: 32, range: '87-118', label: 'Fr-Og', segments: [{ type: 's', count: 2 }, { type: 'f', count: 14 }, { type: 'd', count: 10 }, { type: 'p', count: 6 }] },
];

const periodCells = (period: PeriodRow): PeriodSegment['type'][] =>
  period.segments.flatMap((segment) =>
    Array.from({ length: segment.count }, () => segment.type)
  );

const polygonVertices = (count: number, radius = 52, center = 80) =>
  Array.from({ length: count }, (_, index) => {
    const angle = -Math.PI / 2 + (2 * Math.PI * index) / count;
    return {
      x: center + radius * Math.cos(angle),
      y: center + radius * Math.sin(angle),
    };
  });

const polygonPoints = (count: number) =>
  polygonVertices(count)
    .map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`)
    .join(' ');

const spinPair = (
  point: { x: number; y: number },
  offset = 4.6,
  center = 80
) => {
  const dx = point.x - center;
  const dy = point.y - center;
  const norm = Math.hypot(dx, dy) || 1;
  const ux = dx / norm;
  const uy = dy / norm;
  return {
    inner: { x: point.x - ux * offset, y: point.y - uy * offset },
    outer: { x: point.x + ux * offset, y: point.y + uy * offset },
  };
};

const derivationSteps = [
  {
    tag: 'T1',
    title: 'Exclusion',
    plain: 'Deux électrons ne peuvent pas occuper exactement le même état.',
    technical: "T1 interdit les auto-transitions mod 3 : un état ne peut pas se recopier sur lui-même. La seule duplication autorisée vient d’une involution de spin, d’où le facteur 2.",
  },
  {
    tag: 'C1',
    title: 'Orientations',
    plain: 'Chaque famille orbitale a un nombre déterminé de directions.',
    technical: 'Pour un indice orbital ℓ, les valeurs magnétiques vont de -ℓ à +ℓ. Cela donne 2ℓ+1 positions discrètes : 1, 3, 5, 7 pour s, p, d, f.',
  },
  {
    tag: 'DER',
    title: 'Capacités',
    plain: 'On multiplie les directions par les deux spins.',
    technical: 'Chaque position peut recevoir deux spins opposés. La capacité devient donc Cap(ℓ)=2(2ℓ+1), ce qui produit directement 2, 6, 10, 14.',
  },
  {
    tag: 'THM',
    title: 'Quatre blocs',
    plain: 'Le tableau s’arrête à s, p, d, f pour une raison arithmétique.',
    technical: 'La profondeur D=2 donne quatre types orbitaux, le groupe V4. Le pas suivant demanderait 9 ou p=11, mais 9 est composite et p=11 reste en écho.',
  },
];

const comparisonRows = [
  {
    topic: 'Pauli',
    standard: 'Principe quantique imposé aux électrons.',
    pt: 'Exclusion issue de T1 : une involution de spin donne le facteur 2.',
  },
  {
    topic: 'Capacités',
    standard: 'Les sous-couches contiennent 2, 6, 10, 14 électrons.',
    pt: 'Capacité forcée par 2(2ℓ+1) avec 2ℓ+1 = 1, 3, 5, 7.',
  },
  {
    topic: 'Madelung',
    standard: 'Règle empirique n+l, puis n.',
    pt: 'Ordre de remplissage motivé par la fonction maîtresse décroissante du crible.',
  },
  {
    topic: 'Cr, Cu, Pd, Au',
    standard: 'Configurations anormales mémorisées comme exceptions.',
    pt: 'Stabilités informationnelles d5/d10 du pentagone Z/10Z.',
  },
  {
    topic: 'Lanthanides / actinides',
    standard: 'Lignes séparées sous le tableau pour lisibilité.',
    pt: 'Canal f enfoui : s -> f -> d -> p quand P3 = 7 s ouvre.',
  },
  {
    topic: 'Pas de bloc g',
    standard: 'Absence observée au-delà du domaine stable connu.',
    pt: '9 = 3^2 est composite et p=11 reste en écho sous le seuil.',
  },
];

const shellFamilies = [
  {
    periods: '1',
    sequence: ['s2'],
    length: 2,
    interpretation: 'La couche minimale ferme seulement le canal spin-orbital s.',
  },
  {
    periods: '2-3',
    sequence: ['s2', 'p6'],
    length: 8,
    interpretation: 'Premier motif chimique complet : ouverture s, fermeture p.',
  },
  {
    periods: '4-5',
    sequence: ['s2', 'd10', 'p6'],
    length: 18,
    interpretation: 'Le pentagone d apparaît entre l’ouverture s et la fermeture p.',
  },
  {
    periods: '6-7',
    sequence: ['s2', 'f14', 'd10', 'p6'],
    length: 32,
    interpretation: 'Le canal f s’enfouit avant le retour d, puis la fermeture p.',
  },
];

const promotions = [
  { z: 24, symbol: 'Cr', aufbau: 'd4s2', pt: 'd5s1', reason: 'demi-remplissage' },
  { z: 29, symbol: 'Cu', aufbau: 'd9s2', pt: 'd10s1', reason: 'fermeture' },
  { z: 41, symbol: 'Nb', aufbau: 'd3s2', pt: 'd4s1', reason: 'quasi-demi-remplissage' },
  { z: 42, symbol: 'Mo', aufbau: 'd4s2', pt: 'd5s1', reason: 'demi-remplissage' },
  { z: 44, symbol: 'Ru', aufbau: 'd6s2', pt: 'd7s1', reason: 'post-demi-remplissage' },
  { z: 45, symbol: 'Rh', aufbau: 'd7s2', pt: 'd8s1', reason: 'post-demi-remplissage' },
  { z: 46, symbol: 'Pd', aufbau: 'd8s2', pt: 'd10s0', reason: 'double fermeture' },
  { z: 47, symbol: 'Ag', aufbau: 'd9s2', pt: 'd10s1', reason: 'fermeture' },
  { z: 78, symbol: 'Pt', aufbau: 'd8s2', pt: 'd9s1', reason: 'quasi-fermeture' },
  { z: 79, symbol: 'Au', aufbau: 'd9s2', pt: 'd10s1', reason: 'fermeture' },
  { z: 111, symbol: 'Rg', aufbau: 'd9s2', pt: 'd10s1', reason: 'fermeture relativiste' },
];

const elementSymbols = [
  '', 'H', 'He', 'Li', 'Be', 'B', 'C', 'N', 'O', 'F', 'Ne',
  'Na', 'Mg', 'Al', 'Si', 'P', 'S', 'Cl', 'Ar',
  'K', 'Ca', 'Sc', 'Ti', 'V', 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',
  'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr',
  'Rb', 'Sr', 'Y', 'Zr', 'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd',
  'In', 'Sn', 'Sb', 'Te', 'I', 'Xe',
  'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd', 'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy',
  'Ho', 'Er', 'Tm', 'Yb', 'Lu', 'Hf', 'Ta', 'W', 'Re', 'Os', 'Ir', 'Pt',
  'Au', 'Hg', 'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn',
  'Fr', 'Ra', 'Ac', 'Th', 'Pa', 'U', 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf',
  'Es', 'Fm', 'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',
  'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',
];

const codeLinks = [
  {
    fn: 'period(Z)',
    meaning: 'retrouve la période depuis L(k) = 2 ceil(k/2)^2',
    file: 'PT_PROJECTS/PTC/ptc/periodic.py:13',
  },
  {
    fn: 'l_of(Z)',
    meaning: 'assigne le bloc s, p, d ou f par position dans la période',
    file: 'PT_PROJECTS/PTC/ptc/periodic.py:31',
  },
  {
    fn: 'capacity(Z)',
    meaning: 'renvoie 2, 6, 10 ou 14 depuis 2(2ℓ+1)',
    file: 'PT_PROJECTS/PTC/ptc/periodic.py:115',
  },
  {
    fn: 'n_fill(Z)',
    meaning: 'ajoute les promotions informationnelles d5/d10',
    file: 'PT_PROJECTS/PTC/ptc/periodic.py:75',
  },
];

const periodicSourcePath = 'public/scripts-source/ptc/periodic.py';
const periodicSource = readFileSync(
  new URL('../../public/scripts-source/ptc/periodic.py', import.meta.url),
  'utf-8'
);
const periodicLineCount = periodicSource.trimEnd().split('\n').length;
---

<BaseLayout
  title="Le tableau périodique dérivé par la PT"
  description="Démontrer et vulgariser la dérivation PT du tableau périodique: blocs s/p/d/f, longueurs de période, absence de couche g et anomalies de configuration."
>
  <section class="border-b border-stone-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
      <div class="grid lg:grid-cols-[1fr_1.05fr] gap-10 items-center">
        <div>
          <p class="font-sans text-sm font-semibold uppercase tracking-wider text-derorange mb-3">
            Chimie PT / dérivation exécutable
          </p>
          <p class="pt-tag pt-tag-id mb-4">Première démonstration robuste</p>
          <h1 class="text-4xl md:text-5xl font-bold text-thmblue leading-tight mb-5">
            Pourquoi le tableau périodique a cette forme ?
          </h1>
          <p class="text-lg md:text-xl text-stone-700 leading-relaxed">
            En PT, le tableau des éléments n’est pas un catalogue empirique :
            sa forme vient d’une chaîne courte. Le spin donne le facteur 2,
            les orientations donnent 1, 3, 5, 7, et les capacités deviennent
            2, 6, 10, 14. De là, les blocs, les périodes et plusieurs
            anomalies de configuration tombent ensemble.
          </p>
          <div class="mt-6 flex flex-wrap gap-2 font-sans text-xs">
            <span class="pt-tag pt-tag-thm">THM</span>
            <span class="pt-tag pt-tag-der">DER</span>
            <span class="pt-tag pt-tag-val">PTC code</span>
            <span class="pt-tag pt-tag-pred">No g-shell</span>
          </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-stone-200 bg-stone-50">
          <div class="grid grid-cols-4 min-h-[260px]">
            {blocks.map((block) => (
              <div class={`periodic-block periodic-block-${block.name}`}>
                <div class="font-sans text-xs uppercase tracking-wider text-stone-500">
                  bloc
                </div>
                <div class="text-5xl md:text-6xl font-bold text-stone-900 mt-1">
                  {block.name}
                </div>
                <div class="mt-4 orbital-sketch" aria-hidden="true">
                  {Array.from({ length: block.orientations }).map((_, index) => (
                    <span style={`--i:${index}; --n:${block.orientations}`}></span>
                  ))}
                </div>
                <div class="mt-4 font-sans text-sm text-stone-700">
                  <strong>{block.orientations}</strong> orientations
                </div>
                <div class="font-sans text-sm text-stone-700">
                  capacité <strong>{block.capacity}</strong>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-4 gap-4">
      {derivationSteps.map((step, index) => (
        <article class="pt-card">
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="pt-tag pt-tag-thm">{step.tag}</span>
            <span class="font-sans text-sm text-stone-400">0{index + 1}</span>
          </div>
          <h2 class="font-sans text-xl font-bold text-thmblue mb-3">{step.title}</h2>
          <p data-max-depth="L1" class="text-stone-700 leading-relaxed">{step.plain}</p>
          <p data-min-depth="L2" class="text-stone-700 leading-relaxed">{step.technical}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 grid lg:grid-cols-[0.78fr_1.22fr] gap-8 items-start">
      <div>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          Pourquoi c’est une bonne première démonstration
        </h2>
        <p class="text-stone-700 leading-relaxed mb-4">
          Le tableau périodique est familier, visuel et très contraint.
          C’est exactement ce qu’il faut pour tester une théorie : la PT
          n’a pas le droit de choisir librement les blocs, les capacités ou
          les longueurs de période.
        </p>
        <p class="text-stone-700 leading-relaxed">
          La force de cette page est donc sa rigidité : les nombres
          <code> 2, 6, 10, 14</code> viennent de
          <code> 2(2ℓ+1)</code>, les périodes
          <code> 2, 8, 8, 18, 18, 32, 32</code> viennent de
          <code> L(k)=2⌈k/2⌉²</code>, puis les anomalies
          <code> d5/d10</code> et l’absence de bloc <code>g</code>
          deviennent des tests secondaires.
        </p>
      </div>
      <div class="bg-white border border-stone-200 rounded-lg overflow-hidden">
        <table>
          <thead class="font-sans bg-stone-50">
            <tr>
              <th>Étape</th>
              <th>Ce qui est forcé</th>
              <th>Résultat chimique</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Orientations</td>
              <td><code>2ℓ+1 = 1,3,5,7</code></td>
              <td>blocs s, p, d, f</td>
            </tr>
            <tr>
              <td>Spin</td>
              <td><code>2(2ℓ+1)</code></td>
              <td>capacités 2, 6, 10, 14</td>
            </tr>
            <tr>
              <td>Profondeur</td>
              <td><code>s → p → d → f</code></td>
              <td>périodes 2, 8, 18, 32</td>
            </tr>
            <tr>
              <td>Stabilités</td>
              <td><code>d5</code> et <code>d10</code></td>
              <td>Cr, Cu, Pd, Ag, Au...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-12">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-8 items-start">
      <div>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          Des regles connues aux causes structurelles
        </h2>
        <p class="text-stone-700 leading-relaxed">
          La page ne propose pas une nouvelle nomenclature à mémoriser.
          Elle reprend les objets usuels de la chimie quantique et montre
          comment la PT transforme des regles empiriques en consequences
          structurelles.
        </p>
      </div>

      <div class="overflow-x-auto border border-stone-200 rounded-lg bg-white">
        <table>
          <thead class="font-sans bg-stone-50">
            <tr>
              <th>Objet chimique</th>
              <th>Formulation usuelle</th>
              <th>Lecture PT</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <td class="font-sans font-semibold text-stone-900">{row.topic}</td>
                <td>{row.standard}</td>
                <td>{row.pt}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-12">
    <div class="grid lg:grid-cols-[0.52fr_1.48fr] gap-8 items-start">
      <div>
        <h2 class="text-3xl font-bold text-thmblue mb-4">
          Voir les canaux comme des polygones
        </h2>
        <p class="text-stone-700 leading-relaxed">
          Le dessin n’est pas une image d’orbitale dans l’espace. C’est une
          carte discrete du canal PT : le cercle marque le canal, chaque
          sommet represente une orientation disponible, et le spin double
          chaque sommet.
        </p>
        <p data-min-depth="L3" class="mt-4 font-sans text-sm text-stone-600 leading-relaxed">
          Lecture technique : les canaux se lisent sur les cercles
          <code>Z/(2P_l)Z</code>. Les premiers actifs
          <code>3, 5, 7</code> donnent le triangle, le pentagone et
          l’heptagone ; le cas <code>s</code> est le canal minimal,
          une orientation doublee par spin.
        </p>
      </div>

      <div class="polygon-grid">
        {blocks.map((block) => {
          const vertices = polygonVertices(block.orientations);
          const isPolygon = block.orientations > 2;
          return (
            <article class={`polygon-card polygon-card-${block.name}`}>
              <svg viewBox="0 0 160 160" role="img" aria-label={`Canal ${block.name}: ${block.orientations} orientations, capacité ${block.capacity}`}>
                <circle class="orbital-ring" cx="80" cy="80" r="52" />
                {isPolygon && <polygon class="polygon-face" points={polygonPoints(block.orientations)} />}
                {block.orientations === 1 && (
                  <>
                    <line class="polygon-axis" x1="28" y1="80" x2="132" y2="80" />
                    <circle class="polygon-node" cx="28" cy="80" r="10" />
                    <circle class="polygon-node" cx="132" cy="80" r="10" />
                    <circle class="spin-dot spin-dot-b" cx="28" cy="80" r="4.2" />
                    <circle class="spin-dot spin-dot-a" cx="132" cy="80" r="4.2" />
                  </>
                )}
                {block.orientations > 1 && vertices.map((point) => {
                  const spins = spinPair(point);
                  return (
                    <g>
                      <circle class="polygon-node" cx={point.x} cy={point.y} r="10" />
                      <circle class="spin-dot spin-dot-b" cx={spins.inner.x} cy={spins.inner.y} r="3.4" />
                      <circle class="spin-dot spin-dot-a" cx={spins.outer.x} cy={spins.outer.y} r="3.4" />
                    </g>
                  );
                })}
              </svg>
              <div>
                <h3>bloc {block.name}</h3>
                <p>
                  {block.orientations} orientation{block.orientations > 1 ? 's' : ''}
                  {' '}x 2 spins = <strong>{block.capacity}</strong>
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <div data-min-depth="L3" class="polygon-stability">
      <div>
        <h3>Pourquoi le pentagone parle aux anomalies d</h3>
        <p>
          Dans le canal <code>d</code>, cinq orientations forment le pentagone
          <code>Z/10Z</code> après doublement par spin. Les configurations
          <code>d5</code> et <code>d10</code> deviennent alors deux positions
          speciales : demi-remplissage et fermeture. C’est la raison pour
          laquelle Cr, Cu, Mo, Pd, Ag ou Au ne sont pas seulement des
          exceptions à mémoriser.
        </p>
      </div>
      <div class="pentagon-states" aria-label="Demi-remplissage et fermeture du canal d">
        {[
          { label: 'd5', filled: 5 },
          { label: 'd10', filled: 10 },
        ].map((state) => {
          const vertices = polygonVertices(5, 42, 62);
          return (
            <figure>
              <svg viewBox="0 0 124 124" role="img" aria-label={`Etat ${state.label}`}>
                <circle class="orbital-ring" cx="62" cy="62" r="42" />
                <polygon class="polygon-face" points={vertices.map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(' ')} />
                {vertices.map((point) => {
                  const spins = spinPair(point, 4, 62);
                  return (
                    <g>
                      <circle class="polygon-node" cx={point.x} cy={point.y} r="9" />
                      <circle class={state.filled >= 5 ? 'spin-dot spin-dot-filled' : 'spin-dot'} cx={spins.inner.x} cy={spins.inner.y} r="3.2" />
                      <circle class={state.label === 'd10' ? 'spin-dot spin-dot-filled' : 'spin-dot'} cx={spins.outer.x} cy={spins.outer.y} r="3.2" />
                    </g>
                  );
                })}
              </svg>
              <figcaption>{state.label}</figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-stone-100 border-y border-stone-200">
    <div class="max-w-6xl mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-[0.75fr_1.25fr] gap-8 items-start">
        <div>
          <h2 class="text-3xl font-bold text-thmblue mb-4">
            La formule qui fabrique les périodes
          </h2>
          <p class="text-stone-700 leading-relaxed">
            La longueur de la période numéro $k$ est donnée par
            $L(k) = 2\lceil k/2\rceil^2$. Elle produit directement
            la suite observée jusqu’à 118 éléments.
          </p>
          <div data-min-depth="L3" class="mt-5 bg-white border border-stone-200 rounded-lg p-4 font-sans text-sm text-stone-700">
            Source monographie : <code>chapters_fr/ch22_chemistry.tex</code>,
            section "Longueurs des périodes". Le code PTC l’implémente dans
            <code>period(Z)</code> par <code>cap = 2 * k * k</code> avec
            <code>k = per // 2 + 1</code>.
          </div>
        </div>

        <div class="space-y-3">
          {periods.map((period) => (
            <div class="period-row">
              <div class="w-16 font-sans text-sm font-semibold text-stone-700">
                k={period.k}
              </div>
