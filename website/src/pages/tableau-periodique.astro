<script is:inline define:vars={{ symbols: elementSymbols, promotionsData: promotions }}>
  (function () {
    const root = document.querySelector('[data-periodic-calculator]');
    if (!root) return;

    const P1 = 3;
    const P2 = 5;
    const P3 = 7;
    const blockMap = ['s', 'p', 'd', 'f'];
    const capMap = [2, 2 * P1, 2 * P2, 2 * P3];
    const promotionMap = new Map(promotionsData.map((row) => [row.z, row]));

    const input = root.querySelector('#pt-z-input');
    const fields = {};
    root.querySelectorAll('[data-field]').forEach((node) => {
      fields[node.getAttribute('data-field')] = node;
    });

    function period(Z) {
      let cumul = 0;
      let per = 1;
      while (true) {
        const k = Math.floor(per / 2) + 1;
        const cap = 2 * k * k;
        if (Z <= cumul + cap) return per;
        cumul += cap;
        per += 1;
      }
    }

    function periodStart(per) {
      let z0 = 1;
      for (let p = 1; p < per; p += 1) {
        const k = Math.floor(p / 2) + 1;
        z0 += 2 * k * k;
      }
      return z0;
    }

    function lOf(Z) {
      const per = period(Z);
      const z0 = periodStart(per);
      const pos = Z - z0;
      if (pos < 2) return 0;
      if (per <= 3) return 1;
      if (per <= 5) return pos < 12 ? 2 : 1;
      if (pos === 2) return 2;
      if (pos < 16) return 3;
      if (pos < 26) return 2;
      return 1;
    }

    function nFillAufbau(Z) {
      const per = period(Z);
      const z0 = periodStart(per);
      const pos = Z - z0;
      const l = lOf(Z);
      if (l === 0) return Math.min(pos + 1, 2);
      const cap = 2 * (Math.floor(per / 2) + 1) ** 2;
      if (l === 1) return Z - (z0 + cap - 6) + 1;
      if (l === 2) {
        let nd = Math.max(0, pos + 1 - 2);
        if (per >= 6) nd = Math.max(0, nd - 14);
        return Math.min(nd, 2 * P2);
      }
      if (l === 3) return Math.min(Math.max(0, pos + 1 - 2), 2 * P3);
      return 1;
    }

    function nFill(Z) {
      const promotion = promotionMap.get(Z);
      if (promotion && lOf(Z) === 2) {
        const match = promotion.pt.match(/d(\d+)/);
        return match ? Number(match[1]) : nFillAufbau(Z);
      }
      return nFillAufbau(Z);
    }

    function nsConfig(Z, madelung) {
      const promotion = madelung ? promotionMap.get(Z) : null;
      if (promotion && lOf(Z) === 2) {
        const match = promotion.pt.match(/s(\d+)/);
        return match ? Number(match[1]) : 2;
      }
      const l = lOf(Z);
      if (l === 0) return Math.min(nFillAufbau(Z), 2);
      return 2;
    }

    function configText(l, fill, ns) {
      if (l === 0) return `s${fill}`;
      if (l === 1) return `s${ns}p${fill}`;
      if (l === 2) return `d${fill}s${ns}`;
      return `f${fill}s${ns}`;
    }

    function reading(block, fill, promotion) {
      if (promotion) return promotion.reason;
      if (block === 's') return 'ouverture s';
      if (block === 'p' && fill === 6) return 'fermeture p';
      if (block === 'p') return 'remplissage p';
      if (block === 'd' && fill === 5) return 'demi-remplissage d';
      if (block === 'd' && fill === 10) return 'fermeture d';
      if (block === 'f') return 'canal f enfoui';
      return 'configuration régulière';
    }

    function render() {
      const Z = Math.max(1, Math.min(118, Number(input.value || 1)));
      input.value = String(Z);
      const l = lOf(Z);
      const per = period(Z);
      const block = blockMap[l];
      const fillA = nFillAufbau(Z);
      const fillM = nFill(Z);
      const promotion = promotionMap.get(Z);
      fields.symbol.textContent = symbols[Z] || '?';
      fields.z.textContent = `Z=${Z}`;
      fields.period.textContent = String(per);
      fields.block.textContent = block;
      fields.capacity.textContent = String(capMap[l]);
      fields.aufbau.textContent = configText(l, fillA, nsConfig(Z, false));
      fields.madelung.textContent = configText(l, fillM, nsConfig(Z, true));
      fields.reading.textContent = reading(block, fillM, promotion);
      root.setAttribute('data-current-block', block);
    }

    input.addEventListener('input', render);
    root.querySelectorAll('[data-z-preset]').forEach((button) => {
      button.addEventListener('click', () => {
        input.value = button.getAttribute('data-z-preset');
        render();
      });
    });
    render();
  })();
</script>

