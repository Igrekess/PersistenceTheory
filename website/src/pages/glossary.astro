---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import glossary from '@/data/glossary.json';

const items = glossary.terms
  .map(t => ({ key: t.key, term: t.fr.term, definition: t.fr.definition }))
  .sort((a, b) => a.term.localeCompare(b.term, 'fr'));
---

<BaseLayout
  title="Glossaire"
  description="Glossaire des termes spécifiques à la Théorie de la Persistance : μ*, q⁺, q⁻, sin²θ_p, GFT, et les théorèmes T0–T6."
>
  <PageHero
    width="medium"
    eyebrow="Glossaire"
    domain="meta"
    tone="simple"
    title="Glossaire"
    dek="Termes techniques spécifiques à la Théorie de la Persistance. Les termes apparaissent aussi en survol dans les essais et articles — passe la souris dessus."
  />

  <section class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-sm text-stone-500 mb-8">
      Pour le glossaire complet (116 entrées : auteurs, acronymes, mathématiques),
      voir la monographie chapitre <em>Glossaire</em>.
    </p>

    <div class="grid md:grid-cols-2 gap-3">
      {items.map(it => (
        <div id={it.key} class="pt-card text-sm">
          <div class="font-mono text-thmblue font-bold mb-1">{it.term}</div>
          <p class="text-stone-700">{it.definition}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
