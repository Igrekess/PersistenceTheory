---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Démonstration périodique fusionnée"
  description="Cette entrée a été fusionnée avec la page Tableau périodique."
>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <p class="pt-tag pt-tag-id mb-4">Page fusionnée</p>
    <h1 class="text-4xl font-bold text-thmblue mb-5">
      La démonstration est maintenant dans la page Tableau périodique
    </h1>
    <p class="text-lg text-slate-700 leading-relaxed mb-6">
      Pour éviter deux entrées redondantes, la démonstration compacte,
      les niveaux L1/L2/L3, les polygones, les périodes et le code PTC
      sont regroupés dans une seule page canonique.
    </p>
    <a
      href="/tableau-periodique"
      class="inline-block px-5 py-3 bg-thmblue text-white rounded font-sans font-semibold hover:bg-thmblue/90"
    >
      Ouvrir Tableau périodique
    </a>
  </section>
</BaseLayout>
