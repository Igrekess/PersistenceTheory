---
import BaseLayout from '@layouts/BaseLayout.astro';

const cards = [
  ['Mathématique', 'GFT + T0–T6 + L0', 'Principe fondamental, chaîne arithmétique, fermeture attractive μ* = 15.', '/theorems', 'pt-tag-thm'],
  ['Physique', '43 observables', 'Écart moyen annoncé 0,30 %, médiane 0,06 %, sous ponts explicites.', '/observables', 'pt-tag-der'],
  ['Chimie', 'Tableau périodique', 'Blocs s/p/d/f et périodes 2, 8, 8, 18, 18, 32, 32.', '/tableau-periodique', 'pt-tag-id'],
  ['Chimie', 'EI', 'Énergies d’ionisation : pics, fermetures, résidus et correction CPR.', '/energies-ionisation', 'pt-tag-val'],
  ['Chimie', 'EA', 'Affinités électroniques : capture de bord, vacance, cas halogènes/métaux.', '/affinites-electroniques', 'pt-tag-val'],
  ['Cosmologie', 'Secteur sombre', 'Lecture visible, énergie sombre, matière informationnelle.', '/cosmologie', 'pt-tag-bridge'],
  ['QG', 'Fisher → GR → Kerr', 'Chaîne géométrique, amplitude covariante, QNM et limites observationnelles.', '/gravite-quantique', 'pt-tag-bridge'],
  ['Falsifiabilité', 'Prédictions', 'Fenêtres expérimentales et points de rupture.', '/predictions', 'pt-tag-cond'],
];

const metrics = [
  ['43', 'observables Standard Model'],
  ['0,30 %', 'écart moyen annoncé'],
  ['0,06 %', 'médiane annoncée'],
  ['0', 'paramètre continu ajusté'],
];

const lenses = [
  ['Le noyau dur', 'GFT et la chaîne T0–T6/L0 forment l’ossature. Sans cette ossature, les résultats physiques et chimiques perdent leur statut de dérivation PT.', '/theorems'],
  ['La vitrine robuste', 'La chimie donne le meilleur premier contact : elle relie géométrie des canaux, périodes, EI et EA dans un langage inspectable.', '/tableau-periodique'],
  ['Les bords ouverts', 'QG, cosmologie et prédictions doivent rester très clairs sur ce qui est dérivé, validé, attendu ou encore à calibrer.', '/limites'],
];
---

<BaseLayout
  title="Dashboard des résultats"
  description="Vue synthétique des principaux résultats, validations et pages de preuve PT."
>
  <main class="max-w-6xl mx-auto px-4 py-10 md:py-14">
    <section class="grid lg:grid-cols-[1.05fr_0.95fr] gap-8 items-stretch mb-12">
      <div class="rounded-lg border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
        <p class="pt-tag pt-tag-val mb-5">Synthèse</p>
        <h1 class="text-4xl md:text-5xl font-bold text-thmblue leading-tight mb-5">
          Dashboard des résultats
        </h1>
        <p class="text-lg text-slate-700 leading-relaxed mb-4">
          Cette page sert de carte rapide : où sont les résultats, à quoi ils
          correspondent, et comment les vérifier dans le site.
        </p>
        <p class="text-slate-700 leading-relaxed">
          Elle ne remplace pas les statuts : un résultat peut être démonstratif,
          dérivé sous pont, validé numériquement, ou prédictif. Le dashboard
          indique le chemin de vérification.
        </p>
      </div>

      <aside class="rounded-lg border border-slate-200 bg-slate-950 text-white p-6 md:p-8 shadow-sm">
        <p class="text-xs font-sans uppercase tracking-[0.18em] text-amber-300 mb-5">
          Repères annoncés
        </p>
        <div class="grid grid-cols-2 gap-3">
          {metrics.map(([value, label]) => (
            <div class="rounded-lg border border-white/10 bg-white/10 p-4">
              <strong class="block text-3xl font-sans text-amber-200">{value}</strong>
              <span class="text-xs text-slate-300 leading-snug">{label}</span>
            </div>
          ))}
        </div>
      </aside>
    </section>

    <section class="grid md:grid-cols-3 gap-5 mb-12">
      {lenses.map(([title, text, href]) => (
        <a href={href} class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm hover:border-thmblue/40 hover:shadow-md transition group">
          <h2 class="text-xl font-bold text-thmblue mb-3 group-hover:underline">{title}</h2>
          <p class="text-slate-700 leading-relaxed text-sm">{text}</p>
        </a>
      ))}
    </section>

    <section>
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <p class="pt-tag pt-tag-der mb-3">Carte des domaines</p>
          <h2 class="text-3xl font-bold text-thmblue">Où vérifier chaque famille</h2>
        </div>
        <a href="/statuts-resultats" class="text-sm font-sans font-semibold text-thmblue hover:underline">
          Voir les statuts épistémiques
        </a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {cards.map(([domain, title, body, href, tagClass]) => (
          <a href={href} class="pt-card block group">
            <span class:list={['pt-tag', tagClass]}>{domain}</span>
            <h2 class="font-sans font-semibold text-thmblue text-xl mt-3 mb-2 group-hover:underline">{title}</h2>
            <p class="text-sm text-slate-700 leading-relaxed">{body}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
