---
import BaseLayout from '@layouts/BaseLayout.astro';

const cards = [
  ['Mathématique', 'GFT + T0–T6 + L0', 'Principe fondamental, chaîne arithmétique, fermeture mu* = 15.', '/theorems'],
  ['Physique', '43 observables', 'Écart moyen annoncé 0,30 %, médiane 0,06 %, sous ponts explicites.', '/observables'],
  ['Chimie', 'Tableau périodique', 'Blocs s/p/d/f et périodes 2, 8, 8, 18, 18, 32, 32.', '/tableau-periodique'],
  ['Chimie', 'EI', 'Énergies d’ionisation : pics, fermetures, résidus et correction CPR.', '/energies-ionisation'],
  ['Chimie', 'EA', 'Affinités électroniques : capture de bord, vacance, cas halogènes/métaux.', '/affinites-electroniques'],
  ['Cosmologie', 'Secteur sombre', 'Lecture visible, énergie sombre, matière informationnelle.', '/cosmologie'],
  ['QG', 'Fisher → GR → Kerr', 'Chaîne géométrique, amplitude covariante, QNM et limites observationnelles.', '/gravite-quantique'],
  ['Falsifiabilité', 'Prédictions', 'Fenêtres expérimentales et points de rupture.', '/predictions'],
];
---

<BaseLayout
  title="Dashboard des résultats"
  description="Vue synthétique des principaux résultats, validations et pages de preuve PT."
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <p class="pt-tag pt-tag-val mb-4">Synthèse</p>
    <h1 class="text-4xl md:text-5xl font-bold text-thmblue mb-5">Dashboard des résultats</h1>
    <p class="text-lg text-slate-700 leading-relaxed max-w-3xl mb-10">
      Cette page sert de carte rapide : où sont les résultats, à quoi ils
      correspondent, et comment les vérifier dans le site.
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
      {cards.map(([domain, title, body, href]) => (
        <a href={href} class="pt-card block group">
          <span class="pt-tag pt-tag-der">{domain}</span>
          <h2 class="font-sans font-semibold text-thmblue text-xl mt-3 mb-2 group-hover:underline">{title}</h2>
          <p class="text-sm text-slate-700">{body}</p>
        </a>
      ))}
    </div>

    <section class="grid lg:grid-cols-3 gap-5">
      <div class="bg-white border border-slate-200 rounded-lg p-5">
        <h2 class="text-xl font-bold text-thmblue mb-3">Le noyau dur</h2>
        <p class="text-slate-700">
          GFT et la chaîne T0–T6/L0 forment l’ossature. Sans cette ossature,
          les résultats physiques et chimiques perdent leur statut de
          dérivation PT.
        </p>
      </div>
      <div class="bg-white border border-slate-200 rounded-lg p-5">
        <h2 class="text-xl font-bold text-thmblue mb-3">La vitrine robuste</h2>
        <p class="text-slate-700">
          La chimie donne le meilleur premier contact : elle relie géométrie
          des canaux, périodes, EI et EA dans un langage accessible aux
          scientifiques.
        </p>
      </div>
      <div class="bg-white border border-slate-200 rounded-lg p-5">
        <h2 class="text-xl font-bold text-thmblue mb-3">Les bords ouverts</h2>
        <p class="text-slate-700">
          Les pages QG, cosmologie et prédictions doivent rester très claires
          sur ce qui est dérivé, validé, attendu ou encore à calibrer.
        </p>
      </div>
    </section>
  </section>
</BaseLayout>
