---
import BaseLayout from '@layouts/BaseLayout.astro';

const rows = [
  ['GFT', 'IDENTITY', 'Principe fondamental : capacité = persistance + entropie.', 'Théorèmes / GFT', 'Algébrique'],
  ['T0–T6 + L0', 'THM / DER', 'Chaîne arithmétique et fermeture à mu* = 15.', 'Page théorèmes', 'Démonstratif'],
  ['43 observables', 'DER / VAL', 'Dérivations physiques sous ponts explicites.', 'Observables + scripts', 'Numérique'],
  ['Tableau périodique', 'DER', 'Capacités 2, 6, 10, 14 et périodes 2, 8, 8, 18, 18, 32, 32.', 'Page tableau', 'Structurel'],
  ['Énergies d’ionisation', 'VAL', 'Lecture continue des canaux et corrections CPR.', 'Page EI / PTC', 'Comparatif'],
  ['Affinités électroniques', 'VAL / DER', 'Capture de bord, pression de vacance, lecture continue.', 'Page EA / PTC', 'Comparatif'],
  ['Gravité quantique', 'DER / COND', 'Chaîne Fisher, GR, contraintes, Kerr et observables.', 'Page QG', 'Partiellement ouvert'],
  ['Prédictions', 'PRED', 'Fenêtres expérimentales explicites.', 'Page prédictions', 'Falsifiable'],
];
---

<BaseLayout
  title="Statuts des résultats"
  description="Table d’audit des statuts épistémiques des principaux résultats PT."
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <p class="pt-tag pt-tag-cond mb-4">Audit épistémique</p>
    <h1 class="text-4xl md:text-5xl font-bold text-thmblue mb-5">Statuts des résultats</h1>
    <p class="text-lg text-slate-700 leading-relaxed max-w-3xl mb-10">
      Cette page sert de garde-fou. Un résultat peut être exact, démontré,
      dérivé sous pont, validé numériquement, prédictif ou encore conditionnel.
      Ces statuts ne doivent pas être mélangés.
    </p>

    <div class="bg-white border border-slate-200 rounded-lg overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-thmblue">
          <tr>
            <th class="text-left p-3">Résultat</th>
            <th class="text-left p-3">Statut</th>
            <th class="text-left p-3">Ce que cela signifie</th>
            <th class="text-left p-3">Source site</th>
            <th class="text-left p-3">Contrôle</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([name, status, meaning, source, control]) => (
            <tr class="border-t border-slate-200">
              <td class="p-3 font-semibold">{name}</td>
              <td class="p-3 font-mono text-derorange">{status}</td>
              <td class="p-3">{meaning}</td>
              <td class="p-3">{source}</td>
              <td class="p-3">{control}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-8 bg-amber-50 border border-amber-200 rounded-lg p-5 text-slate-800">
      <strong>Règle de lecture :</strong> une validation numérique ne transforme
      pas automatiquement une dérivation en théorème. Inversement, une identité
      algébrique peut être démontrée exactement sans être à elle seule une loi
      physique. La force PT vient de la chaîne complète et de sa rigidité.
    </div>
  </section>
</BaseLayout>
